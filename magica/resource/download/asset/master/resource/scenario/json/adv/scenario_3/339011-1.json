{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_21593.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200700,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm01_anime04","chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"...","turnChangeOut":"fadeOut"},{"chara":[{"id":200700}],"nameCenter":"Nagisa","textCenter":"Then in that case..."},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200700,"motion":200}],"nameCenter":"Nagisa","textCenter":"...Hrmm..."},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200700}],"nameCenter":"Nagisa","textCenter":"Oh, what to do..."},{"chara":[{"eyeClose":1,"id":200700,"motion":300}],"nameCenter":"Nagisa","textCenter":"...Mmgh..."},{"chara":[{"eyeClose":0,"id":200700,"motion":0}],"nameNarration":"","narration":"<Fraught with troubles,@a young girl wanders here alone...>","narrationBg":"bg_adv_21593.jpg","narrationEffect":"in"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","narrationEffect":"out","textCenter":"(Now that I've broken away from the@\"Law of Cycles\"...)"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(I'm savoring my freedom...!)"},{"chara":[{"eyeClose":1,"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(...But the more I pursue said freedom...)"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(The more I realize that the sky's the limit.)"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp3.json","id":200700,"lipSynch":0,"motion":1}],"nameCenter":"Nagisa","textCenter":"(In order to curb such overwhelming prospects...)"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(I need to come up with some sustainable freedom@development goals...!)"},{"chara":[{"id":200700,"lipSynch":0,"motion":100}],"nameCenter":"Nagisa","textCenter":"(Such is the philosophical dilemma...)"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(...that Nagisa's exemplary intelligence@has arrived at!)"},{"chara":[{"eyeClose":1,"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(At times like this, I curse how big my brain is...)"},{"chara":[{"eyeClose":0,"id":200700,"motion":200}],"nameCenter":"Nagisa","textCenter":"Still, no matter what runs through my head...!"},{"chara":[{"id":200700}],"nameCenter":"Nagisa","textCenter":"I have no intentions of going back!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200700,"lipSynch":0,"motion":0}],"nameCenter":"Nagisa","textCenter":"(...Or rather...)"},{"chara":[{"eyeClose":1,"id":200700,"lipSynch":0,"motion":300}],"nameCenter":"Nagisa","textCenter":"(I really shouldn't go back.@Not yet...)"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(I've gotta solve a certain \"problem\" first...)"},{"chara":[{"eyeClose":0,"id":200700,"motion":1}],"nameCenter":"Nagisa","textCenter":"...Good grief...@That's what I have to say..."},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(But such is the price of freedom!@...Probably.)"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(Yeah...)"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(Freedom from the \"Law of Cycles\"...)"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(I've got that liberty, and I'm gonna enjoy it@to the fullest...!)"},{"chara":[{"effect":"fadeout","id":200700}],"nameNarration":"","narration":"<While the girl was caught@in a web of turmoil...>","narrationBg":"bg_adv_21593.jpg","narrationEffect":"in"},{"narration":"<\"It\" appeared.>"},{"autoTurnLast":0.2,"bg":"black","bgm":"stop","item":[{"path":"resource/scenario/img/33901_yu_story/memoria_2028.jpg","posX":0,"posY":0,"visible":"appear"}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"nameNarration":"Nagisa","narration":"―Nagisa―@...","narrationAnchor":"bottom","narrationCoverOpacity":110.0,"narrationEffect":"in","narrationFontSize":30.0,"narrationLineMargin":35.0,"narrationLineSpace":20.0,"turnChangeOut":"fadeOut"},{"narration":"―Nagisa―@...Hm...?"},{"autoTurnLast":0.2,"bg":"bg_adv_21593.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390100,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200700,"motion":0,"pos":0}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"bgm":"bgm03_story13","chara":[{"id":390100,"motion":100}],"nameRight":"Yuu","textRight":"Hello! Long time no see, huh?","turnChangeOut":"fadeOut"},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"...Wha..."},{"chara":[{"id":200700,"motion":400,"mouthOpen":1},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390100,"motion":0}],"nameLeft":"Nagisa","textBg":"shout","textLeft":"[chara:200700:effect_emotion_surprise_0][se:7226_shock]UWAAAAAAAGH!!"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200700,"mouthOpen":0}],"nameLeft":"Nagisa","textLeft":"A-a-a Witch! When did you get here?!"},{"chara":[{"id":390100,"motion":300}],"nameRight":"Yuu","textRight":"A Witch...?@Is one nearby? Where?"},{"chara":[{"id":200700,"motion":100}],"nameLeft":"Nagisa","textLeft":"Nice try, Witch! If you think you can pull a fast one@on Nagisa,"},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"you're gonna have to step up your game!"},{"chara":[{"id":390100,"motion":400}],"nameRight":"Yuu","textRight":"Whuh?! You're referring to me?!"},{"chara":[{"id":390100}],"nameRight":"Yuu","textRight":"I've been the \"Witch\" this whole time?!"},{"chara":[{"id":200700,"motion":400}],"nameLeft":"Nagisa","textLeft":"En garde!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":390100,"motion":200}],"nameRight":"Yuu","textRight":"Th-there's— there's been a misunderstanding!"},{"chara":[{"id":390100}],"nameRight":"Yuu","textRight":"Don't tell me you've...forgotten about me?"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200700,"motion":0}],"nameLeft":"Nagisa","textLeft":"...Huh?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390100,"motion":1}],"nameRight":"Yuu","textRight":"Wait, am I wrong? Did I get you mixed up with@someone else...?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":390100}],"nameRight":"Yuu","textRight":"What a pain...@[chara:390100:lipSynch_0][wait:0.8][chara:390100:lipSynch_1][chara:390100:cheek_0][chara:390100:face_mtn_ex_050.exp3.json]Maybe? I guess it's not really a pain..."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390100,"motion":100}],"nameRight":"Yuu","textRight":"Nice to meet you! I'm Yuu.@I'm a Magical Girl, just like you."},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
