{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_21163.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200701,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390101,"motion":1,"pos":2}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"<Nagisa gains an interest in Yuu,@and decides to tail her...>","narrationBg":"bg_adv_21163.jpg","narrationEffect":"in","turnChangeOut":"fadeOut"},{"bgm":"bgm03_story06","chara":[{"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"..."},{"chara":[{"cheek":0,"face":"mtn_ex_014.exp3.json","id":390101}],"nameRight":"Yuu","textRight":"Hmm-hmm~♪"},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"...Yuu..."},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"Whaaat?"},{"chara":[{"id":200701,"motion":300}],"nameLeft":"Nagisa","textLeft":"I'll cut to the chase...@Who exactly are you?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390101,"motion":200}],"nameRight":"Yuu","textRight":"I'm just me?"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701,"motion":1}],"nameLeft":"Nagisa","textLeft":"Rrgh..."},{"chara":[{"eyeClose":1,"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"(As anticipated, asking that was pointless...)"},{"chara":[{"eyeClose":0,"id":200701}],"nameLeft":"Nagisa","textLeft":"...Mm, let me rephrase.@What do you usually do?"},{"chara":[{"cheek":0,"face":"mtn_ex_014.exp3.json","id":390101,"motion":100}],"nameRight":"Yuu","textRight":"I'm a Magical Girl!"},{"chara":[{"id":200701,"motion":400}],"nameLeft":"Nagisa","textLeft":"I know that already!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390101,"motion":0}],"nameRight":"Yuu","textRight":"And also..."},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":390101}],"nameRight":"Yuu","textRight":"I have a job?"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200701,"motion":0}],"nameLeft":"Nagisa","textLeft":"...A job? What kind?"},{"chara":[{"cheek":0,"face":"mtn_ex_014.exp3.json","id":390101,"motion":200}],"nameRight":"Yuu","textRight":"Ahehe... It's this."},{"autoTurnLast":0.2,"bg":"black","item":[{"path":"resource/scenario/img/33901_yu_story/memoria_2027.jpg","posX":0,"posY":0,"visible":"appear"}],"turnChangeIn":"fadeIn"},{"nameNarration":"Nagisa","narration":"―Nagisa―@What's that...?@There's a bunch of names written on it...","narrationAnchor":"bottom","narrationCoverOpacity":110.0,"narrationEffect":"in","narrationFontSize":30.0,"narrationLineMargin":10.0,"narrationLineSpace":20.0,"turnChangeOut":"fadeOut"},{"nameNarration":"Yuu","narration":"―Yuu―@It's a list?"},{"nameNarration":"Nagisa","narration":"―Nagisa―@Of...?"},{"nameNarration":"Yuu","narration":"―Yuu―@Bad people?"},{"nameNarration":"Nagisa","narration":"―Nagisa―@\"Bad\"...?@What do you need something like that for?"},{"autoTurnLast":0.2,"bg":"bg_adv_21163.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200701,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390101,"motion":0,"pos":2}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"So, believe it or not...","turnChangeOut":"fadeOut"},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"Magical Girls don't have arrest warrants@or anything."},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"You know?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390101,"motion":300}],"nameRight":"Yuu","textRight":"???@Are you talking about how I use my list?"},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"It's for getting rid of bad guys?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":200701,"motion":0}],"nameLeft":"Nagisa","textLeft":"...\"Getting rid of\" them?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390101,"motion":100}],"nameRight":"Yuu","textRight":"Yeah. That's my job."},{"chara":[{"cheek":0,"face":"mtn_ex_014.exp3.json","id":390101}],"nameRight":"Yuu","textRight":"Since I'm a Magical Girl and all."},{"chara":[{"cheek":0,"face":"mtn_ex_033.exp3.json","id":200701}],"nameLeft":"Nagisa","textLeft":"Since you're a Magical Girl, you...get rid of bad guys?"},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"...Is that what you call Witches?"},{"chara":[{"id":390101,"motion":1}],"nameRight":"Yuu","textRight":"Witches are bad guys,"},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"but bad people are also bad guys."},{"chara":[{"id":390101,"motion":200}],"nameRight":"Yuu","textRight":"Which means I've gotta wipe out both of them,@right?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200701,"motion":300}],"nameLeft":"Nagisa","textLeft":"...I see..."},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"Is it, like, you won't tolerate evil in any form?@A matter of spirit or something?"},{"chara":[{"id":390101,"motion":400}],"nameRight":"Yuu","textRight":"On that note..."},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"It seems like someone on my list is nearby,@so I'm gonna go take care of him now."},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"Back in a bit~."},{"autoTurnLast":1.0,"chara":[{"effect":"fadeout","id":390101}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200701,"motion":0}],"nameLeft":"Nagisa","textLeft":"Huh?@...What...?"},{"chara":[{"id":200701,"motion":200}],"nameLeft":"Nagisa","textLeft":"[chara:200701:effect_emotion_surprise_0][se:7226_shock]Hey, wait for me!"},{"autoTurnLast":1.5,"bg":"bg_adv_21153.jpg","chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200701,"motion":0,"pos":1}],"turnChangeIn":"rollInFast"},{"chara":[{"id":200701,"motion":300}],"nameCenter":"Nagisa","textCenter":"Aw, beans... I lost her!","turnChangeOut":"rollOutFast"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701}],"nameCenter":"Nagisa","textCenter":"Where'd you go?!@YUU! Where are you?!"},{"bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200701,"motion":0}],"nameNarration":"???","narration":"\"S-SOMEONE! HELP!\"","narrationBg":"bg_adv_21153.jpg","narrationEffect":"in"},{"chara":[{"id":200701}],"nameCenter":"Nagisa","narrationEffect":"out","textCenter":"Mmph?!"},{"bgm":"bgm01_anime14","nameNarration":"???","narration":"\"N-no, stop!@Don't...don't come any closer, you monster!\"","narrationBg":"bg_adv_21153.jpg","narrationEffect":"in"},{"chara":[{"id":200701,"motion":100}],"nameCenter":"Nagisa","narrationEffect":"out","textCenter":"I hear someone screaming...!"},{"chara":[{"id":200701}],"nameCenter":"Nagisa","textCenter":"Given what he said...@It's gotta be...!"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701,"motion":0}],"nameCenter":"Nagisa","textCenter":"His voice was coming from...this way!"},{"autoTurnLast":0.8,"chara":[{"effect":"fadeout","id":200701}],"textClear":1},{"autoTurnLast":0.5,"bg":"bg_adv_21603.jpg","chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200701,"motion":0,"pos":1}],"turnChangeIn":"rollInFast"},{"chara":[{"id":200701}],"nameCenter":"Nagisa","textCenter":"I...think? I can't hear him anymore...","turnChangeOut":"rollOutFast"},{"autoTurnLast":0.2,"chara":[{"id":200701,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800700,"lipSynch":0,"motion":0,"pos":2}],"nameRight":"","textRight":"..."},{"chara":[{"id":200701,"motion":400}],"nameLeft":"Nagisa","textLeft":"[chara:200701:effect_emotion_surprise_0][se:7226_shock]W-woah! Who's there?!"},{"chara":[{"id":800700,"lipSynch":0}],"nameRight":"","textRight":"..."},{"chara":[{"id":800700}],"nameRight":"","textRight":"Mon...[chara:800700:lipSynch_0][wait:0.8][chara:800700:lipSynch_1]ster..."},{"autoTurnLast":0.8,"chara":[{"effect":"fadeout","id":800700}],"se":"3002_chara_dead","textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200701,"motion":100}],"nameLeft":"Nagisa","textLeft":"AAAGH!"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":20070