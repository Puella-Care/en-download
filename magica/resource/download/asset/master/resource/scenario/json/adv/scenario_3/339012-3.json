{"story":{"group_1":[{"autoTurnLast":0.9,"bg":"bg_adv_21163.jpg","chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701,"motion":300,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":390101,"motion":200,"pos":2}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story10","chara":[{"id":200701}],"textLeft":"Now wakey-wakey and come help me@beat this Witch!","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390101,"motion":0}],"nameRight":"Yuu","textRight":"A Witch? ...Where?"},{"chara":[{"id":200701,"motion":200}],"nameLeft":"Nagisa","textLeft":"Just follow me!"},{"autoTurnLast":1.5,"chara":[{"effect":"slideOutRightFast","id":200701},{"effect":"slideOutRightFast","id":390101}],"textClear":1},{"autoTurnLast":0.2,"bg":"black","bgm":"stop","turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"<And so Yuu and Nagisa found themselves@confronting the Witch...>","narrationBg":"black","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"<Ultimately, they emerged victorious.>"},{"bgm":"stop","narration":"<However...>"},{"autoTurnLast":0.01,"bg":"bg_adv_21163.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390101,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200701,"motion":0,"pos":0}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"bgm":"bgm01_anime19","chara":[{"id":390101}],"nameRight":"Yuu","textRight":"Whew...","turnChangeOut":"fadeOut"},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"I feel pretty refreshed after getting my body@up and moving~."},{"chara":[{"cheek":0,"face":"mtn_ex_014.exp3.json","id":390101,"motion":100}],"nameRight":"Yuu","textRight":"Thanks for inviting me along, Nagisa."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200701,"motion":300}],"nameLeft":"Nagisa","textLeft":"D-don't mention it..."},{"chara":[{"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"..."},{"chara":[{"id":200701,"motion":1}],"nameLeft":"Nagisa","textLeft":"...Um, I just wanted to double-check something."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390101,"motion":0}],"nameRight":"Yuu","textRight":"What?"},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"When the Witch attacked you earlier..."},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"It...tore your arm off, didn't it?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390101,"motion":200}],"nameRight":"Yuu","textRight":"Sure did, huh?"},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"...S-so then..."},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"Your severed arm...just...grew back?"},{"chara":[{"id":390101,"motion":1}],"nameRight":"Yuu","textRight":"Yeah, I guess so?"},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"Is...is that...normal?"},{"chara":[{"id":390101,"motion":100}],"nameRight":"Yuu","textRight":"Yep, business as usual, right?"},{"chara":[{"eyeClose":1,"id":200701}],"nameLeft":"Nagisa","textLeft":"I see..."},{"chara":[{"id":200701,"lipSynch":0},{"id":390101,"motion":0}],"nameLeft":"Nagisa","textLeft":"..."},{"chara":[{"eyeClose":0,"id":200701}],"nameLeft":"Nagisa","textLeft":"...And when you got gutted and tossed your organs@and stuff out..."},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"Has that healed now, too...?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390101,"motion":400}],"nameRight":"Yuu","textRight":"All better, see?"},{"chara":[{"id":200701,"motion":0}],"nameLeft":"Nagisa","textLeft":"And that's...normal?"},{"chara":[{"id":390101,"motion":1}],"nameRight":"Yuu","textRight":"Yep, business as usual, right?"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701,"lipSynch":0,"motion":400}],"nameLeft":"Nagisa","textLeft":"(That's not \"usual\" at all!)"},{"chara":[{"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"(I barely felt a hint of magic when she regenerated!)"},{"chara":[{"id":200701,"lipSynch":0,"motion":200}],"nameLeft":"Nagisa","textLeft":"(Did her arm and insides grow back naturally...?@That's straight-up not possible!)"},{"chara":[{"id":390101,"motion":300}],"nameRight":"Yuu","textRight":"?"},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"When you were fighting earlier,"},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"you were able to conjure your Magical Girl outfit@and weapon, right?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200701,"lipSynch":0,"motion":300}],"nameLeft":"Nagisa","textLeft":"(...Wait, are these things really on the same level...?)"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":390101}],"textClear":1},{"autoTurnLast":0.2,"chara":[{"id":200701,"pos":1}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(Can she really be considered a Magical Girl@if she's like that...?)"},{"chara":[{"id":200701,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(Or...even still human at all?)"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701,"motion":0}],"nameCenter":"Nagisa","textCenter":"Just as I suspected..."},{"chara":[{"id":200701}],"nameCenter":"Nagisa","textCenter":"Yuu is...!"},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
