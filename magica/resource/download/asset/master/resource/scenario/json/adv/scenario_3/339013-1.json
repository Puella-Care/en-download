{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_21163.jpg","chara":[{"cheek":0,"face":"mtn_ex_031.exp3.json","id":200701,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"id":200701,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"...","turnChangeOut":"fadeOut"},{"chara":[{"id":200701,"motion":300}],"nameCenter":"Nagisa","textCenter":"Yuu...are you in there?"},{"autoTurnLast":0.01,"bg":"black","item":[{"path":"resource/scenario/img/33901_yu_story/memoria_2029.jpg","posX":0,"posY":0,"visible":"appear"}],"turnChangeIn":"fadeIn"},{"bgm":"bgm05_event08","nameNarration":"Yuu","narration":"―Yuu―@Oh, Nagisa.","narrationAnchor":"bottom","narrationCoverOpacity":110.0,"narrationEffect":"in","narrationFontSize":30.0,"narrationLineMargin":35.0,"narrationLineSpace":20.0,"turnChangeOut":"fadeOut"},{"narration":"―Yuu―@Do you wanna come with me@to work again today?"},{"nameNarration":"Nagisa","narration":"―Nagisa―@Ah, yeah, I do.@Yep, that's what I'm here for..."},{"narration":"―Nagisa―@However..."},{"autoTurnLast":0.01,"bg":"bg_adv_21163.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390101,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_031.exp3.json","id":200701,"motion":1,"pos":0}],"item":[{"path":"resource/scenario/img/51110_sizuka_training/memoria_1542.jpg","visible":"hide"}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":390101,"motion":400}],"nameRight":"Yuu","textRight":"However?","turnChangeOut":"fadeOut"},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"There's something I've gotta take care of first."},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":390101,"motion":300}],"nameRight":"Yuu","textRight":"Before I head off to work?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200701,"motion":300,"pos":0}],"nameLeft":"Nagisa","textLeft":"That's right..."},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"If I don't, I'm gonna be in hot water later..."},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701,"motion":200}],"nameLeft":"Nagisa","textLeft":"Yeah... I've got my own \"job\" to finish up."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390101,"motion":200}],"nameRight":"Yuu","textRight":"You've got work, too, huh~?"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701,"motion":400}],"nameLeft":"Nagisa","textLeft":"Y-yes indeed! I sure do!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200701}],"nameLeft":"Nagisa","textLeft":"So I'm...gonna get started now..."},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":390101,"motion":1}],"nameRight":"Yuu","textRight":"Hmm..."},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701,"lipSynch":0,"motion":0}],"nameLeft":"Nagisa","textLeft":"(Yuu's body can regenerate. She's the textbook@definition of a monster...!)"},{"chara":[{"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"(I need to catch her off-guard before she transforms@and go whole hog on offense!)"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390101,"motion":300}],"nameRight":"Yuu","textRight":"Can I...help with anything?"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200701,"motion":100}],"nameLeft":"Nagisa","textLeft":"Oh, uh, y-yeah! Absolutely!"},{"chara":[{"cheek":0,"face":"mtn_ex_014.exp3.json","id":390101,"motion":100}],"nameRight":"Yuu","textRight":"Ahh, wonderful!"},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"You tag along with me at work all the time,"},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"so I'm more than happy to return the favor~."},{"chara":[{"id":200701,"motion":300}],"nameLeft":"Nagisa","textLeft":"I wanna explain it in more detail, so if you could@just come a little closer..."},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":390101,"motion":1}],"nameRight":"Yuu","textRight":"...Sure thing~."},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200701,"lipSynch":0,"motion":0}],"nameLeft":"Nagisa","textLeft":"..."},{"chara":[{"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"(I've gotta get her within range to guarantee@a takedown...)"},{"autoTurnLast":0.1,"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_014.exp3.json","id":390101,"lipSynch":0,"posX":-30}],"nameRight":"Yuu","textRight":"♪"},{"chara":[{"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"(C'mon...)"},{"autoTurnLast":0.1,"textClear":1},{"chara":[{"id":390101,"lipSynch":0,"posX":-60}],"nameRight":"Yuu","textRight":"♪"},{"chara":[{"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"(Just a tiny bit closer...)"},{"bgm":"stop","chara":[{"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"..."},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_031.exp3.json","id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"..."},{"bgm":"bgm03_story12","chara":[{"eyeClose":0,"id":200701,"motion":300}],"nameLeft":"Nagisa","textLeft":"Yuu."},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"Do you ever think about the bad guys that@you might have to get rid of?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390101,"motion":200}],"nameRight":"Yuu","textRight":"...?@Think about them? In what way?"},{"chara":[{"id":200701,"motion":1}],"nameLeft":"Nagisa","textLeft":"Like, what makes a bad guy a bad guy?"},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"What bad deeds did they do to earn themselves@a spot on that list?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":390101,"motion":300}],"nameRight":"Yuu","textRight":"Umm...@Well, um, I'd say that a \"bad deed\"..."},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"...would be like unjustly robbing somebody@of something important?"},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"Although whether or not that's considered \"bad\"..."},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"...might vary a little from person to person."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390101,"motion":0}],"nameRight":"Yuu","textRight":"So technically the bad guys on this list..."},{"chara":[{"id":390101}],"nameRight":"Yuu","textRight":"...are really only bad from my point of view."},{"chara":[{"id":200701,"lipSynch":0,"motion":0}],"nameLeft":"Nagisa","textLeft":"..."},{"chara":[{"eyeClose":1,"id":200701}],"nameLeft":"Nagisa","textLeft":"...That makes sense.@I was thinking the same thing."},{"chara":[{"cheek":0,"face":"mtn_ex_014.exp3.json","id":390101,"motion":100}],"nameRight":"Yuu","textRight":"Uh-huh. You get it, right?"},{"chara":[{"eyeClose":0,"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"(...I figured as much.)"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390101,"motion":0}],"nameRight":"Yuu","textRight":"...?"},{"chara":[{"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"(Yuu...)"},{"bgm":"stop","chara":[{"id":200701,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"(Isn't gonna change her mind.)"},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
