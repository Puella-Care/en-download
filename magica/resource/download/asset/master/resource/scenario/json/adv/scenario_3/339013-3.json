00}],"nameCenter":"Nagisa","textCenter":"...Eh...?"},{"chara":[{"id":200700,"motion":300}],"nameCenter":"Nagisa","textCenter":"What...did I just see...?"},{"bgm":"bgm03_story08","chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(Was that...my past...?)"},{"chara":[{"id":200700,"lipSynch":0,"motion":0}],"nameCenter":"Nagisa","textCenter":"(...No, it can't be... I've never seen a scene like that@before...)"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"(Still, what happened to my mom at the hospital@was definitely...)"},{"chara":[{"id":200700,"motion":1}],"nameCenter":"Nagisa","textCenter":"...There's...something very strange going on..."},{"autoTurnLast":0.2,"chara":[{"id":200700,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390100,"motion":1,"pos":2}],"nameRight":"Yuu","textRight":"Nagisa?"},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"...Yuu..."},{"chara":[{"id":390100}],"nameRight":"Yuu","textRight":"Are you sleepy? Were you dreaming?"},{"chara":[{"id":390100}],"nameRight":"Yuu","textRight":"...Did it happen to you, too?"},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"...Wha... What do you mean, \"too\"...?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":390100,"motion":300}],"nameRight":"Yuu","textRight":"Sometimes, when I'm with someone else,@they start getting a little weird."},{"chara":[{"id":390100}],"nameRight":"Yuu","textRight":"I'll be standing right there talking to them,@and then they'll totally zone out..."},{"chara":[{"id":390100,"motion":0}],"nameRight":"Yuu","textRight":"And now it's happened to you, too."},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200700,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"..."},{"chara":[{"id":200700,"lipSynch":0,"motion":400}],"nameLeft":"Nagisa","textLeft":"(...What was it that I just went through...?!)"},{"chara":[{"cheek":0,"face":"mtn_ex_060.exp3.json","id":200700,"lipSynch":0}],"nameLeft":"Nagisa","textLeft":"(I can't remember...@My memories are too scrambled...!)"},{"chara":[{"cheek":0,"face":"mtn_ex_031.exp3.json","id":200700,"motion":0}],"nameLeft":"Nagisa","textLeft":"...Ah, right..."},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"Yuu... There's...something I want you to tell me..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390100,"motion":0}],"nameRight":"Yuu","textRight":"Mm?"},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"Have we...met before...?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390100,"motion":400}],"nameRight":"Yuu","textRight":"Oh, wow! You remembered?"},{"chara":[{"cheek":0,"face":"mtn_ex_014.exp3.json","id":390100}],"nameRight":"Yuu","textRight":"I'm so happy!"},{"chara":[{"id":390100,"motion":100}],"nameRight":"Yuu","textRight":"It's been a while, hasn't it? I'm Yuu!@I'm a Magical Girl, just like you."},{"autoTurnLast":1.0,"bg":"bg_adv_21593.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390100,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200700,"motion":0,"pos":0}],"turnChangeIn":"fadeIn","turnEffect":"blackFrame"},{"chara":[{"id":390100,"motion":100}],"nameRight":"Yuu","textRight":"Hello! Long time no see, huh?","turnChangeOut":"fadeOut"},{"autoTurnLast":1.0,"bg":"bg_adv_21163.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390100,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_031.exp3.json","id":200700,"motion":0,"pos":0}],"turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390100,"motion":0,"pos":2}],"nameRight":"Yuu","textRight":"...Ehe.","turnChangeOut":"fadeOut"},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"Nice to...see you too...?"},{"chara":[{"id":200700,"lipSynch":0,"motion":300}],"nameLeft":"Nagisa","textLeft":"(...There's no way. Could it be that this world's@Nagisa is the only one who...?)"},{"chara":[{"cheek":1,"eyeClose":1,"id":200700}],"nameLeft":"Na