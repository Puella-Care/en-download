{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_21017.jpg","chara":[{"cheek":2,"face":"mtn_ex_030.exp3.json","id":800600,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_033.exp3.json","id":200701,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"bgm":"bgm24_story07","chara":[{"id":800600}],"nameLeft":"Nagisa's Mother","textLeft":"*Pant*... *Pant*... *Pant*...","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200701,"motion":400}],"nameRight":"Nagisa","textRight":"...Mom!"},{"chara":[{"id":200701,"lipSynch":0}],"nameRight":"Nagisa","textRight":"(...I'm back at the hospital...?!)"},{"autoTurnLast":0.2,"chara":[{"id":200701,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":390100,"motion":300,"pos":2}],"nameRight":"Yuu","textRight":"I'm so sorry, Nagisa..."},{"chara":[{"id":200701,"motion":0}],"nameLeft":"Nagisa","textLeft":"...Yuu!"},{"chara":[{"id":390100,"motion":0}],"nameRight":"Yuu","textRight":"I'm not very attentive,"},{"chara":[{"id":390100}],"nameRight":"Yuu","textRight":"so I almost completely destroyed something@really important to you."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":390100,"motion":100}],"nameRight":"Yuu","textRight":"But I'm glad you made it here in time."},{"chara":[{"id":390100}],"nameRight":"Yuu","textRight":"Now you can get rid of your loved one@with your own hands, if you want?"},{"chara":[{"cheek":0,"face":"mtn_ex_031.exp3.json","id":200701,"motion":1}],"nameLeft":"Nagisa","textLeft":"Wh...what are you saying...?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":390100,"motion":1}],"nameRight":"Yuu","textRight":"I know it feels like a waste,"},{"chara":[{"id":390100}],"nameRight":"Yuu","textRight":"but you can't take this important person with you@into the future, y'know?"},{"chara":[{"id":390100}],"nameRight":"Yuu","textRight":"And if you don't hurry,"},{"chara":[{"id":390100}],"nameRight":"Yuu","textRight":"she could end up just vanishing all on her own,@couldn't she?"},{"chara":[{"cheek":1,"face":"mtn_ex_020.exp3.json","id":200701,"motion":200,"pos":0}],"nameLeft":"Nagisa","textLeft":"That's enough!"},{"chara":[{"id":200701}],"nameLeft":"Nagisa","textLeft":"Why in the world do I have to come back to a place@like this?!"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":390100,"motion":200}],"nameRight":"Yuu","textRight":"Because this is \"The End\" of your story?"},{"chara":[{"id":390100},{"id":200701,"motion":0}],"nameRight":"Yuu","textRight":"You even threw away something that meant@so much to you."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":390100,"motion":0}],"nameRight":"Yuu","textRight":"Where else can you go?"},{"autoTurnLast":1.5,"chara":[{"effect":"fadeout","id":390100}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_031.exp3.json","id":200701,"lipSynch":0,"motion":300}],"nameLeft":"Nagisa","textLeft":"..."},{"autoTurnLast":0.2,"chara":[{"id":200701,"motion":0,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800600,"motion":0,"pos":0}],"nameLeft":"Nagisa's Mother","textLeft":"Nagisa."},{"chara":[{"id":800600}],"nameLeft":"Nagisa's Mother","textLeft":"Where are you?"},{"chara":[{"id":800600}],"nameLeft":"Nagisa's Mother","textLeft":"Nagisa."},{"chara":[{"id":800600}],"nameLeft":"Nagisa's Mother","textLeft":"You're there, aren't you?"},{"chara":[{"id":800600}],"nameLeft":"Nagisa's Mother","textLeft":"Nagisa..."},{"chara":[{"id":800600}],"nameLeft":"Nagisa's Mother","textLeft":"Answer me..."},{"chara":[{"id":200701,"lipSynch":0}],"nameRight":"Nagisa","textRight":"..."},{"chara":[{"id":800600}],"nameLeft":"Nagisa's Mother","textLeft":"Nagisa..."},{"chara":[{"eyeClose":1,"id":200701,"lipSynch":0}],"nameRight":"Nagisa","textRight":"..."},{"autoTurnLast":0.8,"chara":[{"cheek":0,"effect":"ef_adv_05","face":"mtn_ex_031.exp3.json","id":200700,"motion":0,"pos":2}],"se":"7205_magic_girl","textClear":1},{"chara":[{"id":800600}],"nameLeft":"Nagisa's Mother","textLeft":"Nagisa..."},{"autoTurnLast":0.5,"bg":"black","bgm":"stop","turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"...","narrationBg":"black","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"..."},{"narration":"..."},{"autoTurnLast":0.01,"bg":"black","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_031.exp3.json","id":200700,"motion":0,"pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":200700,"lipSynch":0}],"nameCenter":"Nagisa","textCenter":"...","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp3.json","id":200700,"motion":400}],"nameCenter":"Nagisa","textCenter":"...*Gasp*!","turnChangeOut":"fadeOut"},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":200700,"motion":300,"mouthOpen":1}],"nameCenter":"Nagisa","textCenter":"*Pant*...*Wheeze*......"},{"chara":[{"id":200700,"lipSynch":0,"mouthOpen":0}],"nameCenter":"Nagisa","textCenter":"(What...was I doing...?)"},{"chara":[{"id":200700,"lipSynch":0,"motion":0}],"nameCenter":"Nagisa","textCenter":"..."},{"nameNarration":"???","narration":"\"Please.\"","narrationBg":"","narrationEffect":"in"},{"autoTurnLast":0.2,"chara":[{"id":200700,"pos":0}],"narrationEffect":"out"},{"bgm":"bgm03_story17","chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200700,"lipSynch":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":830700,"motion":0,"pos":2}],"nameLeft":"Nagisa","textLeft":"...?!"},{"nameNarration":"???","narration":"\"Kill Yuu.\"","narrationBg":"","narrationEffect":"in"},{"chara":[{"id":200700,"motion":100}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"Wh-who are you?"},{"nameNarration":"???","narration":"\"Kill Yuu.\"","narrationBg":"","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":200700}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"One messed-up character coming in@swinging out the gate."},{"nameNarration":"???","narration":"\"My story is already over.\"","narrationBg":"","narrationEffect":"in"},{"narration":"\"Everyone else is moving ahead@to the future and leaving me behind.\""},{"narration":"\"So please, kill Yuu.\""},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200700,"motion":1}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"I was gonna do that anyway, whether you asked@or not, but..."},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"Sorry; I hate doing stuff just because@somebody told me to."},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"And this feeling... You're just like Yuu."},{"nameNarration":"???","narration":"\"If you can see me,\"","narrationBg":"","narrationEffect":"in"},{"narration":"\"your story must already@be over as well, isn't it?\""},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":200700,"motion":0}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"Don't tell me... You're the reason why Yuu@is stuck in yesterday?"},{"nameNarration":"???","narration":"\"You've seen the end@of your own story, haven't you?\"","narrationBg":"","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_031.exp3.json","id":200700,"lipSynch":0}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"..."},{"nameNarration":"???","narration":"\"But you're still gonna@carry on past that anyway?\"","narrationBg":"","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":200700,"motion":300}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"My brain still feels like scrambled eggs@from earlier..."},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"Even ghosts should have some basic decency,@don't you think?"},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"Nagisa here has no plans to hang out@in a place like this."},{"nameNarration":"???","narration":"\"Don't go. You can't go.\"","narrationBg":"","narrationEffect":"in"},{"chara":[{"id":200700,"motion":1}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"...Mind your own business."},{"nameNarration":"???","narration":"\"You've finally reached The End,@and now you're just gonna leave someone@so precious to you behind?\"","narrationBg":"","narrationEffect":"in"},{"chara":[{"eyeClose":1,"id":200700}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"I don't...need this anymore."},{"nameNarration":"???","narration":"\"How heartless...\"","narrationBg":"","narrationEffect":"in"},{"chara":[{"cheek":1,"eyeClose":0,"id":200700,"motion":200}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"Oh, shove it!"},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"I'm gonna be free for the sake of the person@who meant so much to me!"},{"nameNarration":"???","narration":"\"Traitor...\"","narrationBg":"","narrationEffect":"in"},{"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_020.exp3.json","id":200700,"motion":0}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"There's no changing the past, but if I can be free,@then surely..."},{"nameNarration":"???","narration":"\"Liar...\"","narrationBg":"","narrationEffect":"in"},{"chara":[{"eyeClose":0,"id":200700}],"nameLeft":"Nagisa","narrationEffect":"out","textLeft":"From \"The End\", to everything that comes after,"},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"Nagisa here is gonna take it all back!@[chara:200700:lipSynch_0][wait:0.8][chara:200700:lipSynch_1][chara:200700:cheek_1][chara:200700:motion_400][chara:200700:face_mtn_ex_020.exp3.json][surround:2007A01][chara:830700:effect_7000_attack01]She's blazing a path to tomorrow!"},{"autoTurnLast":1.0,"bgEffect":"shakeSmall","chara":[{"effect":"7002_damage01","id":830700}],"surround":"2007A02","textClear":1},{"chara":[{"id":200700}],"nameLeft":"Nagisa","textLeft":"Ghosts like you should stay in your little hole@in the past!"},{"autoTurnLast":0.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":830700,"motion":0,"pos":2}],"surround":"stop","turnChangeIn":"whiteIn"},{"autoTurnLast":2.0,"turnChangeOut":"whiteOut"},{"autoTurnLas