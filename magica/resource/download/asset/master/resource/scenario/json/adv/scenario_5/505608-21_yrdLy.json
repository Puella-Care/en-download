{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"black","item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_1b.jpg","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"turnChangeIn":"fadeIn"},{"autoTurnLast":0.01,"bgm":"bgm03_story08","turnChangeOut":"fadeOut"},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_1c1.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"nameNarration":"Homura-chan","narration":"But my plan was wrong after all.@Even if Kaname-san gets stronger,","narrationAnchor":"bottom","narrationCoverOpacity":0.0,"narrationEffect":"in","narrationFontSize":0.0,"narrationLineSpace":2000.0},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_1c2.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"narration":"Mirrors or Challenge Quests will just@become new threats to her!"},{"autoTurnLast":0.1,"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_1c1.png","setVisible":0},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_1c2.png","setVisible":0}]},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_2c1.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"narration":"What I did was just meaningless."},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_2c2.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"narration":"I'm sorry for involving everyone@in such a dangerous Rumor!"},{"autoTurnLast":0.01,"bgm":"stop"},{"autoTurnLast":0.01,"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_3b.jpg","posX":0,"posY":0,"scale":1.0,"setVisible":1}]},{"bgm":"bgm03_story18","item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_3c1.png","posX":0,"posY":0,"scale":1.0,"setVisible":1},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_1b.jpg","setVisible":0},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_2c1.png","setVisible":0},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_2c2.png","setVisible":0}],"nameNarration":"Madoka-senpai","narration":"It's okay, Homura-chan."},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_3c2.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"narration":"You know, there's something my mama told@me once that I could never forget."},{"autoTurnLast":0.1,"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_3c1.png","setVisible":0},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_3c2.png","setVisible":0}]},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_4c1.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"narration":"\"If it weren't for Madoka and Tatsuya, I would've just@broken that annoying chief accountant's ribs.\""},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_4c2.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"narration":"And I realized that she became strong@enough to control her feelings,"},{"autoTurnLast":0.01,"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_5b.jpg","posX":0,"posY":0,"scale":1.0,"setVisible":1},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_4c1.png","setVisible":0},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_4c2.png","setVisible":0},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_3b.jpg","setVisible":0}]},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_5a.jpg","posX":0,"posY":0,"scale":1.0,"setVisible":1},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_5b.jpg","setVisible":0}],"narration":"for me and Takkun's sakes."},{"autoTurnLast":0.01,"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_6b.jpg","posX":0,"posY":0,"scale":1.0,"setVisible":1},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_5a.jpg","setVisible":0}]},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_6c1.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"narration":"It's the same as what you've done for me now."},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_6c2.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"narration":"Thank you for becoming strong for me."},{"autoTurnLast":0.1,"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_6c2.png","setVisible":0},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_6c1.png","setVisible":0}]},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_7c1.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"narration":"I promise I'll be stronger for you,@my mother...and just everyone I love."},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_7a.jpg","posX":0,"posY":0,"scale":1.0,"setVisible":1},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_7c1.png","setVisible":0},{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_6b.jpg","setVisible":0}],"narration":"So you don't need to worry."},{"autoTurnLast":0.01,"item":[{"action":{"moveTo":{"duration":2.0,"posX":0,"posY":900}},"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_7a.jpg"},{"action":{"moveTo":{"duration":2.0,"posX":0,"posY":0}},"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_8b.jpg","posX":1200,"posY":-900,"scale":1.0,"setVisible":1}]},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_8c1.png","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"nameNarration":"Homura-chan","narration":"Ah...@Thank you, Kaname-san."},{"item":[{"path":"resource/scenario/img/50560_PAPA_tower2019/5056_21_8a.jpg","posX":0,"posY":0,"scale":1.0,"setVisible":1}],"narration":"My very best―..."},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
