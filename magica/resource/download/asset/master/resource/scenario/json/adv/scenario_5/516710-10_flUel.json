_ex_030.exp3.json","id":800400,"motion":0,"pos":2}],"nameRight":"Haruto Nikaido","textRight":"…Ugh…………"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":304800,"motion":400,"pos":0}],"nameLeft":"Hotaru","textLeft":"Looks like he's come tooo~...@We gottaaa...go hiiide~..."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":304800},{"effect":"fadeout","id":800400}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305700,"motion":400,"pos":1}],"nameCenter":"Akari","textCenter":"Eh—?! Wait...!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305700}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_19041.jpg","bgChangeEffect":"cameraPan"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":304800,"motion":100,"pos":1}],"nameCenter":"Hotaru","textCenter":"And with thaaat...you'll figure oouut...@Who Nikaido's...special someone iiis~..."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":304800}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305000,"lipSynch":0,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304500,"lipSynch":0,"motion":1,"pos":1},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304100,"lipSynch":0,"motion":0,"pos":2}],"nameCenter":"Everyone","textCenter":"...?"},{"autoTurnLast":0.01,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305700,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":305700,"lipSynch":0,"motion":400}],"nameLeft":"Akari","textLeft":"(D-don't leave me out here alone!)","turnChangeOut":"fadeOut"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"...Nnngh~...? What was I...doing...?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305700,"motion":1}],"nameLeft":"Akari","textLeft":"...You've woken up?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400,"lipSynch":0,"motion":0,"pos":2}],"nameRight":"Haruto Nikaido","textRight":"[chara:800400:effect_emotion_surprise_0][se:7226_shock]...?!"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Y-you are... You saved me before...!"},{"autoTurnLast":1.0,"bg":"bg_adv_21153.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305700,"motion":0,"pos":2}],"turnChangeIn":"fadeIn","turnEffect":"blackFrame"},{"chara":[{"id":800400}],"nameLeft":"Haruto Nikaido","textLeft":"...What in the world was I...?","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305700,"motion":100}],"nameRight":"Akari","textRight":"Umm, you didn't look too well, so I was looking@after you..."},{"autoTurnLast":0.01,"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":305700,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400,"motion":0,"pos":0}],"turnChangeIn":"fadeIn"},{"chara":[{"id":800400}],"nameLeft":"Haruto Nikaido","textLeft":"Not only did you save me, you're taking care of me.","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"pos":0}],"nameLeft":"Haruto Nikaido","textLeft":"Honestly, I don't know how I can thank you..."},{"autoTurnLast":1.0,"bg":"bg_adv_19041.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_001.exp3.json","id":305700,"motion":1,"pos":0}],"turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"To think I'd get to see you again...","turnChangeOut":"fadeOut"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Well, did you come to take care of me again today?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305700}],"nameLeft":"Akari","textLeft":"...Something like that."},{"chara":[{"id":305700,"lipSynch":0,"motion":300,"pos":0}],"nameLeft":"Akari","textLeft":"(Back then...I saved Big Bro Haruto from a Witch,)"},{"chara":[{"eyeClose":1,"id":305700,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(and now he's thinking I'm someone that's not@Akari Mai...)"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Haha, all I'm doing is showing you@my shameful side..."},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":305700,"motion":0,"pos":0}],"nameLeft":"Akari","textLeft":"No you're not."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305700,"motion":100}],"nameLeft":"Akari","textLeft":"More importantly, are you resting well? You seem@like you might be fatigued..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"...You're...right.@Recently so much has happened..."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"But being cared for like this has lifted my spirits."},{"chara":[{"id":305700,"motion":200}],"nameLeft":"Akari","textLeft":"Still, be careful not to overdo it. You need to@take care of yourself."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Thanks so much."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Are you filming today too?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305700,"lipSynch":0,"motion":400}],"nameLeft":"Akari","textLeft":"...!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305700,"motion":1}],"nameLeft":"Akari","textLeft":"Y-yeah... I am."},{"chara":[{"id":305700,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(When we first met I just came up with a lie@on the spot.)"},{"chara":[{"id":305700,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(And you still believe it, don't you...)"},{"chara":[{"eyeClose":1,"id":305700,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(I'm so sorry, Big Bro Haruto...)"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400,"lipSynch":0}],"nameRight":"Haruto Nikaido","textRight":"…………"},{"chara":[{"id":800400},{"eyeClose":0,"id":305700}],"nameRight":"Haruto Nikaido","textRight":"By the way, that costume..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"That's the one you were telling me about for your@upcoming program about a transforming heroine,@isn't it?"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Is Mini-Bunni a part of the costume?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305700,"motion":100}],"nameLeft":"Akari","textLeft":"Eh—?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"That mascot character..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"I make those at the company my dad manages."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"If we're collabing with your program I figured@my dad would know you..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305700,"lipSynch":0,"motion":400}],"nameLeft":"Akari","textLeft":"(Ah—! Crap...!)"},{"chara":[{"id":305700,"motion":200}],"nameLeft":"Akari","textLeft":"T-this is just something I like! I'm in the middle@of a break so I was just wearing it."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"So that's it then. I'm happy you like it."},{"chara":[{"id":305700,"motion":300}],"nameLeft":"Akari","textLeft":"Umm...well... I should get back soon..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Ah—...I'm holding you up.@Excuse me..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"You're in the middle of work still after all."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305700,"motion":1}],"nameLeft":"Akari","textLeft":"Alright, I'm off.@Don't push yourself too hard, okay?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Yep, thank you very much."},{"autoTurnLast":1.5,"chara":[{"effect":"fadeout","id":305700}],"textClear":1},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"[chara:800400:effect_emotion_joy_0][se:7222_happy]...*Sigh*...@I knew she's such a wonderful person..."},{"autoTurnLast":0.2,"bgm":"stop","chara":[{"effect":"fadeout","id":800400}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_19041.jpg","bgChangeEffect":"cameraPan"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305000,"lipSynch":0,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304500,"lipSynch":0,"motion":1,"pos":1},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304100,"lipSynch":0,"motion":0,"pos":2}],"nameCenter":"Everyone","surround":"7003_wind","textCenter":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305000,"motion":200}],"nameLeft":"Yuuna","textLeft":"...Umm, what is the meaning of this?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304500,"motion":300,"pos":1}],"nameCenter":"Rion","textCenter":"I think I get it..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304100,"motion":100,"pos":2}],"nameRight":"Hotori","textRight":"Yeah..."},{"chara":[{"id":304500,"motion":1},{"id":305000,"motion":0}],"nameCenter":"Rion","textCenter":"Akari saved Haruto the same way as last time,"},{"chara":[{"id":304500}],"nameCenter":"Rion","textCenter":"and back then she quickly made up a lie about@her Magical Girl form,"},{"chara":[{"id":304500}],"nameCenter":"Rion","textCenter":"saying she was in the middle of filming@as a transforming heroine, am I right?"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":304100},{"effect":"fadeout","id":304500}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":304800,"motion":300,"pos":2}],"nameRight":"Hotaru","textRight":"Yup~..."},{"chara":[{"id":304800}],"nameRight":"Hotaru","textRight":"So Nikaidooo...@Likes the kid as she is right nooow~..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304800,"motion":1,"pos":2}],"nameRight":"Hotaru","textRight":"Buuut..."},{"chara":[{"id":304800}],"nameRight":"Hotaru","textRight":"He hasn't notiiiced... That it's actually Akariii~..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305000,"lipSynch":0,"motion":400}],"nameLeft":"Yuuna","textLeft":"...!@[wait:0.8][chara:305000:lipSynch_1]Ahh...!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305000,"motion":300}],"nameLeft":"Yuuna","textLeft":"You certainly did say that@Haruto's special someone..."},{"chara":[{"id":305000}],"nameLeft":"Yuuna","textLeft":"...was the one who saved him when he fell ill."},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":304800,"motion":100,"pos":2}],"nameRight":"Hotaru","textRight":"Yup~...and this is what I meaaant~..."},{"bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304500,"motion":400,"pos":0}],"nameLeft":"Rion","textLeft":"Hey...so you're saying this..."},{"chara":[{"id":304500,"motion":200}],"nameLeft":"Rion","textLeft":"This is a love triangle between Akari,@16 year old Akari, and Haruto, isn't it?!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":304500},{"effect":"fadeout","id":304800}],"surround":"stop","textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305000,"lipSynch":0,"motion":400,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304100,"lipSynch":0,"motion":400,"pos":2}],"nameCenter":"Yuuna & Hotori","textCenter":"[chara:305000:effect_emotion_surprise_0][chara:304100:effect_emotion_surprise_0][se:7226_shock]...?!"},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
