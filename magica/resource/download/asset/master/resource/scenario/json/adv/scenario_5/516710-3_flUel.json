{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_21071.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm01_anime03","chara":[{"id":305701,"lipSynch":0}],"nameCenter":"Akari","textCenter":"…………","turnChangeOut":"fadeOut"},{"chara":[{"id":305701,"motion":400}],"nameCenter":"","textBg":"shout","textCenter":"Hoootaruuu! It's morning—! Get your butt uuup!!"},{"autoTurnLast":0.2,"chara":[{"id":305701,"pos":0}],"textClear":1},{"bgEffect":"shakeLarge","nameRight":"Hotaru's Voice","textRight":"Ow—~...?!"},{"nameRight":"Hotaru's Voice","textRight":"Whyyy~...would you knock meee...@Outta my beeed~...?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":300}],"nameLeft":"Akari","textLeft":"S-sorry... I was a bit too forceful there..."},{"nameRight":"Hotaru's Voice","textRight":"Ehh~nn... You're horribllle~..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"motion":1}],"nameLeft":"Akari","textLeft":"That was wrong of me...@I apologize, so cheer up."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701}],"nameLeft":"Akari","textLeft":"I'll help you change your clothes."},{"nameRight":"Hotaru's Voice","textRight":"Mm~...I'm not angry with you thouugh~..."},{"nameRight":"Hotaru's Voice","textRight":"But if you're gonna help meee...@Then please dooo~..."},{"autoTurnLast":0.8,"bg":"bg_adv_15041.jpg","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp3.json","id":304801,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701,"motion":0,"pos":0}],"turnChangeIn":"fadeIn"},{"chara":[{"id":304801,"motion":100}],"nameRight":"Hotaru","textRight":"*Yaaaawn*~...","turnChangeOut":"fadeOut"},{"chara":[{"id":305701,"motion":200}],"nameLeft":"Akari","textLeft":"Be sleepy all you want, but at least walk straight."},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":304801,"motion":1,"tear":0}],"nameRight":"Hotaru","textRight":"Mm