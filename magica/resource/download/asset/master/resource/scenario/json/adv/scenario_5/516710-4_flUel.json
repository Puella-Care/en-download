{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_21025.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story19","chara":[{"id":800400}],"nameCenter":"Haruto Nikaido","textCenter":"Akari, sorry for the wait.","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":800400}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_21025.jpg","bgChangeEffect":"cameraPan"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":801200,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":801600,"motion":0,"pos":2}],"nameLeft":"","textLeft":"Ah—! It's Akari's big bro!"},{"chara":[{"id":801600}],"nameRight":"","textRight":"Coming all this way to pick her up, you're so sweet."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"motion":1,"pos":0}],"nameLeft":"Akari","textLeft":"He is kind...but..."},{"chara":[{"eyeClose":1,"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(He's not actually my brother.)"},{"chara":[{"id":305701,"lipSynch":0,"motion":300}],"nameLeft":"Akari","textLeft":"(He's a distant relative who lives in the@neighborhood, you know.)"},{"chara":[{"eyeClose":0,"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(Every we go, people see us as older brother@and younger sister.)"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":305701,"lipSynch":0,"motion":0}],"nameLeft":"Akari","textLeft":"(Papa and Mama, even Uncle and Auntie Nikaido.)"},{"chara":[{"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(They all treat us the same...!)"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"motion":0,"pos":2}],"nameRight":"Haruto Nikaido","textRight":"Are you maybe... Not ready to go home yet?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Can big bro here give you a hand with anything?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701,"motion":400}],"nameLeft":"Akari","textLeft":"Nope, I'm set! Let's go—!"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":305701,"lipSynch":0,"motion":200}],"nameLeft":"Akari","textLeft":"(I get to spend more time with you than normal.@I need to enjoy it—!)"},{"autoTurnLast":0.01,"bg":"bg_adv_15041.jpg","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_050.exp3.json","id":305701,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"We gathered everyone in the class...","turnChangeOut":"fadeOut"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"...to look for our bunny that ran away,"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701}],"nameLeft":"Akari","textLeft":"but we couldn't find him at all..."},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"There wasn't anything we could do, so I went back@to the rabbit hutch."},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":305701,"motion":100}],"nameLeft":"Akari","textLeft":"And that's when..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Yeah?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701}],"nameLeft":"Akari","textLeft":"Before I knew it, there he was, back on his own..."},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"...in front of the rabbit hutch.@It surprise me so much."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Think he got tired of playing@and decided to come home?"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"Probably, yeah."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"But it's a good thing he was safe and sound, huh."},{"chara":[{"id":305701,"motion":200}],"nameLeft":"Akari","textLeft":"Yeah—!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"lipSynch":0,"motion":0}],"nameLeft":"Akari","textLeft":"(Just a little further and we'll be home...)"},{"chara":[{"id":305701,"lipSynch":0,"motion":0}],"nameLeft":"Akari","textLeft":"(The truth is I want to spend more time with you,@big bro...)"},{"chara":[{"eyeClose":1,"id":305701,"lipSynch":0,"motion":300,"pos":0}],"nameLeft":"Akari","textLeft":"(But to tell you something that selfish—@I can't trouble you with it.)"},{"chara":[{"eyeClose":0,"id":305701,"lipSynch":0,"pos":0}],"nameLeft":"Akari","textLeft":".....[wait:0.8][chara:305701:lipSynch_1][chara:305701:cheek_0][chara:305701:face_mtn_ex_050.exp3.json][chara:305701:motion_400]Ah—!"},{"chara":[{"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(That shop over there has a ton of@Mini-Bunni goods in it!)"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Wanna take a little detour?"},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":305701,"motion":0}],"nameLeft":"Akari","textLeft":"Can we?!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701}],"nameLeft":"Akari","textLeft":"...Ah, but...you have to get home early, don't you...?"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"It'll be fine if it's just for a minute."},{"chara":[{"cheek":1,"face":"mtn_ex_013.exp3.json","id":305701,"motion":100}],"nameLeft":"Akari","textLeft":"Th-then, just a peek...!"},{"autoTurnLast":0.01,"bg":"black","item":[{"path":"resource/scenario/img/51167_tower_akari/memoria_1773.jpg","posX":0,"posY":0,"visible":"appear"}],"turnChangeIn":"fadeIn"},{"nameNarration":"Akari","narration":"―Akari―@Ehehe~...@Mini-Bunni is so cute!","narrationAnchor":"bottom","narrationCoverOpacity":110.0,"narrationEffect":"in","narrationFontSize":30.0,"narrationLineMargin":10.0,"narrationLineSpace":20.0,"turnChangeOut":"fadeOut"},{"nameNarration":"Haruto Nikaido","narration":"―Haruto―@I'll buy it for you if you want."},{"nameNarration":"Akari","narration":"―Akari―@...?!"},{"nameNarration":"Akari","narration":"―Akari―@Ah—!@Y-you got it wrong...!"},{"narration":"―Akari―@Mini-Bunni is a character you drew for me,@Big Bro Haruto, so it's just special to me is all..."},{"narration":"―Akari―@I don't like childish stuff@like this...!"},{"nameNarration":"Haruto Nikaido","narration":"―Haruto―@Ahaha...so that's how it is."},{"autoTurnLast":0.8,"bg":"bg_adv_15041.jpg","chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":305701,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400,"motion":0,"pos":2}],"item":[{"path":"resource/scenario/img/51167_tower_akari/memoria_1773.jpg","visible":"hide"}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Good to go?","turnChangeOut":"fadeOut"},{"chara":[{"id":305701,"motion":300}],"nameLeft":"Akari","textLeft":"...Yeah, ready."},{"chara":[{"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(What, just because you're charming you think@you can be pushing me like that?)"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":305701,"lipSynch":0,"motion":200}],"nameLeft":"Akari","textLeft":"(Hmmph—!)"},{"autoTurnLast":1.0,"bg":"bg_adv_15021.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800900,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":800900}],"nameLeft":"Haruto's Father","textLeft":"You're finally back!","turnChangeOut":"fadeOut"},{"chara":[{"id":800400,"pos":2}],"nameRight":"Haruto Nikaido","textRight":"[chara:800400:effect_emotion_surprise_0][se:7226_shock]Dad?! You didn't have to wait outside..."},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":800900}],"nameLeft":"Haruto's Father","textLeft":"I just couldn't stand still."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":800900},{"effect":"fadeout","id":800400}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800800,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701,"motion":0,"pos":0}],"nameRight":"Haruto's Mother","textRight":"Akari was with you, was she? Welcome home."},{"chara":[{"id":305701,"motion":100}],"nameLeft":"Akari","textLeft":"I made it back, Auntie!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305701},{"effect":"fadeout","id":800800}],"textClear":1},{"bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800900,"motion":0,"pos":1}],"nameCenter":"Haruto's Father","surround":"7003_wind","textCenter":"Alright, Haruto, let's go and meet your fiancée!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":800900}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400,"lipSynch":0,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"lipSynch":0,"motion":0,"pos":0}],"nameCenter":"Akari & Haruto","textCenter":".....[wait:0.8]Huh—...?"},{"chara":[{"id":800400,"lipSynch":1,"mouthOpen":1},{"id":305701,"lipSynch":1,"motion":400,"mouthOpen":1}],"nameCenter":"Akari & Haruto","textBg":"shout","textCenter":"[chara:800400:effect_emotion_surprise_0][chara:305701:effect_emotion_surprise_0][se:7226_shock]FIANCÉE?!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305701},{"effect":"fadeout","id":800400}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800900,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800800,"motion":0,"pos":2}],"nameLeft":"Haruto's Father","textLeft":"It's great you're here too, Akari,"},{"chara":[{"id":800900}],"nameLeft":"Haruto's Father","textLeft":"since I hadn't told you yet either."},{"chara":[{"id":800800}],"nameRight":"Haruto's Mother","textRight":"Hehe, he was so overjoyed..."},{"chara":[{"id":800800}],"nameRight":"Haruto's Mother","textRight":"He went and told Akari's parents first, you see."},{"chara":[{"id":800900}],"nameLeft":"Haruto's Father","textLeft":"Only because they're practically second parents@to Haruto."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800800}],"nameRight":"Haruto's Mother","textRight":"Huh? Akari, are you listening...?"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":800900},{"effect":"fadeout","id":800800}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":0,"pos":0}],"nameLeft":"Akari","textLeft":"Fi...ancée..."},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
