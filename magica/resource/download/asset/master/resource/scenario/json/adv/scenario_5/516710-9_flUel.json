{"story":{"group_1":[{"autoTurnLast":0.8,"bg":"bg_adv_19261.jpg","chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":305001,"motion":400,"pos":2},{"cheek":0,"face":"mtn_ex_001.exp3.json","id":305701,"motion":200,"pos":0}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story16","chara":[{"id":305001,"lipSynch":0}],"nameRight":"Yuuna","textRight":"(To come all this way for your beloved...)","turnChangeOut":"fadeOut"},{"chara":[{"id":305001,"lipSynch":0,"motion":100}],"nameRight":"Yuuna","textRight":"(How incredibly sweet you are!)"},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":305001,"lipSynch":0,"motion":200}],"nameRight":"Yuuna","textRight":"(I simply MUST give her all my support.)"},{"chara":[{"cheek":0,"id":305001,"motion":0}],"nameRight":"Yuuna","textRight":"If I may, could I ask for your name?"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":305701,"motion":100}],"nameLeft":"Akari","textLeft":"...It's Akari Mai."},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305001}],"nameRight":"Yuuna","textRight":"Akari...@An incredibly lovely name that is."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":0,"pos":0}],"nameLeft":"Akari","textLeft":"Eh—? Uhh, thank you very much?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":300}],"nameRight":"Yuuna","textRight":"I have only met Haruto once,"},{"chara":[{"id":305001}],"nameRight":"Yuuna","textRight":"but I found him to be courteous, honest,@and very nice."},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp3.json","id":305701,"motion":400,"pos":0}],"nameLeft":"Akari","textLeft":"[chara:305701:effect_emotion_surprise_0][se:7226_shock]Wha—!"},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(Oh no, she also likes big bro?!)"},{"chara":[{"cheek":1,"face":"mtn_ex_020.exp3.json","id":305701,"motion":200,"pos":0}],"nameLeft":"Akari","textLeft":"I-I know that all too well! 'Cause we've been@in such a long relationship—!"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305001,"motion":100,"pos":2}],"nameRight":"Yuuna","textRight":"Well, of course."},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp3.json","id":305701,"lipSynch":0,"motion":400,"pos":0}],"nameLeft":"Akari","textLeft":"(This is the composure of his fiancée?!)"},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":305701,"lipSynch":0,"motion":300,"pos":0}],"nameLeft":"Akari","textLeft":"(Uugh...and this young lady's a closer match@in age, too.)"},{"chara":[{"eyeClose":1,"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(I have no ammo to win with!)"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305701},{"effect":"fadeout","id":305001}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_19261.jpg","bgChangeEffect":"cameraPan"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304801,"motion":300,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304101,"motion":0,"pos":2}],"nameLeft":"Hotaru","textLeft":"Mm~...? They're kindaaa...@Starting to miss each otherrr~...?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304101,"motion":300,"pos":2}],"nameRight":"Hotori","textRight":"They're not meshing well together, are they...?"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":304801},{"effect":"fadeout","id":304101}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_19261.jpg","bgChangeEffect":"cameraPan"},{"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":305001,"lipSynch":0,"motion":200,"pos":2},{"cheek":0,"face":"mtn_ex_001.exp3.json","id":305701,"motion":1,"pos":0}],"nameRight":"Yuuna","textRight":"(This is a maiden in love.)"},{"chara":[{"id":305001,"lipSynch":0}],"nameRight":"Yuuna","textRight":"(Devoting oneself entirely to their love,)"},{"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_011.exp3.json","id":305001,"lipSynch":0,"motion":400}],"nameRight":"Yuuna","textRight":"(it's as if my eyes lay upon the very heroine@from that shoujo manga!)"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":1}],"nameRight":"Yuuna","textRight":"There is no need for worry,"},{"chara":[{"id":305001}],"nameRight":"Yuuna","textRight":"for we have already met and confirmed@our feelings for one another."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":400,"pos":0}],"nameLeft":"Akari","textLeft":"Eh—...?!"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":305701,"lipSynch":0,"motion":200}],"nameLeft":"Akari","textLeft":"(H-Big Bro Haruto said he turned you down@though?!)"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305001},{"effect":"fadeout","id":305701}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_19261.jpg","bgChangeEffect":"cameraPan"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":304501,"motion":200,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304801,"motion":0,"pos":0}],"nameRight":"Rion","textRight":"Ah, hold it — she's phrasing it vaguely!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":304801,"motion":100}],"nameLeft":"Hotaru","textLeft":"This is turniing... Into a skit, isn't iiit~..."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":304801},{"effect":"fadeout","id":304501}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_19261.jpg","bgChangeEffect":"cameraPan"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":100,"pos":2},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"motion":0,"pos":0}],"nameRight":"Yuuna","textRight":"And for that reason..."},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305001}],"nameRight":"Yuuna","textRight":"Please allow me to support your pursuit@of love, Akari."},{"chara":[{"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"…………[wait:0.8][chara:305701:lipSynch_1][chara:305701:cheek_0][chara:305701:face_mtn_ex_050.exp3.json]Eh—?"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305001},{"effect":"fadeout","id":305701}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304501,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":304801,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304101,"motion":1,"pos":1}],"nameRight":"Rion","textRight":"You, you think this is amusing?"},{"chara":[{"id":304801,"motion":100}],"nameLeft":"Hotaru","textLeft":"Mm~...you guuuys...@Find it funny too, don't yaaa~...?"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":304501,"motion":200,"pos":2}],"nameRight":"Rion","textRight":"I don't care!"},{"chara":[{"id":304101,"motion":300}],"nameCenter":"Hotori","textCenter":"Hey...Rion, let's go clear up the misunderstanding..."},{"autoTurnLast":0.8,"chara":[{"effect":"fadeout","id":304801},{"effect":"fadeout","id":304501},{"effect":"fadeout","id":304101}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":1,"pos":2}],"nameLeft":"Akari","textLeft":"Umm, what do you mean by support me?"},{"chara":[{"id":305701,"motion":100}],"nameLeft":"Akari","textLeft":"Yuuna, you like big bro too, right...?"},{"chara":[{"id":305001}],"nameRight":"Yuuna","textRight":"I find myself having respect for him,"},{"chara":[{"eyeClose":1,"id":305001}],"nameRight":"Yuuna","textRight":"but I claim no desire for him."},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":305701,"motion":400}],"nameLeft":"Akari","textLeft":"[chara:305701:effect_emotion_joy_0][se:7222_happy]...Thank goodness!"},{"chara":[{"cheek":1,"eyeClose":0,"id":305001,"motion":200}],"nameRight":"Yuuna","textRight":"The love you two share is quite romantic,"},{"chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":305001}],"nameRight":"Yuuna","textRight":"so I rather hope and want a happy ending for you."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304801,"motion":300,"pos":0}],"nameLeft":"Hotaru","textLeft":"...Mm~...that theeere... Is also kind of@a misunderstandiiing~..."},{"chara":[{"id":304801}],"nameLeft":"Hotaru","textLeft":"So Nikaidoooo... Isn't in love with an@elementary schoolerrr~..."},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":304801,"motion":200}],"nameLeft":"Hotaru","textLeft":"And Akariii...is a distantly related relatiiive...@More like a younger sisterrr~..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305001,"motion":400}],"nameRight":"Yuuna","textRight":"Oh, I thought..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305001}],"nameRight":"Yuuna","textRight":"Then, Akari's unrequited love...?"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp3.json","id":305701,"motion":300,"pos":0}],"nameLeft":"Akari","textLeft":"...Frustratingly, that part's right."},{"chara":[{"id":305001,"motion":1}],"nameRight":"Yuuna","textRight":"Then who is Haruto's special someone?"},{"chara":[{"eyeClose":0,"id":305701,"lipSynch":0,"motion":0}],"nameLeft":"Akari","textLeft":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":304801,"motion":0,"pos":0}],"nameLeft":"Hotaru","textLeft":"It's a looong story...@So how 'bout we take a walk~...?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":100}],"nameRight":"Yuuna","textRight":"In that case, let's go to a shop I simply must@recommend."},{"chara":[{"id":305001}],"nameRight":"Yuuna","textRight":"I will have someone at the house arrange for a car."},{"autoTurnLast":2.0,"bg":"bg_adv_19221.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304801,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story02","chara":[{"id":304801,"motion":100}],"nameCenter":"Hotaru","textCenter":"That waaas... A suu~uuper long limousine~...","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300902,"motion":100,"pos":1}],"nameCenter":"Manaka","textCenter":"Welcome! This is an unusual combo."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300902}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":0,"pos":2}],"nameLeft":"Akari","textLeft":"Ah, Manaka..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305001,"motion":1}],"nameRight":"Yuuna","textRight":"An acquaintance of yours?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701}],"nameLeft":"Akari","textLeft":"Well..."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":304801,"motion":200,"pos":0}],"nameLeft":"Hotaru","surround":"7202_telepathy","textLeft":"We're Magical Girls from the same uniooon...@So we have a connectiooon~...","turnEffect":"ef_adv_02"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":200}],"nameRight":"Yuuna","textRight":"Ohh... So you are all Magical Girls then."},{"autoTurnLast":0.01,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305001,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":304501,"motion":1,"pos":0}],"surround":"stop","turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"id":305001,"motion":100}],"nameRight":"Yuuna","textRight":"Hehe, how unexpected of us to have@a common interest...","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":304501,"motion":100}],"nameLeft":"Rion","textLeft":"Let's get to ordering! I'm starving!"},{"autoTurnLast":1.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300902,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"id":300902,"motion":100}],"nameCenter":"Manaka","textCenter":"Orders taken! And now...","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300902}],"textClear":1},{"autoTurnLast":0.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701,"motion":1,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_000.exp3.json","id":304801,"motion":0,"pos":2}],"textClear":1},{"bgm":"stop","chara":[{"cheek":0,"effect":"ef_adv_01","face":"mtn_ex_050.exp3.json","id":305701,"lipSynch":0,"motion":400},{"cheek":0,"effect":"ef_adv_01","face":"mtn_ex_050.exp3.json","id":304801,"lipSynch":0,"motion":400},{"cheek":0,"effect":"ef_adv_01","face":"mtn_ex_050.exp3.json","id":305001,"lipSynch":0,"motion":400}],"nameCenter":"Everyone","se":"7201_detect_magic","textCenter":"...?!"},{"autoTurnLast":0.8,"chara":[{"effect":"fadeout","id":304801},{"effect":"fadeout","id":305001},{"effect":"fadeout","id":305701}],"textClear":1},{"bgm":"bgm03_story10","chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300902,"motion":200,"pos":2},{"cheek":0,"face":"mtn_ex_020.exp3.json","id":305001,"motion":1,"pos":0}],"nameRight":"Manaka","surround":"7202_telepathy","textRight":"A Witch's signature...it's near the store!","turnEffect":"ef_adv_02"},{"chara":[{"id":305001,"motion":200}],"nameLeft":"Yuuna","textLeft":"You are occupied with running the store,"},{"chara":[{"id":305001}],"nameLeft":"Yuuna","textLeft":"so allow us to go in your stead."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300902,"motion":300}],"nameRight":"Manaka","textRight":"Asking you to do that—@is it really okay...?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304801,"motion":200,"pos":2}],"nameRight":"Hotaru","textRight":"...Won't your servaaants... All start asking@questions if you go~...?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":100}],"nameLeft":"Yuuna","textLeft":"There will be no issues."},{"autoTurnLast":0.8,"chara":[{"effect":"fadeout","id":304801}],"surround":"stop","textClear":1,"turnEffect":"stop"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":1},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800700,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800600,"motion":0,"pos":2}],"nameLeft":"Yuuna","textLeft":"I wish to have a little private chat, if you would be@so kind as to excuse yourselves."},{"chara":[{"id":800700}],"nameCenter":"","textCenter":"As you wish."},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
