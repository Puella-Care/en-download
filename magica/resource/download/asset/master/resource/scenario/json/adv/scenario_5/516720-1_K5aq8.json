{"story":{"group_1":[{"autoTurnLast":0.9,"bg":"bg_adv_19041.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304500,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_000.exp3.json","id":304800,"motion":100,"pos":2}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story01","chara":[{"id":304500,"motion":400}],"nameLeft":"Rion","textLeft":"Hey...so you're saying this...","turnChangeOut":"fadeOut"},{"chara":[{"id":304500,"motion":200}],"nameLeft":"Rion","textLeft":"This is a love triangle between Akari,@16 year old Akari, and Haruto, isn't it?!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":304500},{"effect":"fadeout","id":304800}],"surround":"stop","textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305000,"lipSynch":0,"motion":400,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304100,"lipSynch":0,"motion":400,"pos":2}],"nameCenter":"Yuuna & Hotori","textCenter":"[chara:305000:effect_emotion_surprise_0][chara:304100:effect_emotion_surprise_0][se:7226_shock]...?!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305000},{"effect":"fadeout","id":304100}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304100,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_000.exp3.json","id":304800,"motion":0,"pos":2}],"nameLeft":"Hotori","textLeft":"Soo..."},{"chara":[{"id":304100}],"nameLeft":"Hotori","textLeft":"11 year old Akari likes Haruto,"},{"chara":[{"id":304100}],"nameLeft":"Hotori","textLeft":"Haruto likes 16 year old Akari..."},{"chara":[{"id":304100,"motion":200}],"nameLeft":"Hotori","textLeft":"But Haruto..."},{"chara":[{"id":304100}],"nameLeft":"Hotori","textLeft":"...doesn't know 16 year old Akari's real identity...?"},{"chara":[{"id":304800,"motion":300}],"nameRight":"Hotaru","textRight":"Yup~..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305000,"motion":300,"pos":0}],"nameLeft":"Yuuna","textLeft":"My... Isn't that complicated."},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":304500,"motion":200,"pos":2}],"nameRight":"Rion","textRight":"Then why not reveal her secret identity?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304500}],"nameRight":"Rion","textRight":"At the end of the day, they both like each other,@right?"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":305700,"motion":400,"pos":0}],"nameLeft":"Akari","textLeft":"It's not that simple!"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304800,"motion":200,"pos":2}],"nameRight":"Hotaru","textRight":"Ah~...you're baaack...@How's Nikaidoooo~...?"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":305700,"motion":1}],"nameLeft":"Akari","textLeft":"He's on his way back to town.@I think he's okay now."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305000,"motion":100,"pos":2}],"nameRight":"Yuuna","textRight":"So, what was this about not being so simple?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":304800,"motion":400,"pos":2}],"nameRight":"Hotaru","textRight":"First of aaall...you'd have to tell hiim...@You're a Magical Girl, wouldn't yaa~...?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305700,"motion":300,"pos":0}],"nameLeft":"Akari","textLeft":"That's not the only thing..."},{"chara":[{"id":305700}],"nameLeft":"Akari","textLeft":"To Big Bro Haruto I'm just a little sister."},{"chara":[{"id":305700,"motion":0},{"id":304800,"motion":0}],"nameLeft":"Akari","textLeft":"If he knew the girl he loves..."},{"chara":[{"id":305700}],"nameLeft":"Akari","textLeft":"...wasn't the same age as him...@That I'm actually a grade schooler,"},{"chara":[{"eyeClose":1,"id":305700}],"nameLeft":"Akari","textLeft":"I'm sure his passion would freeze over..."},{"chara":[{"id":304800}],"nameRight":"Hotaru","textRight":"Well...he has known youuu since the day@you were booorn~..."},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":304800,"motion":1}],"nameRight":"Hotaru","textRight":"And in the first plaace...Nikaidooo..."},{"chara":[{"id":304800}],"nameRight":"Hotaru","textRight":"Doesn't seem the tyyype... To think thaaat~..."},{"chara":[{"id":304800}],"nameRight":"Hotaru","textRight":"Elementary kids are romantic intereeests~..."},{"chara":[{"eyeClose":0,"id":305700,"motion":200}],"nameLeft":"Akari","textLeft":"And I want him to see the real me."},{"chara":[{"id":305700}],"nameLeft":"Akari","textLeft":"Not in this magical transformed state."},{"chara":[{"id":305700,"motion":1}],"nameLeft":"Akari","textLeft":"The real me... I want him to see Akari Mai!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305000,"motion":1,"pos":2}],"nameRight":"Yuuna","textRight":"I see now..."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305000}],"nameRight":"Yuuna","textRight":"As I thought, you are quite the noble one, Akari."},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305000,"motion":100}],"nameRight":"Yuuna","textRight":"I shall support you once more."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305700,"motion":0}],"nameLeft":"Akari","textLeft":"Eh—..."},{"chara":[{"id":305000}],"nameRight":"Yuuna","textRight":"It is perfectly natural to want your identity@kept secret..."},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305000,"motion":200}],"nameRight":"Yuuna","textRight":"Thus I will keep your feelings secret as well."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305700,"motion":100}],"nameLeft":"Akari","textLeft":"Thank you so much."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305700,"motion":300}],"nameLeft":"Akari","textLeft":"...Um, when we first met..."},{"chara":[{"id":305700}],"nameLeft":"Akari","textLeft":"I had a really bad attitude towards you.@I'm very sorry."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305000,"motion":1}],"nameRight":"Yuuna","textRight":"Hehe, I wasn't bothered."},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":305700},{"effect":"fadeout","id":305000}],"textClear":1},{"autoTurnLast":1.5,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304100,"motion":0,"pos":2},{"cheek":1,"face":"mtn_ex_011.exp3.json","id":304500,"motion":100,"pos":0}]},{"chara":[{"cheek":0,"effect":"shake","eyeClose":1,"face":"mtn_ex_030.exp3.json","id":304100,"motion":100}],"nameRight":"Hotori","textRight":"Ow—...!@[chara:304100:lipSynch_0][wait:0.8][chara:304100:lipSynch_1][chara:304100:eyeClose_0]Rion, why're you nudging me?"},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":304500}],"nameLeft":"Rion","textLeft":"Isn't this turning out just like \"Mimical☆Mimiko\"?!"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":304500,"motion":400}],"nameLeft":"Rion","textLeft":"You can't tell me you're not excited!"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305000,"motion":0,"pos":0}],"nameLeft":"Yuuna","textLeft":"Is that the title of a shoujo manga?"},{"chara":[{"id":304100,"motion":1}],"nameRight":"Hotori","textRight":"It's the transforming heroine from a show@Rion likes..."},{"autoTurnLast":2.0,"bg":"bg_adv_19221.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300902,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"bgm":"bgm01_anime03","chara":[{"id":300902,"motion":100}],"nameLeft":"Manaka","textLeft":"Welcome back! Everyone safe and sound?","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305001,"motion":200}],"nameRight":"Yuuna","textRight":"Indeed, no worries."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305001},{"effect":"fadeout","id":300902}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_19221.jpg","bgChangeEffect":"cameraPan"},{"autoTurnLast":2.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800700,"motion":0,"pos":1}]},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":800700}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_19221.jpg","bgChangeEffect":"cameraPan"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300902,"motion":0,"pos":1}],"nameCenter":"Manaka","textCenter":"Ah—! Yuuna's house butler?"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300902}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800700,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":0,"pos":2}],"nameLeft":"","textLeft":"Lady Yuuna, apologies for interrupting@your conversation."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800700}],"nameLeft":"","textLeft":"As promised, Sir Nikaido has arrived here."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305001,"motion":100,"pos":2}],"nameRight":"Yuuna","textRight":"Oh my, is it that time already?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":1}],"nameRight":"Yuuna","textRight":"...Our private chat is over, so send him our way."},{"chara":[{"id":800700}],"nameLeft":"","textLeft":"As you wish."},{"autoTurnLast":1.5,"chara":[{"effect":"fadeout","id":800700}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":1,"pos":0}],"nameLeft":"Akari","textLeft":"Nikaido... Big Bro Haruto?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305001,"motion":200,"pos":2}],"nameRight":"Yuuna","textRight":"I apologize for failing to mention it to you."},{"chara":[{"id":305001}],"nameRight":"Yuuna","textRight":"You see, we were to meet later today. It was an@agreement to uphold..."},{"chara":[{"id":305701,"motion":400,"pos":0}],"nameLeft":"Akari","textLeft":"Ehh—?!"},{"chara":[{"eyeClose":1,"id":305001,"motion":300}],"nameRight":"Yuuna","textRight":"Our fathers insisted we do as a way to deepen@our relationship..."},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":304801,"motion":200,"pos":0}],"nameLeft":"Hotaru","textLeft":"Mm~...so that's whyyy...he was iin...@Hokuyo Waaard~..."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305001},{"effect":"fadeout","id":304801}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"motion":0,"pos":1}],"nameCenter":"Haruto Nikaido","textCenter":"I'm so late. I'm terribly sorry."},{"autoTurnLast":0.2,"chara":[{"id":800400,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":200,"pos":0}],"nameLeft":"Yuuna","textLeft":"No need to worry,"},{"chara":[{"id":305001}],"nameLeft":"Yuuna","textLeft":"as I was enjoying tea with pleasant company."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"motion":1,"pos":0}],"nameLeft":"Akari","textLeft":"Big Bro Haruto..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Akari? What're you doing in Hokuyo Ward?@Even Yura-senpai's here..."},{"chara":[{"id":305701,"motion":300}],"nameLeft":"Akari","textLeft":"Umm...just a coincidence, I guess...?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":304801,"motion":100,"pos":0}],"nameLeft":"Hotaru","textLeft":"Ya know the chef's daughter heeere~...?@We're friieends~..."},{"chara":[{"id":304801}],"nameLeft":"Hotaru","textLeft":"All of us aaare...Yuuna's bunch tooo~..."},{"chara":[{"id":304801,"motion":400}],"nameLeft":"Hotaru","textLeft":"Then weee...gu~ess you'd saaay...@Just hit it oooff~..."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":0,"pos":0}],"nameLeft":"Yuuna","textLeft":"Just what I was thinking."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"If that's how it is, I'm just intruding@on you guys then."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":400}],"nameLeft":"Yuuna","textLeft":"No such thing is happening.@Won't you have a seat?"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305001}],"nameLeft":"Yuuna","textLeft":"The one next to Akari is available after all."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701,"motion":400,"pos":0}],"nameLeft":"Akari","textLeft":"Here, big bro. Sit down!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"...Alright, guess I'll intrude then."},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
