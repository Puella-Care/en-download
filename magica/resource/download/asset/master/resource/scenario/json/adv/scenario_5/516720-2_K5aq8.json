{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_19021.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":0,"pos":0}],"turnChangeIn":"fadeIn"},{"bgm":"bgm01_anime02","chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Thank you for the wonderful time.","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305001,"motion":100,"pos":0}],"nameLeft":"Yuuna","textLeft":"Hehe, I enjoyed myself as well."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001}],"nameLeft":"Yuuna","textLeft":"Akari had a lot to talk about too."},{"chara":[{"id":305001,"motion":200}],"nameLeft":"Yuuna","textLeft":"Until next time."},{"chara":[{"id":305001}],"nameLeft":"Yuuna","textLeft":"I will see you at tomorrow's dinner party."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305001},{"effect":"fadeout","id":800400}],"textClear":1},{"autoTurnLast":1.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305001,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":304501,"motion":1,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":304101,"motion":1,"pos":2}]},{"autoTurnLast":1.0,"chara":[{"effect":"fadeout","id":305001},{"effect":"fadeout","id":304501},{"effect":"fadeout","id":304101}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701,"motion":0,"pos":0}],"nameRight":"Haruto Nikaido","textRight":"Shall we head home too?"},{"chara":[{"id":305701,"motion":100}],"nameLeft":"Akari","textLeft":"Yeah—!"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":305701,"motion":400,"pos":0},{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp3.json","id":304801,"motion":0,"pos":2}],"nameLeft":"Akari","textLeft":"Hotaru, get up! We're leaving!"},{"chara":[{"eyeClose":0,"id":304801,"motion":1}],"nameRight":"Hotaru","textRight":"Mm~...mm... I'm uuup~..."},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":305701,"motion":200}],"nameLeft":"Akari","textLeft":"Geez—! You call that getting up?!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400,"motion":0,"pos":2}],"nameRight":"Haruto Nikaido","textRight":"Ahaha... Same as ever, huh..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"I've called for a car, so can you help Senpai@to her place?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"motion":1}],"nameLeft":"Akari","textLeft":"Yeah... I'll do that."},{"autoTurnLast":1.0,"bg":"bg_adv_15042.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"Sorry for the wait! I got Hotaru into her house.","turnChangeOut":"fadeOut"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"You're always a big help!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"lipSynch":0}],"nameRight":"Haruto Nikaido","textRight":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"motion":100}],"nameLeft":"Akari","textLeft":"Big Bro Haruto?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Want to walk home? There's something I want@to talk about."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701}],"nameLeft":"Akari","textLeft":"That's fine..."},{"autoTurnLast":0.01,"bg":"bg_adv_15022.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701,"motion":0,"pos":0}],"turnChangeIn":"fadeIn"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"How was it meeting Miss Kaharu?","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":1}],"nameLeft":"Akari","textLeft":"How..."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305701}],"nameLeft":"Akari","textLeft":"She's different in some ways,@but she's a nice person."},{"chara":[{"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(And she's supporting my love interest.)"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"So you two get along?"},{"chara":[{"id":305701,"motion":200}],"nameLeft":"Akari","textLeft":"Of course!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Is that so..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":0}],"nameLeft":"Akari","textLeft":"...Why'd you ask me that?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"lipSynch":0,"motion":0}],"nameRight":"Haruto Nikaido","textRight":"…………"},{"bgm":"stop","chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"I'm thinking... Of giving up on love."},{"bgm":"bgm03_story07","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":400}],"nameLeft":"Akari","textLeft":"Eh—...? W-wait!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701}],"nameLeft":"Akari","textLeft":"Your first love... Didn't you say you liked her?!"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"But why?!"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"Did you fall in love with Yuuna?!"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"That's not it at all.@...It's just, I think about the family."},{"chara":[{"id":305701,"motion":0}],"nameLeft":"Akari","textLeft":"The family... You mean Uncle and Auntie?"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"There's my parents' expectations too, but it's@mainly the company."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Father's company grew..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"...because everyone working there@does everything they can."},{"chara":[{"id":305701,"motion":300}],"nameLeft":"Akari","textLeft":"...I know that, but..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Eventually I'm intending on taking over@father's company,"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"so I need to protect those people who work@so hard for it all."},{"chara":[{"id":305701,"motion":100}],"nameLeft":"Akari","textLeft":"Okay, but what does that have to do with@giving up on love?"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"The Kaharu group is a huge company,"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"so if we broke off,"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"it would have a horrible impact."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Not just for your big bro and your family,"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"but for everyone working at the Nikaido group."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"They might even lose their jobs..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":0}],"nameLeft":"Akari","textLeft":"Ah—..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"I was just thinking...@I can't go abusing all these people..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"For my own selfish feelings... All for some love@that may not even come true."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"lipSynch":0,"motion":1}],"nameLeft":"Akari","textLeft":"(Maybe what big bro is saying is right...)"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"...But, Yuuna,"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"she said she had other things to do, so getting@engaged was unthinkable to her..."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Of course, I respect Miss Kaharu's feelings."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"However, regarding this, your big bro..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"...has decided to stop objecting to what@his parents are set on."},{"chara":[{"id":305701,"motion":200}],"nameLeft":"Akari","textLeft":"...Are you okay with that?"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"If I'm going to inherit the company,@then it can't be for myself alone."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Besides, if it's Miss Kaharu,"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"I'm sure you'll get along nicely too."},{"chara":[{"id":305701,"lipSynch":0,"motion":0}],"nameLeft":"Akari","textLeft":"(...Big Bro Haruto,)"},{"chara":[{"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(you weren't being swept away by all of this,@you were thinking about everyone.)"},{"chara":[{"id":305701,"lipSynch":0,"motion":300,"pos":0}],"nameLeft":"Akari","textLeft":"(I never thought of it that way.)"},{"chara":[{"eyeClose":1,"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(Unlike Big Bro Haruto, I'm...still just a child...)"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Umm...I didn't scare you with all this@complicated stuff, did I?"},{"chara":[{"eyeClose":0,"id":305701,"lipSynch":0,"motion":1}],"nameLeft":"Akari","textLeft":"…………"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"I'm sorry..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"But you're a part of precious family,@so I wanted to tell you."},{"chara":[{"id":305701,"lipSynch":0,"motion":0}],"nameLeft":"Akari","textLeft":".....[wait:0.8][chara:305701:lipSynch_1]Yeah..."},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
