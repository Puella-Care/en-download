{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_21442.jpg","chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":305701,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story07","chara":[{"id":305701,"lipSynch":0,"motion":300}],"nameLeft":"Akari","textLeft":"…………","turnChangeOut":"fadeOut"},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"...You stopped crying, then?"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"Yeah..."},{"chara":[{"eyeClose":1,"id":305701,"motion":1}],"nameLeft":"Akari","textLeft":"Big Bro...Haruto... I'm...so sorry..."},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"No, your big bro here's the one who oughta@be apologizing."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"I'm sorry, Akari."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"All this rushing's made you worry, hasn't it..."},{"chara":[{"eyeClose":0,"id":305701,"lipSynch":0,"motion":0}],"nameLeft":"Akari","textLeft":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"But hey,"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"Your big bro's not going to leave you behind,@Akari."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"I've told you this before, but..."},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"No matter what happens to me, your big bro's@always gonna be your big bro."},{"chara":[{"eyeClose":1,"id":305701,"lipSynch":0,"motion":400}],"nameLeft":"Akari","textLeft":"(...Damn it—!)"},{"chara":[{"eyeClose":0,"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(It's not that I'm crying because I thought...)"},{"chara":[{"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(That my beloved big bro was going away...)"},{"chara":[{"id":305701,"lipSynch":0,"motion":200}],"nameLeft":"Akari","textLeft":"(I didn't want this because the person I love)"},{"chara":[{"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(would be taken away from me...)"},{"chara":[{"eyeClose":1,"id":305701,"lipSynch":0,"motion":300}],"nameLeft":"Akari","textLeft":"(The most important part is what you don't get...)"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"My precious little sister...@If I knew this would make you sad,"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"I would have turned this whole thing down@from the beginning..."},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":305701,"motion":0}],"nameLeft":"Akari","textLeft":"Eh—... For me...?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"lipSynch":0,"motion":100}],"nameLeft":"Akari","textLeft":"(I'm happy to hear that, but...)"},{"chara":[{"eyeClose":1,"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"(It may be as Hotaru said...)"},{"autoTurnLast":0.8,"bg":"bg_adv_21141.jpg","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":304801,"motion":1,"pos":1}],"turnChangeIn":"fadeIn","turnEffect":"blackFrame"},{"chara":[{"id":304801}],"nameCenter":"Hotaru","textCenter":"Akari and Nikaidoooo... You guys are two birds@hit by one weeiird stone.","turnChangeOut":"fadeOut"},{"chara":[{"id":304801}],"nameCenter":"Hotaru","textCenter":"Neither honeeest... About your true feeliiings~..."},{"chara":[{"id":304801}],"nameCenter":"Hotaru","textCenter":"And for the person you looove...@Willing to give up on love itseeelf."},{"autoTurnLast":0.01,"bg":"bg_adv_21442.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305701,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"motion":0,"pos":2}],"turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"id":305701,"lipSynch":0}],"nameLeft":"Akari","textLeft":"…………","turnChangeOut":"fadeOut"},{"chara":[{"id":305701,"motion":0}],"nameLeft":"Akari","textLeft":"...Hey um, Big Bro Haruto."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Hm? ...What?"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"If I say I don't like it, would you give up@on the person you love?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400}],"nameRight":"Haruto Nikaido","textRight":"Eh—...?"},{"chara":[{"id":305701,"motion":100}],"nameLeft":"Akari","textLeft":"...If I say I \"hate\" the person you love, big bro,"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"would you hate that person...?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":800400,"lipSynch":0}],"nameRight":"Haruto Nikaido","textRight":"…………"},{"chara":[{"id":800400}],"nameRight":"Haruto Nikaido","textRight":"...That's...umm...I'm...not sure."},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":305701,"motion":200}],"nameLeft":"Akari","textLeft":"It's wrong, isn't it?"},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"Love..."},{"chara":[{"id":305701}],"nameLeft":"Akari","textLeft":"Such a thing can't just be given up on.@That's what love is, isn't it?"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800400,"lipSynch":0}],"nameRight":"Haruto Nikaido","textRight":"…………"},{"chara":[{"eyeClose":1,"id":305701,"motion":0}],"nameLeft":"Akari","textLeft":"Therefore,"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp3.json","id":305701}],"nameLeft":"Akari","textLeft":"Big Bro Haruto, if there's someone you love too,@you can't give up."},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
