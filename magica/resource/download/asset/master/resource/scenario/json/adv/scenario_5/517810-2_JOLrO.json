ara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameRight":"Aru-chan","textRight":"<Stop thinking and retreat!>"},{"chara":[{"cheek":0,"face":"mtn_ex_231.exp3.json","id":102000,"lipSynch":0,"motion":300}],"nameRight":"Kagome","textRight":"..."},{"chara":[{"cheek":0,"dollLipSynch":1.0,"face":"mtn_ex_331.exp3.json","id":102000,"lipSynch":0}],"nameRight":"Aru-chan","textRight":"<If there's some kind of clue...>"},{"autoTurnLast":1.0,"chara":[{"effect":"slideOutRightFast","id":102000}],"textClear":1},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":6105,"name":"sprite_0"}],"textClear":1},{"autoTurnLast":0.5,"bg":"bg_adv_21423.jpg","bgChangeEffect":"exitWitchSpace","bgm":"stop","se":"7209_gate_close"},{"autoTurnLast":0.01,"bg":"black","item":[{"path":"resource/scenario/img/51178_tower_kagome/memoria_1832.jpg","posX":0,"posY":0,"visible":"appear"}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story12","nameNarration":"Kagome","narration":"ーKagomeー@...*Pant*...*Pant*...","narrationAnchor":"bottom","narrationCoverOpacity":110.0,"narrationEffect":"in","narrationFontSize":30.0,"narrationLineMargin":35.0,"narrationLineSpace":20.0,"turnChangeOut":"fadeOut"},{"nameNarration":"Aru-chan","narration":"ーAru-chanー@<Kagome-chan...are you okay...?>"},{"nameNarration":"Kagome","narration":"ーKagomeー@Yeah...somehow..."},{"narration":"ーKagomeー@...But...@I might not be able to take...another step..."},{"autoTurnLast":0.01,"bg":"bg_adv_21423.jpg","chara":[{"cheek":0,"face":"mtn_ex_330.exp3.json","id":102000,"motion":0,"pos":1}],"item":[{"path":"resource/scenario/img/51178_tower_kagome/memoria_1832.jpg","visible":"hide"}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102000,"motion":300}],"nameCenter":"Kagome","textCenter":"Uu...how...","turnChangeOut":"fadeOut"},{"chara":[{"id":102000}],"nameCenter":"Kagome","textCenter":"Why, why couldn't I give one final push..."},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0,"motion":0}],"nameCenter":"Aru-chan","textCenter":"<It can't be helped...>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<The Automatic Purification System doesn't mean@a thing...>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<...if you get beaten by a Witch.>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<If anything, you should be really happy@you got away in time...>"},{"chara":[{"id":102000,"motion":400}],"nameCenter":"Kagome","textCenter":"But...we can't leave the Witch like this...!"},{"chara":[{"cheek":0,"dollLipSynch":1.0,"face":"mtn_ex_530.exp3.json","id":102000,"lipSynch":0,"motion":200}],"nameCenter":"Aru-chan","textCenter":"<Y-you can't expect us to go fight in this state!>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<It's time to swallow your pride and ask for help!>"},{"chara":[{"id":102000,"motion":1}],"nameCenter":"Kagome","textCenter":"...But...!"},{"chara":[{"cheek":0,"dollLipSynch":1.0,"face":"mtn_ex_330.exp3.json","id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<I know how you feel...>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<But it's not right at all to force yourself this far.>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<So, please...@Just this once, can you ask for help?>"},{"chara":[{"id":102000,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"…………"},{"chara":[{"id":102000,"motion":300}],"nameCenter":"Kagome","textCenter":"...Y-you're right...@I'm sorry for sounding so selfish..."},{"chara":[{"id":102000}],"nameCenter":"Kagome","textCenter":"I'll send a message calling for support right away."},{"autoTurnLast":1.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300601,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":1,"pos":0}],"turnChangeIn":"fadeIn"},{"chara":[{"id":300601,"motion":100}],"nameRight":"Emiri","textRight":"Kagomecchi, we're all dooone!","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001}],"nameLeft":"Kagome","textLeft":"A-are you all okay...?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":101301,"motion":100,"pos":2}],"nameRight":"Asuka","textRight":"Yes!"},{"chara":[{"id":101301}],"nameRight":"Asuka","textRight":"With this many people it was like a tea party!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300201,"motion":100,"pos":2}],"nameRight":"Natsuki","textRight":"When we hit her in unison it was over just like that."},{"chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":400}],"nameLeft":"Kagome","textLeft":"Eh—...!@Is that true...?"},{"chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001}],"nameLeft":"Kagome","textLeft":"Then I shouldn't have ran. If I just held out@a little longer..."},{"chara":[{"id":102000}],"nameLeft":"Kagome","textLeft":"I apologize for taking your time..."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300301,"motion":200,"pos":2}],"nameRight":"Hinano","textRight":"Well, it's better than underestimating them@and learning the painful way."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300901,"motion":100,"pos":2}],"nameRight":"Manaka","textRight":"And if the Witch got you, you'd lose it all!"},{"chara":[{"id":102001,"motion":300}],"nameLeft":"Kagome","textLeft":"Yes...you're right..."},{"chara":[{"id":102001,"lipSynch":0}],"nameLeft":"Kagome","textLeft":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300301,"motion":0,"pos":2}],"nameRight":"Hinano","textRight":"What's bothering you, Kagome?"},{"chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001,"motion":0}],"nameLeft":"Kagome","textLeft":"Ah—...I'm sorry. It's nothing."},{"chara":[{"id":102001}],"nameLeft":"Kagome","textLeft":"Anyways, everyone, thank you for your cooperation."},{"autoTurnLast":1.0,"bg":"bg_adv_21075.jpg","chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102003,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102003,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"…………","turnChangeOut":"fadeOut"},{"chara":[{"id":102003,"lipSynch":0,"motion":300}],"nameCenter":"Kagome","textCenter":"(...It's been a long time since I've been saved...)"},{"chara":[{"id":102003,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"(By becoming a Magical Girl,)"},{"chara":[{"eyeClose":1,"id":102003,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"(I thought that I could save many, many people...)"},{"chara":[{"cheek":0,"dollLipSynch":1.0,"face":"mtn_ex_330.exp3.json","id":102003,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<Kagome-chan...you don't look happy...>"},{"chara":[{"cheek":0,"face":"mtn_ex_350.exp3.json","id":102003,"lipSynch":0,"motion":400}],"nameCenter":"Kagome","textCenter":"...!@[wait:1.2][chara:102003:lipSynch_1]T-that's not true."},{"chara":[{"dollLipSynch":1.0,"id":102003,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<Really?>"},{"chara":[{"cheek":0,"face":"mtn_ex_310.exp3.json","id":102003,"motion":0}],"nameCenter":"Kagome","textCenter":"Yeah."},{"chara":[{"id":102003}],"nameCenter":"Kagome","textCenter":"...It's just...so much has happened, so maybe@I'm just a little exhausted."},{"chara":[{"id":102003}],"nameCenter":"Kagome","textCenter":"I'm sure I'll be back to normal after@a good night's sleep ."},{"chara":[{"cheek":0,"face":"mtn_ex_330.exp3.json","id":102003,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_330.exp3.json","id":102003,"lipSynch":0,"motion":200}],"nameCenter":"Kagome","textCenter":"(I didn't mean to show it on my face...@I'm still so immature...)"},{"chara":[{"id":102003,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"(I don't want Aru-chan worrying about me@anymore now,)"},{"chara":[{"id":102003,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"(so I'm going to bed early. I need to get@my energy back...)"},{"chara":[{"cheek":0,"face":"mtn_ex_300.exp3.json","id":102003,"motion":0}],"nameCenter":"Kagome","textCenter":"...Alright."},{"chara":[{"cheek":0,"face":"mtn_ex_310.exp3.json","id":102003,"motion":100}],"nameCenter":"Kagome","textCenter":"Have a good night, Aru-chan."},{"chara":[{"dollLipSynch":1.0,"id":102003,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<...Night, Kagome-chan.>"},{"autoTurnLast":0.01,"bg":"bg_adv_21173.jpg","bgm":"stop","turnChangeIn":"fadeIn"},{"autoTurnLast":3.0,"bgChangeEffect":"fade","turnChangeOut":"fadeOut"},{"autoTurnLast":3.0,"bg":"bg_adv_21171.jpg"},{"autoTurnLast":0.01,"bg":"bg_adv_21071.jpg","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_140.exp3.json","id":102003,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"*Beep beep beep beep...*","narrationBg":"bg_adv_21071.jpg","narrationEffect":"in","surround":"7001_birdsong","turnChangeOut":"fadeOut"},{"chara":[{"id":102003,"motion":300}],"nameCenter":"Kagome","narrationEffect":"out","textCenter":"...Nnngh... I'm...up now..."},{"nameNarration":"","narration":"*Beep!*","narrationBg":"bg_adv_21071.jpg","narrationEffect":"in"},{"chara":[{"eyeClose":0,"id":102003,"motion":100,"pos":1}],"nameCenter":"Kagome","narrationEffect":"out","textCenter":"*Yaaawn*~...that was a good rest..."},{"chara":[{"cheek":0,"face":"mtn_ex_110.exp3.json","id":102003}],"nameCenter":"Kagome","textCenter":"Good morning, Aru-chan."},{"chara":[{"dollLipSynch":1.0,"id":102003,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"＜×××××＞"},{"chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102003,"lipSynch":0,"motion":0}],"nameCenter":"Kagome","textCenter":"…………"},{"chara":[{"id":102003,"motion":300}],"nameCenter":"Kagome","textCenter":"...Hm...?@Sorry, I didn't hear you very well."},{"chara":[{"dollLipSynch":1.0,"id":102003,"lipSynch":0,"motion":200}],"nameCenter":"Aru-chan","surround":"stop","textCenter":"＜×××××！＞"},{"chara":[{"cheek":0,"face":"mtn_ex_140.exp3.json","id":102003,"motion":1}],"nameCenter":"Kagome","textCenter":"Huh?"},{"chara":[{"id":102003}],"nameCenter":"Kagome","textCenter":"I'm sorry, Aru-chan, just a little clearer..."},{"chara":[{"cheek":0,"dollLipSynch":1.0,"face":"mtn_ex_550.exp3.json","id":102003,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"＜×××××!?@×××××…＞"},{"chara":[{"id":102003}],"nameCenter":"Kagome","textCenter":"...Oh no."},{"chara":[{"id":102003,"motion":400}],"nameCenter":"Kagome","textCenter":"I can't understand what you're saying anymore...!"},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
