{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_13111.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300601,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story02","chara":[{"id":300601,"motion":400}],"nameCenter":"Emiri","textCenter":"Whew~! Finally got my smartphone charged up!","turnChangeOut":"fadeOut"},{"chara":[{"id":300601}],"nameCenter":"Emiri","textCenter":"Pretty careless of me to forget to charge it."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300601}],"nameCenter":"Emiri","textCenter":"If I'd been just a minute late in checking it@this morning then it woulda been dead."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300601,"motion":0}],"nameCenter":"Emiri","textCenter":"Alrighty, who's been texting me~"},{"nameNarration":"","narration":"[se:7106_telmail]*Ring♪*","narrationBg":"bg_adv_13111.jpg","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300601}],"nameCenter":"Emiri","narrationEffect":"out","textCenter":"Mm...Aru-chan's missing...?"},{"chara":[{"id":300601}],"nameCenter":"Emiri","textCenter":"Aru-chan, like THAT Aru-chan, right?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300601,"motion":300}],"nameCenter":"Emiri","textCenter":"I'm totally worried for her."},{"nameNarration":"","narration":"[se:7106_telmail]*Ring♪ Ring♪*","narrationBg":"bg_adv_13111.jpg","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300601,"motion":400}],"nameCenter":"Emiri","narrationEffect":"out","textCenter":"Yikes...! And there's rumors she's being@manipulated by a Witch."},{"chara":[{"id":300601}],"nameCenter":"Emiri","textCenter":"This is no laughing matter, is it!?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300601}],"nameCenter":"Emiri","textCenter":"I'm totes sorry I didn't catch these crazy messages...!"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300601,"motion":200}],"nameCenter":"Emiri","textCenter":"Now I gotta go all in with my support!"},{"chara":[{"id":300601}],"nameCenter":"Emiri","textCenter":"Wait for me, Kagomecchi!"},{"nameNarration":"","narration":"*Rustle...*","narrationBg":"bg_adv_13111.jpg","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300601,"motion":0}],"nameCenter":"Emiri","narrationEffect":"out","textCenter":"Mm...what was that sound just now...?"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300601}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_13111.jpg","bgChangeEffect":"cameraPan"},{"autoTurnLast":1.0},{"autoTurnLast":0.1,"bg":"bg_adv_13111.jpg","bgChangeEffect":"cameraPan"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300601,"motion":0,"pos":1}],"nameCenter":"Emiri","textCenter":"Oh heck...just a shopping bag...@That made me jump."},{"bgm":"stop","nameNarration":"","narration":"*Rustle...rustle...*","narrationBg":"bg_adv_13111.jpg","narrationEffect":"in"},{"chara":[{"id":300601}],"nameCenter":"Emiri","narrationEffect":"out","textCenter":"Oh no, I'm wrong? There's really something there!?"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300601}],"textClear":1},{"autoTurnLast":2.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":820400,"motion":0,"pos":1}]},{"autoTurnLast":0.2,"chara":[{"id":820400,"pos":2}],"textClear":1},{"bgm":"bgm05_event07","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300601,"motion":400,"pos":0}],"nameLeft":"Emiri","textLeft":"[chara:300601:effect_emotion_surprise_0][se:7226_shock]T-there it iiis~~!!"},{"chara":[{"id":300601,"motion":0}],"nameLeft":"Emiri","textLeft":"Wait...ehh!? Why're you here!?"},{"chara":[{"id":820400,"lipSynch":0}],"nameRight":"Aru-chan","textRight":"＜…………＞"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300601,"motion":300}],"nameLeft":"Emiri","textLeft":"Yikes...! Wait a tick before you start freaking out!"},{"chara":[{"id":300601}],"nameLeft":"Emiri","textLeft":"I'm not mentally prepared for this yet!"},{"chara":[{"id":820400,"lipSynch":0}],"nameRight":"Aru-chan","textRight":"＜…………＞"},{"autoTurnLast":0.8,"chara":[{"effect":"fadeout","id":820400}],"se":"3002_chara_dead","textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300601,"motion":400}],"nameLeft":"Emiri","textLeft":"Eh—...wait...!! Aru-chan!?"},{"nameRight":"Aru-chan's Voice","textRight":"＜…………＞"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300601}],"nameLeft":"Emiri","textLeft":"She just suddenly stopped moving...@What's going on...?"},{"chara":[{"id":300601,"lipSynch":0}],"nameLeft":"Emiri","textLeft":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300601,"motion":100}],"nameLeft":"Emiri","textLeft":"Well...I don't get it but hey, you could say this@turned out a-okay, right?"},{"chara":[{"id":300601}],"nameLeft":"Emiri","textLeft":"Lemme just tie you up with some string@so you don't run away..."},{"chara":[{"id":300601,"motion":0,"pos":1}],"nameNarration":"","narration":"*Grab grab...!*","narrationBg":"bg_adv_13111.jpg","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300601,"motion":200}],"nameCenter":"Emiri","narrationEffect":"out","textCenter":"And there we have it!"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300601}],"nameCenter":"Emiri","textCenter":"...Huh?@The picture books are scattered everywhere..."},{"chara":[{"id":300601}],"nameCenter":"Emiri","textCenter":"This's the \"Witch of the South Pole\" series@I donated!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300601,"motion":0}],"nameCenter":"Emiri","textCenter":"Why'd you bring these on over@from the kids corner?"},{"chara":[{"id":300601}],"nameCenter":"Emiri","textCenter":"You really are a little prankster."},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300601}],"nameCenter":"Emiri","textCenter":"Later on I'm having Kagomecchi give you@a good scolding!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300601,"motion":100}],"nameCenter":"Emiri","textCenter":"...For now though I gotta let her know@Aru-chan is in custody!"},{"autoTurnLast":1.0,"bg":"bg_adv_21141.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":2,"pos":1}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"[se:7106_telmail]*Ring♪*","narrationBg":"bg_adv_21141.jpg","narrationEffect":"in","surround":"7001_birdsong","turnChangeOut":"fadeOut"},{"chara":[{"id":102001,"lipSynch":0}],"nameCenter":"Kagome","narrationEffect":"out","textCenter":"...!@[wait:0.8][chara:102001:lipSynch_1]It's from Kisaki-san..."},{"nameNarration":"Emiri","narration":"Caught Aru-chan!@Don't know why, but she fell over@right in front of me all of a sudden...@Sorry, but come get her@at the consultation office!","narrationBg":"bg_adv_21141.jpg","narrationEffect":"in","narrationHAlignment":"left","narrationPosX":180.0},{"chara":[{"id":102001,"motion":401}],"nameCenter":"Kagome","narrationEffect":"out","textCenter":"[chara:102001:effect_emotion_surprise_0][se:7226_shock]Eh—...!!"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"A-Aru-chan's...been found!?"},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
