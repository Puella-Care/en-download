{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"black","item":[{"path":"resource/scenario/img/51178_tower_kagome/memoria_1831.jpg","posX":0,"posY":0,"visible":"appear"}],"turnChangeIn":"fadeIn"},{"nameNarration":"Kagome","narration":"ーKagomeー@Go, Aru-chan!!","narrationAnchor":"bottom","narrationCoverOpacity":110.0,"narrationEffect":"in","narrationFontSize":30.0,"narrationLineMargin":35.0,"narrationLineSpace":20.0,"turnChangeOut":"fadeOut"},{"nameNarration":"Aru-chan","narration":"ーAru-chanー@<We'll split up@and attack all at once!>"},{"narration":"ーAru-chanー@<Torya torya toryaaa!!>"},{"autoTurnLast":0.2,"bg":"bg_adv_46105.jpg","chara":[{"id":6105,"name":"sprite_0","pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"autoTurnLast":0.8,"chara":[{"effect":"7001_attack02","id":6105,"name":"sprite_0"}],"surround":"1020A03","textClear":1,"turnChangeOut":"fadeOut"},{"autoTurnLast":0.8,"chara":[{"effect":"7003_damage02","id":6105,"name":"sprite_0"}],"nameCenter":"","textBg":"shout","textCenter":"[surround:1020A10][name:sprite_0:effect_7003_damage02][bgEffect:shakeLarge]...!!"},{"autoTurnLast":1.2,"chara":[{"effect":"fadeout","id":6105,"name":"sprite_0"}],"se":"3102_enemy_dead","textClear":1},{"autoTurnLast":0.5,"bg":"bg_adv_13111.jpg","bgChangeEffect":"exitWitchSpace","se":"7209_gate_close"},{"bgm":"bgm05_event10","chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102000,"lipSynch":0,"motion":0,"pos":1}],"nameCenter":"Kagome","textCenter":"…………"},{"chara":[{"id":102000}],"nameCenter":"Kagome","textCenter":"It's...defeated...!"},{"chara":[{"id":102000,"motion":200}],"nameCenter":"Kagome","textCenter":"I...beat a strong enemy...!"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<You did it, Kagome-chan!>"},{"chara":[{"cheek":0,"face":"mtn_ex_111.exp3.json","id":102000,"motion":100}],"nameCenter":"Kagome","textCenter":"I did it, I did iiit!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102000}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300600,"motion":300,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300900,"motion":0,"pos":2}],"nameLeft":"Emiri","textLeft":"Huii~... Th...that was yikes~"},{"chara":[{"id":300900}],"nameRight":"Manaka","textRight":"Owie..."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300600},{"effect":"fadeout","id":300900}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102000,"motion":400,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300300,"motion":0,"pos":2}],"nameLeft":"Kagome","textLeft":"Guys! Are you all okay!?"},{"chara":[{"id":300300,"motion":300}],"nameRight":"Hinano","textRight":"...Guess so."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102000},{"effect":"fadeout","id":300300}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300200,"motion":300,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":101300,"motion":0,"pos":2}],"nameLeft":"Natsuki","textLeft":"But that could have gotten pretty close..."},{"chara":[{"id":101300,"motion":100}],"nameRight":"Asuka","textRight":"This time Kagome-san is the one who rescued us@with all her might!"},{"chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102000,"motion":200,"pos":0}],"nameLeft":"Kagome","textLeft":"N-not at all...!"},{"chara":[{"id":102000},{"id":101300,"motion":0}],"nameLeft":"Kagome","textLeft":"It's because of everyone's help that@I've come this far."},{"chara":[{"cheek":0,"face":"mtn_ex_110.exp3.json","id":102000,"motion":100}],"nameLeft":"Kagome","textLeft":"...But I'm glad I was able to be useful..."},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameLeft":"Aru-chan","textLeft":"<Yeah, yeah!>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameLeft":"Aru-chan","textLeft":"<If Kagome-chan's happy, then I'm happy too.>"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300300,"motion":400,"pos":2}],"nameRight":"Hinano","textRight":"At any rate, Aru-chan...@I don't get your methods."},{"chara":[{"cheek":0,"face":"mtn_ex_550.exp3.json","id":102000,"lipSynch":0,"motion":400}],"nameLeft":"Aru-chan","textLeft":"<...!!>"},{"chara":[{"cheek":0,"dollLipSynch":1.0,"face":"mtn_ex_350.exp3.json","id":102000,"lipSynch":0}],"nameLeft":"Aru-chan","textLeft":"<My message to everyone...you mean?>"},{"chara":[{"id":300300,"motion":0}],"nameRight":"Hinano","textRight":"What else would I be talking about."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300900,"motion":100,"pos":2}],"nameRight":"Manaka","textRight":"I wish you would have been at least a little easier@to understand..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":101300,"motion":300,"pos":2}],"nameRight":"Asuka","textRight":"To even decipher that in a single try is impossible,"},{"chara":[{"id":101300}],"nameRight":"Asuka","textRight":"lest you belong to a riddle-solving research society@at an elite university..."},{"chara":[{"cheek":0,"dollLipSynch":1.0,"face":"mtn_ex_330.exp3.json","id":102000,"lipSynch":0,"motion":1}],"nameLeft":"Aru-chan","textLeft":"<I-I'm sorry, everyone...!>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameLeft":"Aru-chan","textLeft":"<At that time I was desperate and lost my@composure...>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameLeft":"Aru-chan","textLeft":"<I couldn't even communicate, so that's all@I could try and focus on...>"},{"chara":[{"id":102000,"motion":300}],"nameLeft":"Kagome","textLeft":"...This was my responsibility from the start."},{"chara":[{"id":102000}],"nameLeft":"Kagome","textLeft":"Because of the shock from losing to that Witch,"},{"chara":[{"id":102000}],"nameLeft":"Kagome","textLeft":"I subconsciously suppressed my magic,"},{"chara":[{"id":102000}],"nameLeft":"Kagome","textLeft":"causing Aru-chan to lose her ability@to communicate."},{"chara":[{"id":102000}],"nameLeft":"Kagome","textLeft":"As a result, I put everyone in danger..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300300,"motion":0,"pos":2}],"nameRight":"Hinano","textRight":"I see...so this incident began with a mental slump."},{"chara":[{"cheek":0,"face":"mtn_ex_331.exp3.json","id":102000,"motion":200}],"nameLeft":"Kagome","textLeft":"I'm really terribly sorry...!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102000},{"effect":"fadeout","id":300300}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300200,"motion":100,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":101300,"motion":0,"pos":2}],"nameLeft":"Natsuki","textLeft":"Don't apologize, Kagome-san.@Everyone has days like that."},{"chara":[{"id":101300,"motion":200}],"nameRight":"Asuka","textRight":"We're all equals there, and thus should help@one another!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300200},{"effect":"fadeout","id":101300}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300900,"motion":100,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300600,"motion":0,"pos":0}],"nameRight":"Manaka","textRight":"That's the truth! It's essential that Magical Girls@support each other."},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":300600,"motion":100}],"nameLeft":"Emiri","textLeft":"We'll just say we owe you this time!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300600},{"effect":"fadeout","id":300900}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_110.exp3.json","id":102000,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_000.exp3.json","id":300300,"motion":0,"pos":2}],"nameLeft":"Kagome","textLeft":"Everyone... Thank you so much...!"},{"chara":[{"id":200,"motion":0}],"nameRight":"Hinano","textRight":"Well, we can call this case closed now,"},{"chara":[{"id":200}],"nameRight":"Hinano","textRight":"so good work, everyone."},{"autoTurnLast":1.5,"bg":"bg_adv_21073.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_110.exp3.json","id":102001,"motion":1,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story18","chara":[{"dollLipSynch":1.0,"id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<Kagome-chan, what are you doing?>","turnChangeOut":"fadeOut"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"I thought I would leave a report of this event,"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"just so I don't panic if I run into a Witch@like that again, you know?"},{"chara":[{"dollLipSynch":1.0,"id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<Heeh! That's my Kagome-chan!>"},{"chara":[{"id":102001,"motion":100}],"nameCenter":"Kagome","textCenter":"...Also, to etch into my mind..."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"...that it's never wrong to ask for help."},{"chara":[{"dollLipSynch":1.0,"id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<Eh—...?>"},{"chara":[{"id":102001,"motion":200}],"nameCenter":"Kagome","textCenter":"Before I became a Magical Girl,"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"I ended up being saved a lot of times, didn't I?"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"When I became a Magical Girl I wanted to be@more helpful to everyone."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"I've been thinking for a while..."},{"chara":[{"id":102001,"motion":1}],"nameCenter":"Kagome","textCenter":"Until this point, I was able to exterminate Witches@all on my own."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"It's like I subconsciously convinced myself..."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"...that asking for help was a bad thing@this late into it all."},{"chara":[{"eyeClose":1,"id":102001,"motion":300}],"nameCenter":"Kagome","textCenter":"It's embarrassing to admit, but I may have gotten@a little conceited..."},{"chara":[{"dollLipSynch":1.0,"id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<I see... It's great that you even recognized that.>"},{"chara":[{"dollLipSynch":1.0,"id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<Kagome-chan, you've grown so much,@you know that?>"},{"chara":[{"eyeClose":0,"id":102001,"motion":0}],"nameCenter":"Kagome","textCenter":"Yeah..."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"So when I hit a wall again,"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"I'll remember this time..."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"...and face it without being afraid of failure."},{"chara":[{"cheek":0,"face":"mtn_ex_111.exp3.json","id":102001,"motion":100}],"nameCenter":"Kagome","textCenter":"...So stay by my side from now on, okay?"},{"chara":[{"dollLipSynch":1.0,"id":102001,"lipSynch":0,"motion":200}],"nameCenter":"Aru-chan","textCenter":"<Yeah...>"},{"chara":[{"dollLipSynch":1.0,"id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<No matter what happens, I'll always be with you,@Kagome-chan!>"},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn","turnChangeInTime":1.0}]},"version":3}
