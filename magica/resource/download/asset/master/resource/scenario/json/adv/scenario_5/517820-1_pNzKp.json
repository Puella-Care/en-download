{"story":{"group_1":[{"autoTurnLast":0.9,"bg":"bg_adv_21151.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300301,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300601,"motion":200,"pos":0}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"[se:7106_telmail]*Ring*","narrationBg":"bg_adv_21151.jpg","narrationEffect":"in","turnChangeOut":"fadeOut"},{"chara":[{"id":300301}],"nameRight":"Hinano","narrationEffect":"out","textRight":"Hm...? From Kagome."},{"nameNarration":"Kagome","narration":"It's an emergency...!@Aru-chan is missing again...","narrationBg":"bg_adv_21151.jpg","narrationEffect":"in","narrationHAlignment":"left","narrationPosX":180.0},{"chara":[{"id":300301}],"nameRight":"Hinano","narrationEffect":"out","textRight":"Eh..."},{"chara":[{"id":300301,"motion":400}],"nameRight":"Hinano","textBg":"shout","textRight":"[chara:300301:effect_emotion_surprise_0][se:7226_shock]T-THE HELL DID YOU SAY!?"},{"bgm":"bgm05_event08","chara":[{"id":300601,"motion":400}],"nameLeft":"Emiri","textLeft":"Back to the consultation office!"},{"autoTurnLast":1.0,"bg":"bg_adv_13111.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300301,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001,"motion":2,"pos":0}],"turnChangeIn":"fadeIn"},{"chara":[{"id":300301,"motion":400}],"nameRight":"Hinano","textRight":"Kagomeee!!","turnChangeOut":"fadeOut"},{"chara":[{"id":102001,"motion":401}],"nameLeft":"Kagome","textLeft":"Guys...!"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300301,"motion":200}],"nameRight":"Hinano","textRight":"What the hell happened while we were out!?"},{"chara":[{"cheek":0,"face":"mtn_ex_140.exp3.json","id":102001,"motion":201}],"nameLeft":"Kagome","textLeft":"I wanted to see the information on the leaf,"},{"chara":[{"id":102001}],"nameLeft":"Kagome","textLeft":"so I gave Aru-chan just a little bit of my magic..."},{"chara":[{"id":102001}],"nameLeft":"Kagome","textLeft":"But then she started getting more violent than@I thought she would,"},{"chara":[{"id":102001}],"nameLeft":"Kagome","textLeft":"broke free from the string she was tied up in,@and rushed out of the consultation office..."},{"chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":2}],"nameLeft":"Kagome","textLeft":"Ah—of course I chased after her right away!"},{"chara":[{"cheek":0,"face":"mtn_ex_140.exp3.json","id":102001}],"nameLeft":"Kagome","textLeft":"It's just..."},{"chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001,"motion":301}],"nameLeft":"Kagome","textLeft":"Uu...it's my fault...@I'm really so sorry..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300901,"motion":100,"pos":2}],"nameRight":"Manaka","textRight":"So in the end she still hasn't come back@to her senses, then."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300201,"motion":0,"pos":0}],"nameLeft":"Natsuki","textLeft":"What in the world is she going to do next?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300301,"motion":300,"pos":2}],"nameRight":"Hinano","textRight":"Wish we'd had some kind of hint to her behavior..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300601,"motion":300,"pos":0}],"nameLeft":"Emiri","textLeft":"Hint, hint...ummm..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300301,"motion":0}],"nameRight":"Hinano","textRight":"What's wrong, Emiri?"},{"chara":[{"id":300601}],"nameLeft":"Emiri","textLeft":"I'm all kindsa stuck..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300601,"motion":400}],"nameLeft":"Emiri","textBg":"shout","textLeft":"AHH!!"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300301,"motion":400}],"nameRight":"Hinano","textRight":"[chara:300301:effect_emotion_surprise_0][se:7226_shock]You scared me!! Don't raise your voice like that@so suddenly!"},{"chara":[{"id":300601}],"nameLeft":"Emiri","textLeft":"All our crew gathered here—"},{"chara":[{"id":300601}],"nameLeft":"Emiri","textLeft":"This is the same crew who joined to rescue@Kagomecchi yesterday, isn't it...!?"},{"chara":[{"id":300301,"lipSynch":0,"motion":0}],"nameRight":"Hinano","textRight":"...!!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300601},{"effect":"fadeout","id":300301}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300901,"motion":400,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300201,"motion":0,"pos":0}],"nameRight":"Manaka","textRight":"Now that you mention it..."},{"chara":[{"id":300201,"motion":400}],"nameLeft":"Natsuki","textLeft":"It really is!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300901},{"effect":"fadeout","id":300201}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300601,"motion":200,"pos":0},{"cheek":0,"face":"mtn_ex_100.exp3.json","id":102001,"motion":2,"pos":2}],"nameLeft":"Emiri","textLeft":"Then if Aru-chan's going around to all the@same peeps from yesterday,"},{"chara":[{"id":300601}],"nameLeft":"Emiri","textLeft":"Up next would be..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102001,"motion":401}],"nameRight":"Kagome","textRight":"...Tatsuki-san's place...!?"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300301,"motion":100,"pos":2}],"nameRight":"Hinano","textRight":"Correct, attacking blindly..."},{"chara":[{"id":300301}],"nameRight":"Hinano","textRight":"...and accidentally gathering up the same lineup@of targets would be borderline impossible,"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":300301}],"nameRight":"Hinano","textRight":"so that doesn't sound improbable."},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":300601,"motion":100}],"nameLeft":"Emiri","textLeft":"[chara:300601:effect_emotion_joy_0][se:7222_happy]For real, for real!?@I've got the talent to be a detective."},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":300201,"motion":100,"pos":2}],"nameRight":"Natsuki","textRight":"Emiri-san, you're amazing!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300601,"motion":200}],"nameLeft":"Emiri","textLeft":"Alrighty, to Asukyan's place—hi-yooo!!"},{"chara":[{"cheek":0,"face":"mtn_ex_110.exp3.json","id":102001,"motion":101,"pos":2}],"nameRight":"Kagome","textRight":"Right!"},{"autoTurnLast":0.2,"chara":[{"id":102001,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300301,"motion":0,"pos":2}],"nameRight":"Hinano","textRight":"...Wait, you're standing by here."},{"chara":[{"cheek":0,"face":"mtn_ex_140.exp3.json","id":102001,"motion":401}],"nameLeft":"Kagome","textLeft":"Eh—...why...!"},{"chara":[{"id":300301,"motion":200}],"nameRight":"Hinano","textRight":"In the unlikely event we get into a battle,@how would you fight?"},{"chara":[{"id":102001,"lipSynch":0}],"nameLeft":"Kagome","textLeft":"...!"},{"chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001,"motion":301}],"nameLeft":"Kagome","textLeft":"Right... I would be without Aru-chan..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300301,"motion":0}],"nameRight":"Hinano","textRight":"It's too dangerous for you to move in our@current situation."},{"chara":[{"id":300301}],"nameRight":"Hinano","textRight":"Please understand."},{"chara":[{"id":102001,"lipSynch":0,"motion":2}],"nameLeft":"Kagome","textLeft":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300301,"motion":300}],"nameRight":"Hinano","textRight":"If we find anything I'll let you know immediately."},{"chara":[{"id":300301}],"nameRight":"Hinano","textRight":"Alright, let's move."},{"autoTurnLast":0.8,"chara":[{"effect":"fadeout","id":300301}],"se":"7108_arrivals","textClear":1},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102001}],"textClear":1},{"autoTurnLast":0.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300601,"motion":200,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300901,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300201,"motion":1,"pos":2}]},{"autoTurnLast":0.8,"bgm":"stop","chara":[{"effect":"fadeout","id":300601},{"effect":"fadeout","id":300901},{"effect":"fadeout","id":300201}],"se":"7108_arrivals","textClear":1},{"bgm":"bgm03_story07","chara":[{"cheek":0,"face":"mtn_ex_140.exp3.json","id":102001,"lipSynch":0,"motion":2,"pos":1}],"nameCenter":"Kagome","textCenter":"…………"},{"chara":[{"id":102001,"motion":201}],"nameCenter":"Kagome","textCenter":"...*Sigh*..."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"Again...it happened again..."},{"chara":[{"cheek":0,"face":"mtn_ex_131.exp3.json","id":102001}],"nameCenter":"Kagome","textCenter":"Again I can't do anything on my own.@I've become a burden..."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"If I became a Magical Girl,"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"I thought I would become more useful@than I used to be..."},{"chara":[{"id":102001,"motion":301}],"nameCenter":"Kagome","textCenter":"Is waiting the only thing I can do...?"},{"chara":[{"id":102001,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"…………"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"...I hate this..."},{"chara":[{"id":102001,"motion":401}],"nameCenter":"Kagome","textCenter":"I want to be helpful to everyone too...!"},{"autoTurnLast":1.0,"flashEffect":"flashWhite1","textClear":1},{"autoTurnLast":0.2,"chara":[{"id":102001,"pos":0}],"item":[{"path":"resource/scenario/img/part2_chapter12/103303_leaf.png","posX":150,"posY":50,"visible":"appear"}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":2}],"nameLeft":"Kagome","textLeft":"Eh—...?"},{"chara":[{"id":102001}],"nameLeft":"Kagome","textLeft":"Aru-chan's leaf from earlier..."},{"autoTurnLast":1.0,"flashEffect":"flashWhite2","textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_160.exp3.json","id":102001,"motion":401}],"nameLeft":"Kagome","textLeft":"Kya—...!?"},{"autoTurnLast":2.0,"turnChangeIn":"whiteIn"}]},"version":3}
