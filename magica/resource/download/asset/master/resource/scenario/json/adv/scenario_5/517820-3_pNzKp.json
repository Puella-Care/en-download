{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_12101.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":101301,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"id":101301}],"nameCenter":"Asuka","textCenter":"And that brings today's training to a close.","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":101301,"motion":100}],"nameCenter":"Asuka","textCenter":"...Mm...?@I've been getting a lot of messages."},{"chara":[{"id":101301}],"nameCenter":"Asuka","textCenter":"What is all this...@A wild Aru-chan is missing..."},{"chara":[{"id":101301}],"nameCenter":"Asuka","textCenter":"Hit-and-run attacks on Magical Girls,@possibly being manipulated by a Witch..."},{"chara":[{"id":101301,"motion":400}],"nameCenter":"Asuka","textCenter":"[chara:101301:effect_emotion_surprise_0][se:7226_shock]Ehh!? Such a horrible thing is going on...!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":101301}],"nameCenter":"Asuka","textCenter":"Despite being in the middle of training, to be@unaware of something this great..."},{"chara":[{"id":101301}],"nameCenter":"Asuka","textCenter":"This is the biggest failure of failures...!"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":101301,"motion":200}],"nameCenter":"Asuka","textCenter":"Henceforth I must make up for lost ground...!"},{"autoTurnLast":0.2,"chara":[{"id":101301,"pos":0}],"textClear":1},{"autoTurnLast":2.0,"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":820400,"motion":0,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":101301,"motion":400}],"nameLeft":"Asuka","textLeft":"[chara:101301:effect_emotion_surprise_0][se:7226_shock]Kyaaa!?"},{"bgm":"bgm03_story16","chara":[{"id":101301,"motion":0}],"nameLeft":"Asuka","textLeft":"Wait... You are Aru-chan!?"},{"chara":[{"id":101301}],"nameLeft":"Asuka","textLeft":"Why here!?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":820400,"motion":100}],"nameRight":"Aru-chan","textRight":"＜××××＞"},{"nameNarration":"","narration":"*Wave wave...*","narrationBg":"","narrationEffect":"in"},{"chara":[{"id":101301,"motion":1}],"nameLeft":"Asuka","narrationEffect":"out","textLeft":"Beckoning...?@Are you asking me to follow?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":101301,"motion":300}],"nameLeft":"Asuka","textLeft":"No, if you're being manipulated by a Witch,@this could very well be a trap..."},{"chara":[{"id":820400,"motion":300}],"nameRight":"Aru-chan","textRight":"＜××××＞"},{"autoTurnLast":0.2,"chara":[{"effect":"slideOutRightFast","id":820400}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":101301,"motion":100}],"nameLeft":"Asuka","textLeft":"Ah—...please wait!"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":101301,"lipSynch":0}],"nameLeft":"Asuka","textLeft":"…………"},{"chara":[{"id":101301,"motion":200}],"nameLeft":"Asuka","textLeft":"...Now is not the time to be hesitating!"},{"autoTurnLast":0.01,"bg":"bg_adv_21441.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":820400,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":101301,"motion":0,"pos":0}],"turnChangeIn":"rollInFast"},{"chara":[{"id":820400,"motion":100}],"nameRight":"Aru-chan","textRight":"＜××××！＞","turnChangeOut":"rollOutFast"},{"chara":[{"id":101301}],"nameLeft":"Asuka","textLeft":"My living room...?@Is something wrong with it?"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":820400,"motion":200}],"nameRight":"Aru-chan","textRight":"＜××××！＞"},{"nameNarration":"","narration":"*Point!*@*Point!*@*Poiiint!*","narrationBg":"bg_adv_21441.jpg","narrationEffect":"in"},{"chara":[{"id":101301}],"nameLeft":"Asuka","narrationEffect":"out","textLeft":"Are you curious about the armor on display?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":101301,"motion":300}],"nameLeft":"Asuka","textLeft":"Umm..."},{"chara":[{"id":101301}],"nameLeft":"Asuka","textLeft":"I'm terribly sorry, but I cannot offer it to you."},{"chara":[{"id":820400,"motion":400}],"nameRight":"Aru-chan","textRight":"＜×××！@×××××！＞"},{"nameNarration":"","narration":"*Point!*@*Point!*@*Poiiint!*","narrationBg":"bg_adv_21441.jpg","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":101301,"motion":100}],"nameLeft":"Asuka","narrationEffect":"out","textLeft":"On closer inspection, you're pointing at this oni@samurai helmet, that bundle of swords, and the@living room, in that order...?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":820400,"motion":100}],"nameRight":"Aru-chan","textRight":"＜××××！＞"},{"chara":[{"id":101301}],"nameLeft":"Asuka","textLeft":"Oni samurai helmet, bundle of swords, living room...@Oni helmet, bundle, living room..."},{"chara":[{"id":820400,"motion":300}],"nameRight":"Aru-chan","textRight":"＜××××！＞"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":101301,"motion":200}],"nameLeft":"Asuka","textLeft":"I still don't understand!"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":820400,"motion":200}],"nameRight":"Aru-chan","textRight":"＜××ーー！＞"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":101301,"motion":0}],"nameLeft":"Asuka","textLeft":"The time to think hard on this will come later!"},{"chara":[{"id":101301}],"nameLeft":"Asuka","textLeft":"I'll seize you while you're still tame!"},{"chara":[{"id":101301,"motion":400}],"nameLeft":"Asuka","textLeft":"Toryaaa!!"},{"chara":[{"id":820400,"motion":400}],"nameRight":"Aru-chan","textRight":"＜…!!＞"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":101301},{"effect":"fadeout","id":820400}],"textClear":1},{"bgEffect":"shakeLarge","nameNarration":"","narration":"*Crash!*@*Clang!*","narrationBg":"","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":101301,"motion":100,"pos":1}],"nameCenter":"Asuka","narrationEffect":"out","textCenter":"I have you! Accept your fate..."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":101301,"motion":400}],"nam