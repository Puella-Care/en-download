{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_46105.jpg","chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":2,"pos":2},{"effect":"7000_attack01","id":6105,"name":"sprite_0","pos":0}],"turnChangeIn":"fadeIn"},{"nameCenter":"Hinano's Voice","textBg":"shout","textCenter":"LOOKS LIKE WE'RE JUST IN TIME!","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102001},{"effect":"fadeout","id":6105,"name":"sprite_0"}],"textClear":1},{"autoTurnLast":2.0,"bgm":"bgm24_story01","chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300300,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300600,"motion":200,"pos":2}]},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300300},{"effect":"fadeout","id":300600}],"textClear":1},{"autoTurnLast":2.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300900,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300200,"motion":1,"pos":1},{"cheek":0,"face":"mtn_ex_020.exp3.json","id":101300,"motion":200,"pos":2}]},{"autoTurnLast":0.3,"chara":[{"effect":"fadeout","id":300900},{"effect":"fadeout","id":300200},{"effect":"fadeout","id":101300}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":401,"pos":1}],"nameCenter":"Kagome","textCenter":"Every...one...!?"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"How are you here..."},{"autoTurnLast":0.2,"chara":[{"id":102001,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300300,"motion":100,"pos":2}],"nameRight":"Hinano","textRight":"We finally understand what Aru-chan was doing@this whole time."},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300300}],"nameRight":"Hinano","textRight":"This Witch is the main body of the offshoot@we defeated yesterday."},{"chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":201}],"nameLeft":"Kagome","textLeft":"Eh—...!?"},{"chara":[{"id":300300,"motion":0},{"id":102001,"motion":2}],"nameRight":"Hinano","textRight":"So she wouldn't be caught by any Magical Girls,"},{"chara":[{"id":300300}],"nameRight":"Hinano","textRight":"she sent her Familiars out to interfere with our@magic detection and conceal her location."},{"chara":[{"id":300300}],"nameRight":"Hinano","textRight":"She intentionally disguised the Familiars@with our own reactions."},{"chara":[{"id":300300,"motion":200}],"nameRight":"Hinano","textRight":"So Aru-chan followed those reactions,"},{"chara":[{"id":300300}],"nameRight":"Hinano","textRight":"explaining why she came to us."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300300},{"effect":"fadeout","id":102001}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300900,"motion":100,"pos":2},{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300200,"motion":1,"pos":0}],"nameRight":"Manaka","textRight":"By the way, all those pesky Familiars in the way—"},{"chara":[{"id":300900}],"nameRight":"Manaka","textRight":"With the help from a bunch of Magical Girls,@they've all been taken down!"},{"chara":[{"id":300200,"motion":100}],"nameLeft":"Natsuki","textLeft":"And with the interference gone, we were able@to pin down the Witch's hiding place."},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300900},{"effect":"fadeout","id":300200}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300300,"motion":100,"pos":0},{"cheek":0,"face":"mtn_ex_020.exp3.json","id":101300,"motion":0,"pos":2}],"nameLeft":"Hinano","textLeft":"And as we now see, the main body was sneakily@making a getaway."},{"chara":[{"id":101300,"motion":100}],"nameRight":"Asuka","textRight":"Aru-chan informed us of all of these things...!"},{"chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001,"motion":2,"pos":0}],"nameLeft":"Kagome","textLeft":"I see..."},{"chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001,"motion":301,"pos":0}],"nameLeft":"Kagome","textLeft":"This whole time Aru-chan persevered with all@her strength to get us here..."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300600,"motion":200,"pos":2}],"nameRight":"Emiri","textRight":"But Aru-chan stopped moving again@all of a sudden..."},{"bgm":"stop","nameCenter":"Aru-chan's Voice","textCenter":"＜…………＞"},{"chara":[{"cheek":0,"face":"mtn_ex_131.exp3.json","id":102001,"motion":401}],"nameLeft":"Kagome","textLeft":"Aru-chan...!"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300600}],"textClear":1},{"autoTurnLast":0.2,"chara":[{"id":102001,"pos":1}],"textClear":1},{"bgm":"bgm03_story07","chara":[{"id":102001,"lipSynch":0,"motion":301}],"nameCenter":"Kagome","textCenter":"(To work yourself into tatters...@All for me...)"},{"chara":[{"id":102001,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"(Despite all of your failures, you never gave in...)"},{"chara":[{"id":102001,"motion":201}],"nameCenter":"Kagome","textCenter":"(And yet I...)"},{"chara":[{"id":102001,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"(I let a single failure drive me downwards...)"},{"chara":[{"eyeClose":1,"id":102001,"lipSynch":0}],"nameCenter":"Kagome","textCenter":"(I'm really so pathetic...)"},{"chara":[{"cheek":1,"eyeClose":0,"id":102001,"motion":101}],"nameCenter":"Kagome","textCenter":"Sorry...I'm so sorry, Aru-chan...!"},{"nameRight":"Aru-chan's Voice","textRight":"<Kaxxme...xxxxre...then...@Definitely...okay...>"},{"chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":401}],"nameCenter":"Kagome","textCenter":"...Eh!? That was Aru-chan's words just now..."},{"autoTurnLast":0.8,"flashEffect":"flashWhite2","textClear":1},{"chara":[{"id":102001,"lipSynch":0,"motion":2}],"nameCenter":"Kagome","textCenter":"...!?"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"What...is this...?@Something is flowing into my head...!"},{"autoTurnLast":0.8,"flashEffect":"flashWhite2","textClear":1},{"autoTurnLast":0.8,"flashEffect":"flashWhiteSlow1"},{"armatureList":[{"animation":["action"],"armatureId":1,"filePath":"resource/image_native/effect/story/general/3003_act_picture.ExportJson","zOrder":"messageBack"}],"autoTurnLast":1.0,"bg":"bg_adv_11041.jpg","chara":[{"cheek":0,"face":"mtn_ex_340.exp3.json","id":102001,"motion":0,"pos":1}],"turnChangeIn":"whiteIn","turnEffect":"blackFrame"},{"chara":[{"dollLipSynch":1.0,"id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"＜…………＞","turnChangeOut":"whiteOut"},{"autoTurnLast":0.5,"chara":[{"cheek":0,"effect":"ef_adv_01","face":"mtn_ex_540.exp3.json","id":102001}],"se":"7201_detect_magic"},{"nameNarration":"Split Aru-chan","narration":"<me...?@Can you hear me...?>","narrationBg":"","narrationEffect":"in","narrationHAlignment":"left","narrationPosX":400.0},{"nameNarration":"Aru-chan","narration":"<Yeah, I hear you!@Any developments?>","narrationHAlignment":"left","narrationPosX":100.0},{"nameNarration":"Split Aru-chan","narration":"<That Witch seems to have disguised@her offshoot as the main body and@got away scot-free.>","narrationHAlignment":"left","narrationPosX":300.0},{"nameNarration":"Aru-chan","narration":"<I knew it...@My hunch was right on.>","narrationHAlignment":"left","narrationPosX":100.0},{"nameNarration":"Split Aru-chan","narration":"<That's not all.>","narrationHAlignment":"left","narrationPosX":400.0},{"narration":"<She's using the reactions of@the Magical Girls who defeated the@offshoot to hide where she is.>"},{"narration":"<It was a good call to have@the split me pursue her!>"},{"nameNarration":"Aru-chan","narration":"<Looks like taking@precautionary measures paid off.>","narrationHAlignment":"left","narrationPosX":100.0},{"narration":"<The Witch seems to be going@to great lengths to deceive us@with cheap party tricks,>"},{"narration":"<but as long as we know@how it works, she's ours!>"},{"narration":"<Please continue to@keep tabs on her, okay!>"},{"nameNarration":"Split Aru-chan","narration":"<Of course!@Piece of cake...>","narrationHAlignment":"left","narrationPosX":400.0},{"nameNarration":"","narration":"*Bam Bam Bam!!*","narrationHAlignment":"center","narrationPosX":0.0},{"nameNarration":"Split Aru-chan","narration":"<Waah—!?>","narrationHAlignment":"left","narrationPosX":500.0},{"nameNarration":"Aru-chan","narration":"<What's wrong!?@Answer me!!>","narrationHAlignment":"left","narrationPosX":100.0},{"chara":[{"id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","narrationEffect":"out","textCenter":"＜…………＞"},{"chara":[{"cheek":0,"face":"mtn_ex_540.exp3.json","id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"(Oh no, did the Witch find out@she's being spied on...?)"},{"chara":[{"id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"(If so...)"},{"chara":[{"id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"(It may not be long before she comes after us@for interfering...)"},{"chara":[{"cheek":0,"face":"mtn_ex_240.exp3.json","id":102001,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"(One way or another, I need to inform@Kagome-chan about this!)"},{"chara":[{"cheek":0,"face":"mtn_ex_240.exp3.json","id":102001,"lipSynch":0,"motion":200}],"nameCenter":"Aru-chan","textCenter":"＜…!!＞"},{"autoTurnLast":0.2,"chara":[{"id":102001,"pos":0}],"textClear":1},{"chara":[{"id":102001,"motion":401},{"cheek":0,"face":"mtn_ex_020.exp3.json","id":820400,"motion":400,"pos":2}],"nameLeft":"Kagome","textLeft":"Kya—!!@W-what's wrong...?"},{"autoTurnLast":0.01,"bg":"black","turnChangeIn":"fadeIn","turnEffect":"stop"},{"nameNarration":"Aru-chan","narration":"I don't care if I'm not cool...@I don't care how many mistakes I make...@I don't care if I need help from others...","narrationBg":"black","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"I...will protect Kagome-chan@to the very end...!"},{"autoTurnLast":1.0,"bg":"bg_adv_46105.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":2,"pos":1}],"deleteArmatureList":[1],"narrationEffect":"out","turnChangeIn":"whiteIn"},{"bgm":"bgm24_story02","chara":[{"id":102001,"lipSynch":0,"motion":401}],"nameCenter":"Kagome","textCenter":"...!!","turnChangeOut":"whiteOut"},{"chara":[{"cheek":0,"face":"mtn_ex_100.exp3.json","id":102001}],"nameCenter":"Kagome","textCenter":"That's right... I only made one mistake..."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"I've been dwelling over not beating the Witch@the first time..."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"...that I've completely lost sight@of what is most important."},{"chara":[{"id":102001,"motion":201}],"nameCenter":"Kagome","textCenter":"It's not all about not making mistakes..."},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"It's about learning from failure and applying it@to the future."},{"chara":[{"id":102001,"lipSynch":0,"motion":2}],"nameCenter":"Kagome","textCenter":"…………"},{"chara":[{"id":102001}],"nameCenter":"Kagome","textCenter":"It's thanks to Aru-chan that I've finally realized..."},{"chara":[{"id":102001,"motion":101}],"nameCenter":"Kagome","textCenter":"I won't stand idly any more."},{"chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001}],"nameCenter":"Kagome","textCenter":"So... Open your eyes, Aru-chan!!"},{"autoTurnLast":0.8,"flashEffect":"flashWhiteSlow1","textClear":1},{"autoTurnLast":1.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":820400,"motion":400,"pos":2},{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":2,"pos":0}],"turnChangeIn":"whiteIn"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":820400,"motion":400,"pos":2}],"nameRight":"Aru-chan","textRight":"<Sorry for the wait, Kagome-chan!>","turnChangeOut":"whiteOut"},{"chara":[{"cheek":0,"face":"mtn_ex_110.exp3.json","id":102001,"motion":401}],"nameLeft":"Kagome","textLeft":"Aru-chan...!"},{"chara":[{"id":102001}],"nameLeft":"Kagome","textLeft":"I...can understand what you're saying...!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":820400,"motion":300}],"nameRight":"Aru-chan","textRight":"<It seems that the shock of not being able to beat@the Witch the first time...>"},{"chara":[{"id":820400}],"nameRight":"Aru-chan","textRight":"<...made you subconsciously suppress@your power.>"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":820400,"motion":100}],"nameRight":"Aru-chan","textRight":"<But you're all better now!>"},{"chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001,"motion":301}],"nameLeft":"Kagome","textLeft":"I'm sorry, Aru-chan.@If only I had realized sooner..."},{"chara":[{"id":820400,"motion":400}],"nameRight":"Aru-chan","textRight":"<No, don't worry about it!>"},{"chara":[{"id":820400}],"nameRight":"Aru-chan","textRight":"<This was necessary for your growth.>"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":820400}],"nameRight":"Aru-chan","textRight":"<So...!>"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102001},{"effect":"fadeout","id":820400}],"textClear":1},{"autoTurnLast":0.5,"chara":[{"cheek":0,"face":"mtn_ex_100.exp3.json","id":102001,"motion":1,"pos":1}],"textClear":1},{"autoTurnLast":1.5,"chara":[{"cheek":0,"effect":"ef_adv_05","face":"mtn_ex_200.exp3.json","id":102000,"motion":0,"pos":1}],"se":"7205_magic_girl"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<Let's show this Witch just how much@we've grown!>"},{"chara":[{"id":102000,"motion":100}],"nameCenter":"Kagome","textCenter":"...Yeah!!"},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
