"Sorry...Kagome..."},{"chara":[{"cheek":0,"face":"mtn_ex_330.exp3.json","id":102000,"lipSynch":0,"motion":0}],"nameCenter":"Kagome","textCenter":"……!"},{"chara":[{"cheek":0,"face":"mtn_ex_220.exp3.json","id":102000}],"nameCenter":"Kagome","textCenter":"How dare you hurt them...!@Leave the rest to me!"},{"chara":[{"id":102000,"motion":200}],"nameCenter":"Kagome","textCenter":"Aru-chan, please!"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<Of course!>"},{"autoTurnLast":0.2,"chara":[{"id":102000,"pos":2}],"textClear":1},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0},{"id":6105,"name":"sprite_0","pos":0}],"nameRight":"Aru-chan","textRight":"[surround:1020A01][name:sprite_0:effect_7000_attack01]<Yaaa!>"},{"autoTurnLast":0.5,"bgEffect":"shakeSmall","chara":[{"id":0},{"effect":"7002_damage01","id":6105,"name":"sprite_0"}],"surround":"1020A02","textClear":1},{"nameLeft":"","textLeft":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_530.exp3.json","id":102000,"motion":400}],"nameRight":"Kagome","textRight":"Nothing works still!?"},{"chara":[{"id":102000}],"nameRight":"Kagome","textRight":"This is exactly like yesterday..."},{"chara":[{"id":102000}],"nameRight":"Kagome","textRight":"Just attacking normally won't do any damage."},{"chara":[{"cheek":0,"face":"mtn_ex_531.exp3.json","id":102000,"motion":300}],"nameRight":"Kagome","textRight":"What are we supposed to do...!?"},{"chara":[{"cheek":0,"dollLipSynch":1.0,"face":"mtn_ex_231.exp3.json","id":102000,"lipSynch":0,"motion":200}],"nameRight":"Aru-chan","textRight":"<Calm down, Kagome-chan!@There's always a way.>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameRight":"Aru-chan","textRight":"<We've been in a pinch many times before@and gotten through them all!>"},{"chara":[{"cheek":0,"face":"mtn_ex_200.exp3.json","id":102000,"lipSynch":0,"motion":0}],"nameRight":"Kagome","textRight":"…………"},{"chara":[{"id":102000}],"nameRight":"Kagome","textRight":"That's right...you're right...!"},{"chara":[{"id":102000,"motion":100}],"nameRight":"Kagome","textRight":"There must be some kind of hint from everything@so far..."},{"autoTurnLast":1.0,"bg":"bg_adv_21423.jpg","chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102001,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300601,"motion":100,"pos":2}],"turnChangeIn":"fadeIn","turnEffect":"blackFrame"},{"chara":[{"cheek":0,"face":"mtn_ex_130.exp3.json","id":102001}],"nameLeft":"Kagome","textLeft":"A-are you all okay...?","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":101301,"motion":100,"pos":2}],"nameRight":"Asuka","textRight":"Yes!"},{"chara":[{"id":101301}],"nameRight":"Asuka","textRight":"With this many people it was like a tea party!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300201,"motion":100,"pos":2}],"nameRight":"Natsuki","textRight":"When we hit her in unison it was over just like that."},{"autoTurnLast":1.0,"bg":"bg_adv_46105.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_100.exp3.json","id":102000,"motion":0,"pos":1}],"turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"id":102000}],"nameCenter":"Kagome","textCenter":"Everyone in unison...","turnChangeOut":"fadeOut"},{"bgm":"bgm24_story02","chara":[{"cheek":0,"face":"mtn_ex_150.exp3.json","id":102000,"lipSynch":0,"motion":400}],"nameCenter":"Kagome","textCenter":"...!!"},{"chara":[{"id":102000}],"nameCenter":"Kagome","textCenter":"...Could it be—@is this it!?"},{"chara":[{"cheek":0,"face":"mtn_ex_100.exp3.json","id":102000}],"nameCenter":"Kagome","textCenter":"Don't attack alone, but with everyone together."},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0,"motion":200}],"nameCenter":"Aru-chan","textCenter":"<I get it!>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<Tatsuki-san and the girls mentioned something@like that!>"},{"chara":[{"cheek":0,"face":"mtn_ex_140.exp3.json","id":102000,"motion":300}],"nameCenter":"Kagome","textCenter":"But what do we do...@I'm the only one who can fight now..."},{"chara":[{"cheek":0,"dollLipSynch":1.0,"face":"mtn_ex_150.exp3.json","id":102000,"lipSynch":0,"motion":0}],"nameCenter":"Aru-chan","textCenter":"<It's alright!>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<That's not a problem at all!>"},{"chara":[{"dollLipSynch":1.0,"id":102000,"lipSynch":0}],"nameCenter":"Aru-chan","textCenter":"<You've got \"us\", don't you?>"},{"chara":[{"cheek":0,"face":"mtn_ex_110.exp3.json","id":102000,"motion":100}],"nameCenter":"Kagome","textCenter":"I see...!"},{"chara":[{"id":102000}],"nameCenter":"Kagome","textCenter":"If you split up, you can do the same thing@Tatsuki-san's team did."},{"chara":[{"cheek":0,"face":"mtn_ex_120.exp3.json","id":102000,"motion":200}],"nameCenter":"Kagome","textCenter":"Then all we can do is try!"},{"chara":[{"id":102000}],"nameCenter":"Kagome","textCenter":"Aru-chan—full power, please!"},{"chara":[{"cheek":0,"dollLipSynch":1.0,"face":"mtn_ex_220.exp3.json","id":102000,"lipSynch":0,"motion":400}],"nameCenter":"Aru-chan","textCenter":"<Leave it to me!>"},{"autoTurnLast":0.01,"bg":"black","item":[{"path":"resource/scenario/img/51178_tower_kagome/memoria_1831.jpg","posX":0,"posY":0,"visible":"appear"}],"turnChangeIn":"fadeIn"},{"nameNarration":"Kagome","narration":"ーKagomeー@Go, Aru-chan!!","narrationAnchor":"bottom","narrationCoverOpacity":110.0,"narrationEffect":"in","narrationFontSize":30.0,"narrationLineMargin":35.0,"narrationLineSpace":20.0,"turnChangeOut":"fadeOut"},{"nameNarration":"Aru-chan","narration":"ーAru-chanー@<We'll split up@and attack all at once!>"},{"narration":"ーAru-chanー@<Torya torya toryaaa!!>"},{"autoTurnLast":2.0,"turnChangeIn":"fadeIn"}]},"version":3}
