{"story":{"group_1":[{"autoTurnLast":0.2,"bg":"white","bgm":"stop","nameNarration":"","narrationBg":"bg_adv_20641.jpg","narrationEffect":"in","turnChangeIn":"fadeIn"},{"narration":"<Little Vacation, Kosho Junk City>","turnChangeOut":"fadeOut"},{"armatureList":[{"animation":["action"],"armatureId":1,"filePath":"resource/image_native/effect/story/general/3501_vr_frame.ExportJson","zOrder":"messageBack"},{"animation":["action"],"armatureId":2,"filePath":"resource/image_native/effect/story/general/3000_snow_messageback.ExportJson","zOrder":"messageBack"},{"animation":["action"],"armatureId":3,"filePath":"resource/image_native/effect/story/general/6000_snow_bgfront.ExportJson","zOrder":"bgFront"}],"autoTurnLast":0.2,"bg":"bg_adv_16141.jpg","turnChangeIn":"fadeIn"},{"autoTurnLast":4.2,"bgm":"bgm01_anime02","narrationEffect":"out","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"bg":"bg_adv_21075.jpg","chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102900,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":103000,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"autoTurnLast":0.1,"deleteArmatureList":[2]},{"autoTurnLast":0.1,"deleteArmatureList":[3]},{"chara":[{"id":103000,"motion":1}],"nameRight":"Hagumu","textRight":"It's...starting to snow all over town.","turnChangeOut":"fadeOut"},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"Mm..."},{"chara":[{"id":102900,"motion":100}],"nameLeft":"Shigure","textLeft":"We need to...fix the magic dome that covers@the city."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103000,"motion":400}],"nameRight":"Hagumu","textRight":"Eh...? But how?"},{"chara":[{"id":102900,"motion":0}],"nameLeft":"Shigure","textLeft":"I'll get the security bots,"},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"and have them go patch it up."},{"autoTurnLast":0.2,"bg":"bg_adv_14071.jpg","chara":[{"id":7005,"name":"sprite_0","pos":0},{"id":7005,"name":"sprite_1","pos":2}],"turnChangeIn":"fadeIn","turnEffect":"blackFrame"},{"autoTurnLast":2.3,"turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"bg":"bg_adv_21075.jpg","chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102900,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103000,"motion":0,"pos":2}],"turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"id":103000,"motion":200}],"nameRight":"Hagumu","textRight":"You can do that?!","turnChangeOut":"fadeOut"},{"chara":[{"id":102900,"motion":1},{"id":103000,"motion":0}],"nameLeft":"Shigure","textLeft":"Uh-huh..."},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"I just recently realized I could hijack that part@of the system."},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"...I had all the necessary data, so I should've@been able to do it sooner,"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102900,"motion":300}],"nameLeft":"Shigure","textLeft":"but I never really thought about it until now..."},{"chara":[{"cheek":0,"face":"mtn_ex_041.exp3.json","id":103000,"motion":300}],"nameRight":"Hagumu","textRight":"You've been preoccupied thinking about..."},{"chara":[{"id":103000}],"nameRight":"Hagumu","textRight":"...the angels' world beyond the Wishing Star,@haven't you?"},{"autoTurnLast":0.2,"bg":"bg_adv_24013.jpg","turnChangeIn":"fadeIn","turnEffect":"blackFrame"},{"autoTurnLast":2.3,"turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"bg":"bg_adv_21075.jpg","chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102900,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103000,"motion":0,"pos":2}],"turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"id":103000}],"nameRight":"Hagumu","textRight":"Ah...","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103000,"motion":100}],"nameRight":"Hagumu","textRight":"...It's not snowing outside anymore."},{"autoTurnLast":2.0,"bg":"bg_adv_16141.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102900,"lipSynch":0,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story07","chara":[{"id":102900,"lipSynch":0}],"nameCenter":"Shigure","textCenter":"...","turnChangeOut":"fadeOut"},{"autoTurnLast":0.25,"chara":[{"id":102900,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103000,"motion":0,"pos":2}],"nameRight":"Hagumu","textRight":"...Were you looking at the sky again?"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102900,"motion":300}],"nameLeft":"Shigure","textLeft":"...Mm-hm..."},{"chara":[{"eyeClose":1,"id":102900,"lipSynch":0}],"nameLeft":"Shigure","textLeft":"..."},{"chara":[{"id":103000,"motion":1}],"nameRight":"Hagumu","textRight":"...Hey, do you want to go there, too?"},{"chara":[{"id":103000}],"nameRight":"Hagumu","textRight":"To the angels' world, I mean..."},{"autoTurnLast":0.2,"chara":[{"eyeClose":0,"id":102900}]},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":102900,"lipSynch":0,"motion":0}],"nameLeft":"Shigure","textLeft":"..."},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102900,"motion":200},{"id":103000,"motion":0}],"nameLeft":"Shigure","textLeft":"...No."},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"Sure, we've always been aiming to go beyond@the edge of this world."},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"Crossing the boundary, making our voices@heard... We even sent out two Santas."},{"chara":[{"id":102900,"motion":0}],"nameLeft":"Shigure","textLeft":"...But I think I just wanted..."},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"to know more about the world of angels where@the Three Magi live."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103000,"motion":100}],"nameRight":"Hagumu","textRight":"What kinds of things were you curious about?"},{"chara":[{"id":103000,"motion":0}],"nameRight":"Hagumu","textRight":"Stuff like...what the angels look like, or@what kind of town they live in? "},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":102900,"motion":1}],"nameLeft":"Shigure","textLeft":"...Not really."},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102900}],"nameLeft":"Shigure","textLeft":"I wanted to know if the Three Magi who created@our world..."},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":102900,"lipSynch":0,"motion":400}],"nameLeft":"Shigure","textLeft":"(Ah...)"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103000,"motion":200}],"nameRight":"Hagumu","textRight":"What is it?"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102900,"motion":100}],"nameLeft":"Shigure","textLeft":"I get it now...@I wanted answers from our creators."},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"Why did they make this place?@Why did they make us?"},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"Why did they toss us aside and leave?"},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"I've been staring up at the sky, trying to find@the answers."},{"chara":[{"id":103000,"motion":300}],"nameRight":"Hagumu","textRight":"...Me too."},{"chara":[{"id":102900,"motion":0}],"nameLeft":"Shigure","textLeft":"That's what we all wanted when we sent out@our voices to the Three Magi..."},{"chara":[{"eyeClose":1,"id":102900,"motion":300}],"nameLeft":"Shigure","textLeft":"...But we never heard anything back."},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":103000,"motion":1,"pos":2}],"nameRight":"Hagumu","textRight":"Shigure..."},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102900}],"nameLeft":"Shigure","textLeft":"But I don't mind."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102900,"motion":200}],"nameLeft":"Shigure","textLeft":"I've finally figured out what I wanna do next."},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103000,"motion":0}],"nameRight":"Hagumu","textRight":"Eh...?"},{"chara":[{"id":102900,"motion":1}],"nameLeft":"Shigure","textLeft":"I want to make this world our own."},{"chara":[{"id":102900}],"nameLeft":"Shigure","textLeft":"I want to make it a better place to live."},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102900}],"nameLeft":"Shigure","textLeft":"...I don't wanna spend my life staring into@the sky anymore."},{"chara":[{"id":102900,"motion":100}],"nameLeft":"Shigure","textLeft":"From now on, I want us to create our very@own world...!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103000}],"nameRight":"Hagumu","textRight":"Shigure...!"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103000,"motion":100}],"nameRight":"Hagumu","textRight":"...Let me help, too."},{"autoTurnLast":0.1,"textClear":1},{"autoTurnLast":2.0,"bg":"bg_adv_24012.jpg","bgm":"stop","turnChangeIn":"fadeIn","turnChangeInTime":1.2},{"autoTurnLast":3.8,"bgm":"bgm03_story09","turnChangeOut":"fadeOut","turnChangeOutTime":1.0},{"autoTurnLast":0.2,"bg":"bg_adv_20561.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102950,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103050,"motion":0,"pos":2}],"turnChangeIn":"whiteIn","turnChangeInTime":2.0},{"chara":[{"id":103050,"mouthOpen":1}],"nameRight":"Hagumu","textRight":"Woooow...!","turnChangeOut":"whiteOut","turnChangeOutTime":1.2},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103050,"motion":400,"mouthOpen":0}],"nameRight":"Hagumu","textRight":"Shigure, you're amazing!@So this is \"summer\"...?"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102950,"motion":1},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103050,"motion":0}],"nameLeft":"Shigure","textLeft":"Mm-hm..."},{"chara":[{"id":102950}],"nameLeft":"Shigure","textLeft":"I got the bots to change the climate specifically@inside the mini-dome we built."},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102950}],"nameLeft":"Shigure","textLeft":"Since I just tried to recreate it from descriptions@I saw in library books,"},{"chara":[{"id":102950}],"nameLeft":"Shigure","textLeft":"it might not be the same as summer in the@angels' world, but..."},{"chara":[{"id":103050,"motion":1}],"nameRight":"Hagumu","textRight":"...Still, this is so cool!"},{"chara":[{"id":103050}],"nameRight":"Hagumu","textRight":"The sun is shining, and getting in the water@feels so nice!"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103050,"motion":100}],"nameRight":"Hagumu","textRight":"Let's go for a swim together, Shigure!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102950,"motion":200}],"nameLeft":"Shigure","textLeft":"O...okay...!"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":102950,"motion":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103050,"motion":0}],"nameNarration":"","narration":"*Drip*... *Drip*...","narrationBg":"bg_adv_20561.jpg","narrationEffect":"in"},{"chara":[{"id":102950}],"nameRight":"Hagumu","narrationEffect":"out","textRight":"...Huh?"},{"armatureList":[{"animation":["action"],"armatureId":2,"filePath":"resource/image_native/effect/story/general/3004_rainstorm.ExportJson","zOrder":"messageBack"}],"autoTurnLast":0.1,"nameNarration":"","narrationBg":"","narrationCoverOpacity":160.0,"narrationEffect":"in"},{"narration":"*FWOOOOOOOSH!!*","surround":"7004_rain"},{"chara":[{"id":103050,"motion":200}],"nameRight":"Hagumu","narrationEffect":"out","textRight":"A-wa-wah... What a downpour!"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102950,"motion":300}],"nameLeft":"Shigure","textLeft":"Sorry, I must've made a mistake in the weather settings. I'll go fix it..."},{"autoTurnLast":2.0,"surround":"stop","turnChangeIn":"fadeIn"},{"autoTurnLast":0.1,"deleteArmatureList":[1]},{"autoTurnLast":0.1,"deleteArmatureList":[2]}]},"version":3}
