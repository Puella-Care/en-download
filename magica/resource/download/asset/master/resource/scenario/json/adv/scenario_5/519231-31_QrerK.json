e!"},{"autoTurnLast":0.2,"bg":"black","turnChangeIn":"fadeIn"},{"armatureList":[{"animation":["action"],"armatureId":1,"filePath":"resource/image_native/effect/story/general/3003_act_picture.ExportJson","zOrder":"messageFront"}],"autoTurnLast":0.1},{"autoTurnLast":1.0,"nameNarration":"[Text message]","narrationBg":"","narrationCoverOpacity":160.0,"narrationEffect":"in"},{"autoTurnFirst":2.5,"narration":"From the Reindeer Santas,@a present of shooting stars!@Point your telescope@at the lovers of the Milky Way!","narrationHAlignment":"left","narrationPosX":120.0,"turnChangeOut":"fadeOut"},{"autoTurnFirst":0.2,"item":[{"path":"resource/scenario/img/51170_storyselect_kuroe/51170_ai_santa.png","posX":0,"posY":0,"visible":"appear","zOrder":"charaBack"}]},{"autoTurnFirst":1.25,"item":[{"action":{"sequence":[{"moveTo":{"duration":0.12,"posX":0,"posY":-20}},{"moveTo":{"duration":0.12,"posX":0,"posY":20}},{"moveTo":{"duration":0.12,"posX":0,"posY":-20}},{"moveTo":{"duration":0.12,"posX":0,"posY":20}},{"moveTo":{"duration":0.12,"posX":0,"posY":0}}]},"path":"resource/scenario/img/51170_storyselect_kuroe/51170_ai_santa.png"}]},{"item":[{"path":"resource/scenario/img/51170_storyselect_kuroe/51170_ai_santa.png","visible":"hide"}]},{"autoTurnLast":0.2,"bg":"bg_adv_21813.jpg","chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102901,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103001,"motion":0,"pos":2}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"autoTurnLast":0.1,"deleteArmatureList":[1]},{"chara":[{"id":103001,"motion":1}],"nameRight":"Hagumu","textRight":"Did you...see that just now?","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":102901,"motion":100}],"nameLeft":"Shigure","textLeft":"Uh-huh... Was that...Santa?"},{"autoTurnLast":0.25,"chara":[{"effect":"fadeout","id":102901},{"effect":"fadeout","id":103001}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102801,"motion":100,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103201,"motion":0,"pos":2}],"nameLeft":"Himena","textLeft":"\"The lovers of the Milky Way\" are Orihime and Hikoboshi, yeah?"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103201,"motion":200}],"nameRight":"Miyuri","textRight":"That's— That's right!@Let's point the telescope this way!"},{"autoTurnLast":2.0,"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":103101,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305401,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":103101,"motion":1,"pos":0}],"nameLeft":"San","textLeft":"...But who in the world sent that message...?","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305401,"motion":100,"mouthOpen":1}],"nameRight":"Mitsune","textRight":"Lol, isn't that obvious?@It's from one of the guys at the agency..."},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103201,"motion":400,"mouthOpen":1,"pos":0},{"id":305401,"mouthOpen":0}],"nameLeft":"Miyuri","textLeft":"Here they— Here they come!@Shooting stars!"},{"autoTurnLast":0.2,"bg":"bg_adv_24014.jpg","turnChangeIn":"fadeIn"},{"autoTurnLast":1.0,"turnChangeOut":"fadeOut","turnChangeOutTime":1.0},{"autoTurnLast":2.8,"flashEffect":"flashWhiteSlow2","se":"3201_heal"},{"autoTurnLast":0.2,"bg":"bg_adv_21813.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103101,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103001,"motion":0,"pos":2}],"turnChangeIn":"fadeIn","turnChangeInTime":1.3},{"chara":[{"id":103001,"motion":100}],"nameRight":"Hagumu","textRight":"Woooow... Look at how many there are...!","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103501,"motion":300,"pos":0}],"nameLeft":"Alexandra","textLeft":"And they're right between Orihime and@Hikoboshi.♪"},{"autoTurnLast":0.25,"chara":[{"effect":"fadeout","id":103001},{"effect":"fadeout","id":103501}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102801,"motion":100,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102901,"motion":0,"pos":2}],"nameLeft":"Himena","textLeft":"[chara:102801:effect_emotion_joy_0][se:7222_happy]Kyaha, it's just like a bridge across@the Milky Way!★"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102901,"motion":200}],"nameRight":"Shigure","textRight":"Did...you get a good video of it?"},{"autoTurnLast":0.25,"chara":[{"effect":"fadeout","id":102801},{"effect":"fadeout","id":102901}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103201,"motion":100,"pos":1}],"nameCenter":"Miyuri","textCenter":"Picture-perfect!"},{"chara":[{"cheek":1,"face":"mtn_ex_014.exp3.json","id":103201,"motion":200,"mouthOpen":0}],"nameCenter":"Miyuri","textCenter":"[chara:103201:effect_emotion_joy_0][se:7222_happy]Thank you so much for everything, Santa!@I really, really appreciate it!"},{"autoTurnLast":2.0,"bg":"bg_adv_14071.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":120301,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":120302,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"armatureList":[{"animation":["action"],"armatureId":1,"filePath":"resource/image_native/effect/story/general/3003_act_picture.ExportJson","zOrder":"charaFront"}],"autoTurnLast":0.1},{"bgm":"bgm05_event11","chara":[{"id":120301,"motion":101}],"nameLeft":"Tsuruno","textLeft":"Okay, smile delivery complete!@[chara:120301:cheek_0][chara:120301:face_mtn_ex_010.exp3.json]How's it going over there?","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"flashEffect":"explosion","item":[{"path":"resource/scenario/img/51119_storyselect_delivery/51119_mana_cartridge.png","posX":0,"posY":0,"visible":"appear"}],"se":"3201_heal"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":120302,"motion":100}],"nameRight":"Felicia","textRight":"Looks like we sucked up somethin' sparkly."},{"chara":[{"id":120301,"motion":100},{"id":120302,"motion":0}],"nameLeft":"Tsuruno","textLeft":"That's the shooting star those girls caught!"},{"chara":[{"id":120301}],"nameLeft":"Tsuruno","textLeft":"We get to share some of their spoils!"},{"autoTurnLast":0.2,"item":[{"path":"resource/scenario/img/51119_storyselect_delivery/51119_mana_cartridge.png","visible":"hide"}]},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":120301,"motion":201}],"nameLeft":"Tsuruno","textLeft":"Now that we've nabbed a fresh shooting star, "},{"chara":[{"id":120301}],"nameLeft":"Tsuruno","textLeft":"it's time to fulfill our promise!"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":120302,"motion":200}],"nameRight":"Felicia","textRight":"Yeeeah!"},{"autoTurnLast":1.0,"bg":"black","bgm":"stop","turnChangeIn":"fadeIn"},{"autoTurnLast":0.1,"deleteArmatureList":[1]},{"armatureList":[{"animation":["action"],"armatureId":1,"filePath":"resource/image_native/effect/story/general/1503_motorcycle_loading.ExportJson","zOrder":"messageBack"}],"autoTurnLast":1.0,"turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"bg":"bg_adv_21473.jpg","turnChangeIn":"fadeIn"},{"autoTurnLast":0.1,"deleteArmatureList":[1]},{"nameNarration":"","narration":"<Hokuyo Ward, Touka's House>","narrationBg":"bg_adv_21473.jpg","narrationEffect":"in","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":100770,"motion":1,"pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"bgm":"bgm03_story05","chara":[{"id":100770}],"nameCenter":"Touka","textCenter":"I see...","turnChangeOut":"fadeOut"},{"chara":[{"id":100770}],"nameCenter":"Touka","textCenter":"The Reindeer Santas have escaped into the sea@of the Internet."},{"chara":[{"id":100770}],"nameCenter":"Touka","textCenter":"They can't touch real shooting stars,"},{"chara":[{"id":100770,"motion":100}],"nameCenter":"Touka","textCenter":"but they CAN catch one using video data@obtained through a smartphone."},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":100770,"motion":0}],"nameNarration":"","narration":"[se:7106_telmail]*Jingle ♪*","narrationBg":"bg_adv_21473.jpg","narrationEffect":"in"},{"chara":[{"id":100770,"motion":400}],"nameCenter":"Touka","narrationEffect":"out","textCenter":"Hmm?"},{"autoTurnLast":0.2,"bg":"bg_adv_14071.jpg","nameNarration":"[Text message]","narrationBg":"","narrationCoverOpacity":140.0,"narrationEffect":"in","turnChangeIn":"fadeIn"},{"armatureList":[{"animation":["action"],"armatureId":1,"filePath":"resource/image_native/effect/story/general/3003_act_picture.ExportJson","zOrder":"messageFront"}],"autoTurnLast":0.1},{"narration":"EMERGENCY ALERT@Urgent Notification to World Administrator","narrationHAlignment":"left","narrationPosX":120.0,"turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"bg":"bg_adv_21473.jpg","chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":100770,"lipSynch":0,"motion":0,"pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"autoTurnLast":0.1,"deleteArmatureList":[1]},{"chara":[{"id":100770,"lipSynch":0,"motion":300}],"nameCenter":"Touka","textCenter":"(...Are the Reindeer Santas...)","turnChangeOut":"fadeOut"},{"chara":[{"id":100770,"lipSynch":0}],"nameCenter":"Touka","textCenter":"(trying to break into the Little Vacation server?)"},{"chara":[{"id":100770,"lipSynch":0}],"nameCenter":"Touka","textCenter":"(Do they want to show the shooting star@they caught to someone else?)"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":100770,"motion":100}],"nameCenter":"Touka","textCenter":"...Is it that fun purr-tending to be Santa Claus?"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":100770,"motion":1}],"nameCenter":"Touka","textCenter":"Time moves faster in the world where@the AI girls live."},{"chara":[{"id":100770}],"nameCenter":"Touka","textCenter":"They change and grow so quickly."},{"chara":[{"id":100770}],"nameCenter":"Touka","textCenter":"I can't even begin to imeowgine what they@could be thinking."},{"chara":[{"id":100770,"lipSynch":0}],"nameCenter":"Touka","textCenter":"..."},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_001.exp3.json","id":100770,"lipSynch":0,"motion":0}],"nameCenter":"Touka","textCenter":"(When my Papa pretended to be Santa before,@he told me...)"},{"autoTurnLast":0.2,"bg":"bg_adv_19251.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":802301,"motion":1,"pos":1}],"turnChangeIn":"fadeIn","turnEffect":"blackFrame"},{"chara":[{"id":802301}],"nameCenter":"Touka's Father","textCenter":"When you grow up, you'll understand that@it's better to give than receive.","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"bg":"bg_adv_21473.jpg","chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":100770,"motion":0,"pos":1}],"turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"id":100770,"motion":300}],"nameCenter":"Touka","textCenter":"Even meow, I still don't get it.","turnChangeOut":"fadeOut"},{"autoTurnLast":2.0,"bg":"bg_adv_20642.jpg","bgm":"stop","nameNarration":"","narrationBg":"bg_adv_20642.jpg","narrationEffect":"in","turnChangeIn":"fadeIn"},{"narration":"<Little Vacation, Kosho Junk City>","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"bgm":"bgm05_event12","narrationEffect":"out","turnChangeIn":"fadeIn"},{"autoTurnLast":0.5,"nameNarration":"","narrationBg":"bg_adv_20601.jpg","narrationEffect":"in"},{"armatureList":[{"animation":["action"],"armatureId":1,"filePath":"resource/image_native/effect/story/general/3501_vr_frame.ExportJson","zOrder":"messageBack"}],"autoTurnLast":0.1},{"narration":"\"Well, it's another fine day@here at Pirate Radio Central!@...But now's not the time for that!\"","turnChangeOut":"fadeOut"},{"narration":"\"I've got an urgent call for you two playing@in the pool! This is a super-personal message,@but there's an unusual signal coming@from the Wishing Star!\""},{"autoTurnLast":0.2,"bg":"bg_adv_20601.jpg","chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102950,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103050,"motion":0,"pos":2}],"narrationE