},{"autoTurnFirst":2,"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":100300,"motion":300}]},{"autoTurnFirst":5,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":100300,"motion":100}]}],"group_14":[{"autoTurnFirst":1,"chara":[{"cheek":2,"eyeClose":0,"face":"mtn_ex_011.exp3.json","id":100300,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_1003_00_22"}]},{"autoTurnFirst":3,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":100300,"motion":100}]},{"autoTurnFirst":2,"chara":[{"cheek":2,"face":"mtn_ex_011.exp3.json","id":100300}]},{"autoTurnFirst":5,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":100300,"motion":0}]},{"autoTurnFirst":1,"chara":[{"id":100300,"motion":100}]},{"autoTurnFirst":3,"chara":[{"cheek":2,"face":"mtn_ex_011.exp3.json","id":100300}]}],"group_15":[{"autoTurnFirst":2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":100300,"lipSynch":1,"motion":100,"pos":1,"voice":"vo_char_1003_00_23"}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":100300,"motion":0}]},{"autoTurnFirst":8,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":100300,"motion":400}]},{"autoTurnFirst":5,"chara":[{"cheek":2,"face":"mtn_ex_011.exp3.json","id":100300,"motion":100}]}],"group_16":[{"autoTurnFirst":1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":100303,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_1003_03_24","textHome":"Huh? Oh!@I'm taking the whole day off today!"}]},{"autoTurnFirst":1.1,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":100303}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":100303,"motion":100}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":100303,"motion":1,"textHome":"In order to be the mightiest, it's not@just about training, but resting too!"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":100303,"motion":101}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_17":[{"autoTurnFirst":1.8,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_001.exp3.json","id":100303,"lipSynch":1,"motion":400,"pos":1,"voice":"vo_char_1003_03_25","textHome":"Vegetables! Meat! Fats!@Chinese food is both the best@and a well-balanced breakfast."}]},{"autoTurnFirst":1,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":100303,"motion":200}]},{"autoTurnFirst":4.6,"chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":100303}]},{"autoTurnFirst":3,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":100303,"motion":101,"textHome":"Let's dig into the soup, dumplings,@fried rice, and stir-fried vegetables too!"}]},{"autoTurnFirst":1.5,"chara":[{"id":100303,"motion":100}]},{"autoTurnFirst":2,"chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":100303}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_18":[{"autoTurnFirst":4.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":100303,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_1003_03_26","textHome":"Normally the restaurant starts@getting busy around now…but today,@Banbanzai is closed for the holidays!"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":100303,"motion":101}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":100303,"motion":0,"textHome":"I love working in the store with my@dad, but sometimes we need a break!"}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":100303,"motion":100}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_19":[{"autoTurnFirst":5,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_040.exp3.json","id":100303,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_1003_03_27","textHome":"I'm going to be strong...@…so…so strong…"}]},{"autoTurnFirst":2.6,"chara":[{"id":100303,"lipSynch":0}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":100303}]},{"autoTurnFirst":5.4,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":100303,"lipSynch":1,"motion":400,"textHome":"Oh! Whoops,@I must have dozed off."}]},{"autoTurnFirst":1.1,"chara":[{"cheek":1,"face":"mtn_ex_040.exp3.json","id":100303,"motion":100,"textHome":"When I'm in my pajamas,@I can't help but relax, y'know?"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":100303}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_2":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp3.json","id":100300,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_1003_00_03"}]},{"autoTurnFirst":5.5,"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":100300,"motion":200}]}],"group_20":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":100303,"lipSynch":0,"motion":0,"pos":1,"voice":"vo_char_1003_03_28","textHome":"*Gulp Gulp Gulp*@Phew! Ahhh~"}]},{"autoTurnFirst":2,"chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":100303,"lipSynch":1,"motion":101}]},{"autoTurnFirst":2.2,"chara":[{"id":100303,"motion":300}]},{"autoTurnFirst":3.9,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":100303,"motion":200,"textHome":"Milk is the best thing to drink@after taking a bath!"}]},{"autoTurnFirst":3.2,"chara":[{"id":100303,"motion":1,"textHome":"Not only is it delicious, but it@also makes your body stronger!@It's the mightiest!♪"}]},{"autoTurnFirst":2,"chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":100303,"motion":100}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_21":[{"autoTurnFirst":4.3,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":100303,"lipSynch":1,"motion":400,"pos":1,"voice":"vo_char_1003_03_29","textHome":"Oh, I'm getting eaten@alive by the futoooon!!@Ah…It feels so nice."}]},{"autoTurnFirst":1.6,"chara":[{"cheek":1,"face":"mtn_ex_040.exp3.json","id":100303,"motion":0}]},{"autoTurnFirst":2.8,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":100303,"motion":300}]},{"autoTurnFirst":3.1,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":100303,"motion":1,"textHome":"Every once in a while, it's nice@to just laze around like this."}]},{"autoTurnFirst":2,"chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":100303}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_22":[{"autoTurnFirst":4.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp3.json","id":100303,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_1003_03_30","textHome":"Even on a day off,@we can't ignore Witches."}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":100303,"motion":101,"textHome":"Alright, let's go!"}]},{"autoTurnFirst":4,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":100303,"motion":400,"textHome":"Oops, heading out in this@is a bit embarrassing…@Let's transform here!"}]},{"autoTurnFirst":2,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":100303,"motion":200}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_23":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":100303,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_1003_03_31","textHome":"I've been going to Endless@Mirrors every so often!"}]},{"autoTurnFirst":3.2,"chara":[{"id":100303,"motion":101,"textHome":"I challenge past copies of myself to@see if I've been getting stronger!"}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":100303,"motion":100}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_24":[{"autoTurnFirst":3.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp3.json","id":100303,"lipSynch":1,"motion":201,"pos":1,"voice":"vo_char_1003_03_32"}]},{"autoTurnFirst":2.9,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":100303,"motion":200}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":100303}]},{"autoTurnFirst":2.1,"chara":[{"eyeClose":1,"id":100303,"motion":300}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":100303}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":100303,"motion":0}]}],"group_25":[{"autoTurnFirst":4.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":100303,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_1003_03_33","textHome":"I had a dream where I defeated a@Witch with a wok, but when I woke up,@I found my dad lying on the floor."}]},{"autoTurnFirst":5.4,"chara":[{"cheek":0,"face":"mtn_ex_052.exp3.json","id":100303,"motion":300}]},{"autoTurnFirst":1.6,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":100303,"motion":0,"textHome":"That was...probably my fault."}]},{"autoTurnFirst":3,"chara":[{"id":100303,"motion":100}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_26":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":100303,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_1003_03_34","textHome":"Memorize words before bedtime,@and check in the morning to see@if you remember them!"}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":100303}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":100303,"motion":100,"textHome":"It's the Tsuruno-style study method!@I recommend it because it's easy@to memorize vocabulary this way!"}]},{"autoTurnFirst":3.7,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":100303,"motion":1}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_27":[{"autoTurnFirst":3.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp3.json","id":100303,"lipSynch":1,"motion":101,"pos":1,"voice":"vo_char_1003_03_35","textHome":"I'm really good at@spotting stars at night!"}]},{"autoTurnFirst":4.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":100303,"motion":0,"textHome":"I have good eyesight, so I can@find 6th magnitude stars with ease!"}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":100303,"textHome":"Oh, if I train, maybe I'll be able to@see 10th magnitude stars someday!"}]},{"autoTurnFirst":3.8,"chara":[{"cheek":1,"id":100303,"motion":200}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_28":[{"autoTurnFirst":2,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_030.exp3.json","id":100303,"lipSynch":1,"motion":400,"pos":1,"voice":"vo_char_1003_03_36","textHome":"NOOOOO!!"}]},{"autoTurnFirst":3.5,"chara":[{"id":100303,"motion":300,"textHome":"I got toothpaste on my pajamas!@These ones are my favorite…"}]},{"autoTurnFirst":4,"chara":[{"id":100303,"motion":0}]},{"autoTurnFirst":5,"chara":[{"cheek":1,"face":"mtn_ex_040.exp3.json","id":100303,"motion":100,"textHome":"If I go wash it quickly,@do you think it won't stain?"}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_29":[{"autoTurnFirst":2,"chara":[{"cheek":2,"eyeClose":1,"face":"mtn_ex_040.exp3.json","id":100303,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_1003_03_37","textHome":"*Wheeze...* *Huff*"}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":100303}]},{"autoTurnFirst":4.3,"chara":[{"id":100303,"motion":0,"textHome":"I did some muscle training with Master,@and I only intended to do a little,@but I might have overdone it…"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":2,"face":"mtn_ex_030.exp3.json","id":100303,"motion":100}]},{"autoTurnFirst":2.2,"chara":[{"cheek":2,"face":"mtn_ex_050.exp3.json","id":100303,"motion":101,"textHome":"Though with how tired I am,@I'm sure to sleep like a log!"}]},{"autoTurnFirst":3.6,"chara":[{"cheek":2,"face":"mtn_ex_011.exp3.json","id":100303}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_3":[{"autoTurnFirst":2.5,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":100300,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_1003_00_04"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":2,"face":"mtn_ex_011.exp3.json","id":100300,"motion":100}]}],"group_30":[{"autoTurnFirst":1.2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp3.json","id":100303,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_1003_03_38","textHome":"Ugh…"}]},{"autoTurnFirst":4.7,"chara":[{"eyeClose":0,"id":100303,"textHome":"I was supposed to help Felicia with her@homework, but we ended up playing@games and Master scolded us…"}]},{"autoTurnFirst":2.6,"chara":[{"eyeClose":1,"id":100303,"motion":300}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":100303}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":100303,"motion":200,"textHome":"Even I, the world's mightiest person,@was in the wrong this time…"}]},{"autoTurnFirst":2.3,"chara":[{"eyeClose":1,"id":100303}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_31":[{"autoTurnFirst":4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":100303,"lipSynch":1,"motion":100,"pos":1,"voice":"vo_char_1003_03_39","textHome":"It seems that Sana sleeps@with a stuffed animal."}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":100303,"motion":0,"textHome":"I wish I had someone sleeping@next to me while I sleep, too."}]},{"autoTurnFirst":1.1,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":100303,"textHome":"Oh, maybe I could sleep with Sana?@Yeah, I could do that!"}]},{"autoTurnFirst":2.9,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":100303,"motion":101}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":100303,"motion":200}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_32":[{"autoTurnFirst":5.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":100303,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_1003_03_40","textHome":"I keep a pair of my pajamas at@Mikazuki Villa, and Iroha will wash@them every now and then!"}]},{"autoTurnFirst":3.8,"chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":100303,"motion":101,"textHome":"See? The fabric softener makes@them smell really good!"}]},{"chara":[{"id":100303,"textHomeStatus":"Clear"}]}],"group_33":[{"autoTurnFirst":2,"chara":[{"cheek":0,"eyeClose"