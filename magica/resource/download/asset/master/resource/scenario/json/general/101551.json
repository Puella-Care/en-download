{"story":{"group_1":[{"autoTurnFirst":2.2,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":0,"pos":1,"tear":0,"voice":"vo_char_1015_00_01"}]},{"autoTurnFirst":3.7,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500}]},{"autoTurnFirst":5.2,"chara":[{"cheek":1,"face":"mtn_ex_030.exp.json","id":101500,"motion":300}]},{"autoTurnFirst":2.5,"chara":[{"cheek":1,"face":"mtn_ex_041.exp.json","id":101500,"motion":0}]},{"autoTurnFirst":4,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500,"motion":100}]},{"autoTurnFirst":1.5,"chara":[{"cheek":1,"face":"mtn_ex_050.exp.json","id":101500}]},{"autoTurnFirst":2.8,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500,"motion":200}]},{"autoTurnFirst":4,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500}]}],"group_10":[{"autoTurnFirst":3.8,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_041.exp.json","id":101500,"motion":300,"pos":1,"tear":0,"voice":"vo_char_1015_00_17"}]},{"autoTurnFirst":1.8,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_031.exp.json","id":101500}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":101500}]},{"autoTurnFirst":2.8,"chara":[{"cheek":1,"face":"mtn_ex_030.exp.json","id":101500,"motion":0}]},{"autoTurnFirst":6,"chara":[{"id":101500,"motion":100}]}],"group_11":[{"autoTurnFirst":3.3,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":101500,"motion":0,"pos":1,"tear":0,"voice":"vo_char_1015_00_18"}]},{"autoTurnFirst":5,"chara":[{"id":101500,"motion":100}]},{"autoTurnFirst":2,"chara":[{"cheek":1,"face":"mtn_ex_020.exp.json","id":101500,"motion":300}]},{"autoTurnFirst":5,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":101500}]}],"group_12":[{"autoTurnFirst":2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":101500,"motion":100,"pos":1,"tear":0,"voice":"vo_char_1015_00_19"}]},{"autoTurnFirst":5,"chara":[{"eyeClose":0,"id":101500}]}],"group_13":[{"autoTurnFirst":2.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":101500,"motion":300,"pos":1,"tear":0,"voice":"vo_char_1015_00_20"}]},{"autoTurnFirst":5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":200}]}],"group_14":[{"autoTurnFirst":0.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":101500,"motion":200,"pos":1,"tear":0,"voice":"vo_char_1015_00_21"}]},{"autoTurnFirst":0.7,"chara":[{"id":101500,"motion":200}]},{"autoTurnFirst":1,"chara":[{"id":101500,"motion":200}]},{"autoTurnFirst":1.7,"chara":[{"id":101500,"motion":400}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":100}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":101500}]},{"autoTurnFirst":6,"chara":[{"id":101500,"motion":300}]}],"group_15":[{"autoTurnFirst":2,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":0,"pos":1,"tear":0,"voice":"vo_char_1015_00_22"}]},{"autoTurnFirst":2,"chara":[{"id":101500,"motion":100}]},{"autoTurnFirst":6.2,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500}]},{"autoTurnFirst":3.5,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500}]},{"autoTurnFirst":1.6,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500,"motion":200}]},{"autoTurnFirst":6,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":0}]}],"group_16":[{"autoTurnFirst":4.5,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":101500,"motion":0,"pos":1,"tear":0,"voice":"vo_char_1015_00_23"}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":101500}]},{"autoTurnFirst":5.2,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":101500,"motion":300}]},{"autoTurnFirst":1.2,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":101500}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"id":101500,"motion":200}]},{"autoTurnFirst":7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":100}]}],"group_17":[{"autoTurnFirst":2.4,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":200,"pos":1,"tear":0,"voice":"vo_char_1015_51_24","textHome":"Happy New Year!"}]},{"autoTurnFirst":3.7,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500,"motion":0,"textHome":"Please accept my sincere wishes@for the new year."}]},{"autoTurnFirst":1,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500,"motion":300,"textHome":"Hehehe, being able to say that over and@over again is one of my small joys!"}]},{"autoTurnFirst":2.4,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500}]},{"autoTurnFirst":3,"chara":[{"id":101500,"motion":100}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_18":[{"autoTurnFirst":2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":101500,"motion":200,"pos":1,"tear":0,"voice":"vo_char_1015_51_25","textHome":"Hey, come on, wake up!@Ehehe, are you awake?"}]},{"autoTurnFirst":2.9,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":100}]},{"autoTurnFirst":3.4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":101500,"textHome":"There's no school and no radio@exercises during winter vacation,@but you can't sleep in all day."}]},{"autoTurnFirst":2,"chara":[{"cheek":0,"face":"mtn_ex_041.exp.json","id":101500,"motion":0}]},{"autoTurnFirst":4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":200,"textHome":"Now, why don't you put on your@slippers and go for a walk with me?"}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_19":[{"autoTurnFirst":3,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":300,"pos":1,"tear":0,"voice":"vo_char_1015_51_26","textHome":"I love eating Big Sis's maki rolls."}]},{"autoTurnFirst":2.5,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500,"motion":100,"textHome":"The seaweed is really soft@and there's herring inside!"}]},{"autoTurnFirst":2.3,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500}]},{"autoTurnFirst":4,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500,"motion":0,"textHome":"Plus, the bite-size pieces@make it very easy to eat."}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_2":[{"autoTurnFirst":2.5,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":100,"pos":1,"tear":0,"voice":"vo_char_1015_00_02"}]},{"autoTurnFirst":1,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500}]},{"autoTurnFirst":3,"chara":[{"id":101500,"motion":0}]},{"autoTurnFirst":2.5,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500,"motion":200}]},{"autoTurnFirst":5,"chara":[{"id":101500,"motion":100}]}],"group_20":[{"autoTurnFirst":3.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":101500,"motion":200,"pos":1,"tear":0,"voice":"vo_char_1015_51_27","textHome":"After we finish dinner,@it's homework time."}]},{"autoTurnFirst":2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":101500,"motion":100,"textHome":"You can't say that you don't have@to do it, since it's winter vacation."}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":101500}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_041.exp.json","id":101500}]},{"autoTurnFirst":4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":200,"textHome":"Study a little every day@to exercise your mind!"}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_21":[{"autoTurnFirst":5.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":101500,"motion":1,"pos":1,"tear":0,"voice":"vo_char_1015_51_28","textHome":"This year, I'm going to count@to see if the bell really rings@108 times for New Year's!"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_041.exp.json","id":101500,"motion":0,"textHome":"…At least that was the plan,@but it didn't work out.@I lost track after 20 rings."}]},{"autoTurnFirst":1.2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":101500,"motion":100}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":101500}]},{"autoTurnFirst":5,"chara":[{"cheek":0,"face":"mtn_ex_041.exp.json","id":101500,"motion":300}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_22":[{"autoTurnFirst":5.2,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":1,"pos":1,"tear":0,"voice":"vo_char_1015_51_29","textHome":"This furisode kimono was chosen@by my mother who's overseas."}]},{"autoTurnFirst":3,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500,"motion":100,"textHome":"She said that it was perfect for me."}]},{"autoTurnFirst":3,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500,"motion":300,"textHome":"At the end of the year, she asked me@a lot of questions about my height,@so I guess this was why."}]},{"autoTurnFirst":3,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_23":[{"autoTurnFirst":2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":101500,"motion":300,"pos":1,"tear":0,"voice":"vo_char_1015_51_30","textHome":"We still have to fight.@We're Magical Girls and we@have a duty to save people."}]},{"autoTurnFirst":3.8,"chara":[{"eyeClose":1,"id":101500}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":101500}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":101500,"motion":0,"textHome":"Even if it's New Year's, that fact@doesn't mean anything to Witches."}]},{"autoTurnFirst":4,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":101500,"motion":200}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_24":[{"autoTurnFirst":5.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":101500,"motion":100,"pos":1,"tear":0,"voice":"vo_char_1015_51_31","textHome":"Endless Mirrors changes@its decorations sometimes."}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_041.exp.json","id":101500,"motion":300,"textHome":"I wonder if they ever put out@mirror-shaped mochi in Mirrors?"}]},{"autoTurnFirst":0.8,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":101500,"motion":400,"textHome":"Oh, Mirrors' mirror-shaped mochi...@That sounds like a pun, doesn't it?"}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":101500}]},{"autoTurnFirst":4,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":200}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_25":[{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":101500,"motion":0,"pos":1,"tear":0,"voice":"vo_char_1015_51_32"}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":101500,"motion":300}]},{"autoTurnFirst":2.5,"chara":[{"eyeClose":1,"id":101500}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":101500}]},{"autoTurnFirst":5,"chara":[{"id":101500,"motion":100}]}],"group_26":[{"autoTurnFirst":2.5,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":0,"pos":1,"tear":0,"voice":"vo_char_1015_51_33","textHome":"Have you made any@resolutions for this year?"}]},{"autoTurnFirst":1.5,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500,"textHome":"My goal is to learn and@practice all sorts of instruments!"}]},{"autoTurnFirst":3.2,"chara":[{"id":101500,"motion":200}]},{"autoTurnFirst":3.8,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500,"motion":100,"textHome":"My music teacher can play@the recorder, piano, and drums!"}]},{"autoTurnFirst":3,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_27":[{"autoTurnFirst":4,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":1,"pos":1,"tear":0,"voice":"vo_char_1015_51_34","textHome":"This kimono is super warm.@It has a coat type of lining."}]},{"autoTurnFirst":2.5,"chara":[{"id":101500,"motion":100}]},{"autoTurnFirst":4.3,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500,"motion":300,"textHome":"I wonder if my mother considered that@to keep me from catching a cold…"}]},{"autoTurnFirst":4,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_28":[{"autoTurnFirst":3.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":400,"pos":1,"tear":0,"voice":"vo_char_1015_51_35","textHome":"I've been practicing singing lately!"}]},{"autoTurnFirst":3.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":0,"textHome":"In the end-of-year music show,@there was an old lady who was an@enka singer, and she was so cool!"}]},{"autoTurnFirst":2.2,"chara":[{"id":101500,"motion":200}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":100,"textHome":"Once I can do it,@please listen to my singing."}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_29":[{"autoTurnFirst":4.4,"chara":[{"cheek":2,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":1,"pos":1,"tear":0,"voice":"vo_char_1015_51_36","textHome":"You see, Felicia and I weren't on@Earth when the new year started!"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":2,"face":"mtn_ex_010.exp.json","id":101500,"motion":100}]},{"autoTurnFirst":3.2,"chara":[{"id":101500,"motion":200,"textHome":"Cause...we both jumped when@the countdown reached zero!"}]},{"autoTurnFirst":2,"chara":[{"cheek":2,"face":"mtn_ex_011.exp.json","id":101500,"motion":400}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_3":[{"autoTurnFirst":3.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":101500,"motion":300,"pos":1,"tear":0,"voice":"vo_char_1015_00_03"}]},{"autoTurnFirst":4,"chara":[{"eyeClose":1,"id":101500}]}],"group_30":[{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":100,"pos":1,"tear":0,"voice":"vo_char_1015_51_37","textHome":"Yachiyo is really good at hanetsuki!"}]},{"autoTurnFirst":0.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":0,"textHome":"She's in her kimono, but she's able@to play with a swoosh and a step."}]},{"autoTurnFirst":2,"chara":[{"id":101500,"motion":400}]},{"autoTurnFirst":5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":300,"textHome":"I'm going to ask her to teach me@how to do that disappearing serve."}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_31":[{"autoTurnFirst":1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":101500,"motion":0,"pos":1,"tear":0,"voice":"vo_char_1015_51_38","textHome":"Hm? Whose New Year's greeting card@could this be… It's handwritten and@has fancy calligraphy…oh! It's Nemu's!"}]},{"autoTurnFirst":5.4,"chara":[{"id":101500,"motion":300}]},{"autoTurnFirst":2.7,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":101500,"motion":400}]},{"autoTurnFirst":3.6,"chara":[{"id":101500,"motion":100,"textHome":"Hehe, thank you very much for such@a thoughtful New Year's greeting!"}]},{"autoTurnFirst":3,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":101500}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_32":[{"autoTurnFirst":4.6,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":0,"pos":1,"tear":0,"voice":"vo_char_1015_51_39","textHome":"I read on Touka's New Year's@card that protium or phosphorus@can mean Happy New Year!"}]},{"autoTurnFirst":3.1,"chara":[{"cheek":2,"face":"mtn_ex_011.exp.json","id":101500,"motion":100}]},{"autoTurnFirst":1.7,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":101500,"motion":400,"textHome":"I think they're elemental symbols?@Well, that's what Tsuruno said!"}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":101500,"motion":200}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_33":[{"autoTurnFirst":6,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":101500,"motion":1,"pos":1,"tear":0,"voice":"vo_char_1015_51_40","textHome":"When I was in the hospital,@I saw a huge kite from the@window of my room."}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":101500}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":101500,"motion":200,"textHome":"And guess who was flying it?@My big sister!"}]},{"autoTurnFirst":1.4,"chara":[{"cheek":2,"face":"mtn_ex_011.exp.json","id":101500,"motion":100}]},{"autoTurnFirst":2.2,"chara":[{"cheek":2,"face":"mtn_ex_010.exp.json","id":101500,"textHome":"She said she wanted to show it@to me, and I was really happy."}]},{"autoTurnFirst":4,"chara":[{"cheek":2,"face":"mtn_ex_011.exp.json","id":101500,"motion":300}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_34":[{"autoTurnFirst":2.3,"chara":[{"cheek":2,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":101500,"motion":400,"pos":1,"tear":0,"voice":"vo_char_1015_51_41","textHome":"Oh, you noticed?"}]},{"autoTurnFirst":1,"chara":[{"cheek":2,"face":"mtn_ex_041.exp.json","id":101500,"textHome":"Yeah, I'm wearing a little@bit of makeup today."}]},{"autoTurnFirst":2.8,"chara":[{"id":101500,"motion":200}]},{"autoTurnFirst":2.4,"chara":[{"id":101500,"motion":300,"textHome":"I thought I wasn't old enough to wear@makeup, but everyone encouraged it,@since it's a special occasion."}]},{"autoTurnFirst":5,"chara":[{"cheek":2,"face":"mtn_ex_011.exp.json","id":101500}]},{"chara":[{"id":101500,"textHomeStatus":"Clear"}]}],"group_35":[{"autoTurnFirst":4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":101500,"motion":200,"pos":1,"tear":0,"voice":"vo_char_1015_00_42"}]}],"group_36":[{"autoTurnFirst":4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":100,"pos":1,"tear":0,"voice":"vo_char_1015_00_43"}]}],"group_37":[{"autoTurnFirst":4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":101500,"motion":300,"pos":1,"tear":0,"voice":"vo_char_1015_00_44"}]}],"group_38"