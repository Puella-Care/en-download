,"pos":1,"voice":"vo_char_2003_00_17"}]},{"autoTurnFirst":5,"chara":[{"id":220300,"motion":100}]},{"autoTurnFirst":2,"chara":[{"cheek":-1,"face":"mtn_ex_040.exp3.json","id":220300,"motion":0}]},{"autoTurnFirst":6,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":220300,"motion":400}]}]},"version":3}
