{"story":{"group_1":[{"autoTurnFirst":2.5,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_030.exp3.json","id":220300,"motion":100,"pos":1,"voice":"vo_char_2203_00_01"}]},{"autoTurnFirst":3.5,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":220300}]},{"autoTurnFirst":4,"chara":[{"cheek":-1,"face":"mtn_ex_050.exp3.json","id":220300,"motion":0}]},{"autoTurnFirst":3,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":220300}]},{"autoTurnFirst":5,"chara":[{"cheek":-1,"face":"mtn_ex_040.exp3.json","id":220300,"motion":300}]},{"autoTurnFirst":5,"chara":[{"cheek":-1,"face":"mtn_ex_031.exp3.json","id":220300,"motion":200}]},{"autoTurnFirst":2.5,"chara":[{"cheek":-1,"face":"mtn_ex_040.exp3.json","id":220300,"motion":0}]},{"autoTurnFirst":4.5,"chara":[{"cheek":-1,"face":"mtn_ex_050.exp3.json","id":220300,"motion":400}]}],"group_10":[{"autoTurnFirst":2,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":220300,"motion":0,"pos":1,"voice":"vo_char_2003_00_18"}]},{"autoTurnFirst":2,"chara":[{"id":220300,"motion":100}]},{"autoTurnFirst":5,"chara":[{"id":220300,"motion":0}]},{"autoTurnFirst":3,"chara":[{"cheek":-1,"face":"mtn_ex_030.exp3.json","id":220300,"motion":300}]},{"autoTurnFirst":4,"chara":[{"id":220300,"motion":0}]}],"group_11":[{"autoTurnFirst":1,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":220300,"motion":0,"pos":1,"voice":"vo_char_2003_00_19"}]},{"autoTurnFirst":6,"chara":[{"id":220300,"motion":100}]}],"group_12":[{"autoTurnFirst":3,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":220300,"motion":100,"pos":1,"voice":"vo_char_2003_00_20"}]},{"autoTurnFirst":2,"chara":[{"cheek":-1,"face":"mtn_ex_040.exp3.json","id":220300,"motion":0}]},{"autoTurnFirst":3,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":220300}]}],"group_13":[{"autoTurnFirst":5,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":220300,"motion":0,"pos":1,"voice":"vo_char_2003_00_21"}]},{"autoTurnFirst":4,"chara":[{"cheek":-1,"face":"mtn_ex_040.exp3.json","id":220300,"motion":100}]},{"autoTurnFirst":2,"chara":[{"cheek":-1,"face":"mtn_ex_030.exp3.json","id":220300,"motion":300}]},{"autoTurnFirst":5,"chara":[{"cheek":-1,"face":"mtn_ex_040.exp3.json","id":220300}]}],"group_14":[{"autoTurnFirst":3,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":220300,"motion":0,"pos":1,"voice":"vo_char_2003_00_22"}]},{"autoTurnFirst":4.5,"chara":[{"cheek":-1,"face":"mtn_ex_030.exp3.json","id":220300}]},{"autoTurnFirst":6.5,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":220300,"motion":100}]},{"autoTurnFirst":3,"chara":[{"id":220300,"motion":300}]},{"autoTurnFirst":5,"chara":[{"id":220300,"motion":0}]}],"group_15":[{"autoTurnFirst":5.5,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_040.exp3.json","id":220300,"motion":0,"pos":1,"voice":"vo_char_2003_00_23"}]},{"autoTurnFirst":7.5,"chara":[{"cheek":-1,"face":"mtn_ex_030.exp3.json","id":220300,"motion":100}]},{"autoTurnFirst":4,"chara":[{"cheek":-1,"face":"mtn_ex_031.exp3.json","id":220300,"motion":300}]},{"autoTurnFirst":3,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":220300,"motion":0}]},{"autoTurnFirst":4,"chara":[{"id":220300,"motion":100}]}],"group_16":[{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":101,"pos":1,"voice":"vo_char_2203_50_24","textHome":"This feels like a dream."}]},{"autoTurnFirst":6.9,"chara":[{"id":220350,"motion":300,"textHome":"Suddenly, the seasons have changed,@and I find myself no longer in Mitakihara."}]},{"autoTurnFirst":5.5,"chara":[{"id":220350,"motion":200,"textHome":"All evidence indicates that@this must indeed be a dream."}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_17":[{"autoTurnFirst":1.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":0,"pos":1,"voice":"vo_char_2203_50_25","textHome":"Wake up. It's still chilly,@but there's no time to relax."}]},{"autoTurnFirst":5,"chara":[{"id":220350,"motion":101}]},{"autoTurnFirst":5,"chara":[{"id":220350,"motion":300,"textHome":"I can't afford to let my guard down,@lest something happen to Madoka."}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_18":[{"autoTurnFirst":2.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":0,"pos":1,"voice":"vo_char_2203_50_26","textHome":"I wonder what Madoka is doing@now that it's winter break."}]},{"autoTurnFirst":4.2,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":220350}]},{"autoTurnFirst":5.1,"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":200,"textHome":"When school is in session, she often@spends time with Sayaka Miki."}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_19":[{"autoTurnFirst":4.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":200,"pos":1,"voice":"vo_char_2203_50_27","textHome":"Some people find joy in seeing@the winter light displays, but it's@a world I'm disconnected from."}]},{"autoTurnFirst":2.7,"chara":[{"id":220350,"motion":0}]},{"autoTurnFirst":4.1,"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":220350,"motion":300,"textHome":"I must save Madoka@as soon as possible."}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_2":[{"autoTurnFirst":4.5,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_030.exp3.json","id":220300,"motion":300,"pos":1,"tear":1,"voice":"vo_char_2003_00_03"}]},{"autoTurnFirst":1.5,"chara":[{"cheek":2,"face":"mtn_ex_031.exp3.json","id":220300,"motion":100,"tear":1}]},{"autoTurnFirst":4,"chara":[{"cheek":2,"face":"mtn_ex_031.exp3.json","id":220300,"motion":400,"tear":1}]}],"group_20":[{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":0,"pos":1,"voice":"vo_char_2203_50_28","textHome":"The night sky is clear,@and the stars are visible."}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":220350,"motion":101,"textHome":"Over there is the Winter Triangle."}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":220350,"textHome":"Come to think of it,@I haven't had the luxury to look@up at the sky like this recently."}]},{"autoTurnFirst":4,"chara":[{"id":220350,"motion":300}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_21":[{"autoTurnFirst":5.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":300,"pos":1,"voice":"vo_char_2203_50_29","textHome":"Before coming to Mitakihara,@I attended school in Tokyo."}]},{"autoTurnFirst":2.8,"chara":[{"id":220350,"motion":200,"textHome":"I was hospitalized for a long time,@so I lack many memories of winter."}]},{"autoTurnFirst":3,"chara":[{"eyeClose":1,"id":220350}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_22":[{"autoTurnFirst":5.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp3.json","id":220350,"motion":200,"pos":1,"voice":"vo_char_2203_50_30","textHome":"I feel uneasy at the thought@of unknown Witches in this town."}]},{"autoTurnFirst":4.8,"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":101,"textHome":"I traveled back in time repeatedly@while in Mitakihara, but this is a@new location in a different season."}]},{"autoTurnFirst":4.2,"chara":[{"id":220350,"motion":0}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_23":[{"autoTurnFirst":5.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":300,"pos":1,"voice":"vo_char_2203_50_31","textHome":"Madoka told me about a Mirror@Mansion which copies Magical Girls."}]},{"autoTurnLast":2.6,"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":220350,"motion":1,"textHome":"If a Magical Girl appears wearing@a swimsuit in the dead of winter, @it's surely a fake from summer."}]},{"autoTurnFirst":4,"chara":[{"id":220350,"motion":200}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_24":[{"autoTurnFirst":5.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":100,"pos":1,"voice":"vo_char_2203_50_32","textHome":"Despite the snow outside,@many Magical Girls are gathering."}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":220350,"motion":300,"textHome":"I wonder if some event's happening."}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_25":[{"autoTurnFirst":3.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp3.json","id":220350,"motion":101,"pos":1,"voice":"vo_char_2203_50_33","textHome":"I wonder if this outfit suits me."}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":300,"textHome":"I'm fine with anything as long as@it's warm, but Madoka invited me@out shopping and helped choose it."}]},{"autoTurnFirst":5,"chara":[{"id":220350,"motion":200}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_26":[{"autoTurnFirst":5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp3.json","id":220350,"motion":0,"pos":1,"voice":"vo_char_2203_50_34","textHome":"I thought it was oddly quiet outside,@but it turns out it was snowing."}]},{"autoTurnFirst":3.1,"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":1,"textHome":"I don't like it when it's too quiet."}]},{"autoTurnFirst":2.4,"chara":[{"id":220350,"motion":300,"textHome":"Too many memories from my@time loops start flooding back."}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":220350}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_27":[{"autoTurnFirst":5.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":200,"pos":1,"voice":"vo_char_2203_50_35","textHome":"Will my usual weapons be able to@function properly in this weather?"}]},{"autoTurnLast":2.7,"chara":[{"id":220350,"motion":300,"textHome":"Military-grade ones should be fine,@but it wouldn't hurt to double-check."}]},{"autoTurnFirst":3,"chara":[{"id":220350,"motion":101}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_28":[{"autoTurnFirst":1.4,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp3.json","id":220350,"motion":300,"pos":1,"voice":"vo_char_2203_50_36","textHome":"*Exhale*@I can see my breath."}]},{"autoTurnFirst":3,"chara":[{"eyeClose":0,"id":220350}]},{"autoTurnFirst":5.2,"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":0,"textHome":"It's getting colder, so buying@boots was the right decision."}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":220350,"motion":200,"textHome":"I want to express my gratitude@to Madoka for choosing them,@but how should I bring it up?"}]},{"autoTurnFirst":3.3,"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":220350,"motion":101}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_29":[{"autoTurnFirst":6.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":101,"pos":1,"voice":"vo_char_2203_50_37","textHome":"Nagisa Momoe was begging Mami@Tomoe for a cheese filled taiyaki."}]},{"autoTurnLast":2.7,"chara":[{"id":220350,"motion":1,"textHome":"Evidently, it just won't do without@cheese, though I'm not sure why?"}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":220350,"motion":300}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_3":[{"autoTurnFirst":1,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_030.exp3.json","id":220300,"motion":0,"pos":1,"voice":"vo_char_2003_00_04"}]},{"autoTurnFirst":3,"chara":[{"cheek":-1,"face":"mtn_ex_040.exp3.json","id":220300}]},{"autoTurnFirst":3,"chara":[{"cheek":-1,"face":"mtn_ex_031.exp3.json","id":220300,"motion":100}]}],"group_30":[{"autoTurnFirst":6.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":300,"pos":1,"voice":"vo_char_2203_50_38","textHome":"The Sayaka Miki of this world is@essentially the same person I know."}]},{"autoTurnFirst":3.9,"chara":[{"id":220350,"motion":101,"textHome":"The location and season may be@entirely different, but her feelings@for that boy remain unchanged."}]},{"autoTurnFirst":4,"chara":[{"id":220350,"motion":200}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_31":[{"autoTurnFirst":3.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp3.json","id":220350,"motion":1,"pos":1,"voice":"vo_char_2203_50_39","textHome":"Mami Tomoe's attire seemed a bit light@without a coat or jacket, but apparently,@she's happy with pocket handwarmers."}]},{"autoTurnFirst":2,"chara":[{"id":220350,"motion":200}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":220350}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_32":[{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220350,"motion":200,"pos":1,"voice":"vo_char_2203_50_40","textHome":"Apples are lined up at the store.@Winter is their season, right?"}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp3.json","id":220350,"motion":0,"textHome":"Come to think of it, Kyoko@Sakura seems to love apples."}]},{"autoTurnLast":4,"chara":[{"id":220350,"motion":101,"textHome":"I wonder if she has a special@memory associated with them."}]},{"chara":[{"id":220350,"textHomeStatus":"Clear"}]}],"group_33":[{"autoTurnFirst":4.2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp3.json","id":220350,"motion":0,"pos":1,"voice":"vo_char_2203_50_41","textHome":"...Madoka..."}]},{"autoTurnLast":0.5,"chara":[{"eyeClose":0,"id":220350}]},{"autoTurnFirst":5.4,"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":220350,"motion":400,"textHome":"Ah! I must have fallen asleep@in the sunlight."}]},{"autoTurnFirst":1.7,"chara":[{"id":220350,"motion":300,"textHome":"I hope I...didn't say anything@while I was sleeping."}]},{"autoTurnFirst":3.4,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":220350}]},{"chara":[{"id":220300,"textHomeStatus":"Clear"}]}],"group_34":[{"autoTurnFirst":0.7,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_020.exp3.json","id":220300,"motion":0,"pos":1,"voice":"vo_char_2003_00_42"}]},{"autoTurnFirst":3.3,"chara":[{"id":220300,"motion":200}]}],"group_35":[{"autoTurnFirst":0.7,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":220300,"motion":0,"pos":1,"voice":"vo_char_2003_00_43"}]},{"autoTurnFirst":3.3,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":220300,"motion":400}]}],"group_36":[{"autoTurnFirst":1,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":220300,"motion":100,"pos":1,"voice":"vo_char_2003_00_44"}]},{"autoTurnFirst":3,"chara":[{"cheek":-1,"face":"mtn_ex_050.exp3.json","id":220300}]}],"group_37":[{"autoTurnFirst":0.7,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":220300,"motion":0,"pos":1,"voice":"vo_char_2003_00_45"}]},{"autoTurnFirst":3.3,"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":220300,"motion":200}]}],"group_38":[{"autoTurnFirst":5,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":220300,"motion":100,"pos":1,"voice":"vo_char_2003_00_46"}]}],"group_39":[{"autoTurnFirst":2.5,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":220300,"motion":400,"pos":1,"voice":"vo_char_2003_00_63"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":-1,"face":"mtn_ex_020.exp3.json","id":220300,"motion":200}]}],"group_4":[{"autoTurnFirst":2.5,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_020.exp3.json","id":220300,"motion":200,"pos":1,"voice":"vo_char_2003_00_05"}]},{"autoTurnFirst":3.5,"chara":[{"id":220300,"motion":400}]}],"group_40":[{"autoTurnFirst":2,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":220300,"motion":400,"pos":1,"voice":"vo_char_2003_00_64"}]},{"autoTurnFirst":4,"chara":[{"cheek":-1,"face":"mtn_ex_020.exp3.json","id":220300,"motion":200}]}],"group_41":[{"autoTurnFirst":2,"chara":[{"cheek":-1,"eyeClose":0,"face":"mtn_ex_020.exp3.json","id":220300,"motio