{"story":{"group_1":[{"autoTurnFirst":2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp3.json","id":250300,"motion":100,"pos":1,"voice":"vo_char_2503_00_01","textHome":"Welcome to Mitakihara City.@I'm Mami Tomoe."}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":250300}]},{"autoTurnFirst":3.5,"chara":[{"id":250300,"motion":200,"textHome":"I'm all for having more@Magical Girls as comrades."}]},{"autoTurnFirst":3.4,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":250300,"motion":1,"textHome":"Let's protect this town together."}]},{"autoTurnFirst":4.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":400,"textHome":"As a senior, I have to be sure@to set a good example."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_10":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp3.json","id":250300,"motion":0,"pos":1,"voice":"vo_char_2503_00_17","textHome":"I had a nightmare."}]},{"autoTurnFirst":6.5,"chara":[{"id":250300,"motion":200,"textHome":"A terrifying Witch was closing in@after breaking free of my restraints."}]},{"autoTurnFirst":5,"chara":[{"eyeClose":1,"id":250300,"motion":300,"textHome":"Suddenly, everything went dark.@And then...I woke up."}]},{"autoTurnFirst":3,"chara":[{"eyeClose":0,"id":250300}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_11":[{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":100,"pos":1,"voice":"vo_char_2503_00_18","textHome":"Miss Aki once had a special@ability as a Magical Girl."}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":250300,"motion":300,"textHome":"Then she lost her memories."}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":250300,"textHome":"I may be the only person@who understands why."}]},{"autoTurnFirst":3,"chara":[{"id":250300,"motion":0}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_12":[{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":400,"pos":1,"voice":"vo_char_2503_00_19","textHome":"Yes. With this, I should be able@to summon even more rifles."}]},{"autoTurnFirst":3,"chara":[{"id":250300,"motion":100}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_13":[{"autoTurnFirst":6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":200,"pos":1,"voice":"vo_char_2503_00_20","textHome":"It seems I've gotten better@at playing the cool, composed@upperclassman than before."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_14":[{"autoTurnFirst":3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":1,"pos":1,"voice":"vo_char_2503_00_21","textHome":"Being a veteran Magical Girl allows@me to do various things with magic."}]},{"autoTurnFirst":4.5,"chara":[{"id":250300,"motion":100}]},{"autoTurnFirst":2,"chara":[{"id":250300,"motion":200,"textHome":"I can even drink a cup of warm tea@on the spot after defeating a Witch."}]},{"autoTurnFirst":4,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":250300}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_15":[{"autoTurnFirst":4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp3.json","id":250300,"motion":0,"pos":1,"voice":"vo_char_2503_00_22","textHome":"Sometimes I think about those@who have left me behind."}]},{"autoTurnFirst":2.7,"chara":[{"eyeClose":1,"id":250300,"textHome":"What went wrong?@Was it because I was too weak?"}]},{"autoTurnFirst":2.5,"chara":[{"id":250300,"motion":300}]},{"autoTurnFirst":5.5,"chara":[{"eyeClose":0,"id":250300,"textHome":"There are times...I find myself@thinking things like that."}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":250300,"motion":100,"textHome":"That’s why I want to stay strong.@I never want to lose a friend again."}]},{"autoTurnFirst":5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":250300,"motion":1}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_16":[{"autoTurnFirst":6,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp3.json","id":250300,"motion":200,"pos":1,"voice":"vo_char_2503_00_23"}]},{"autoTurnFirst":7.8,"chara":[{"eyeClose":0,"id":250300}]},{"autoTurnFirst":3.3,"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":250300,"motion":300}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":250300}]},{"autoTurnFirst":1.2,"chara":[{"eyeClose":1,"id":250300}]}],"group_17":[{"autoTurnFirst":4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp3.json","id":250300,"motion":100,"pos":1,"voice":"vo_char_2503_00_24","textHome":"I'll make some tea. *Giggle*"}]},{"autoTurnFirst":5.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":0,"textHome":"I've always wanted to be friends@with a Magical Girl, so I'm happy."}]},{"autoTurnFirst":4,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":250300,"motion":200,"textHome":"It's not like there hasn't been@anyone like that before, though."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_18":[{"autoTurnFirst":4.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":250300,"motion":400,"pos":1,"voice":"vo_char_2503_00_25","textHome":"Oh, wait a moment.@I'm going to do my hair now."}]},{"autoTurnFirst":4.6,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":300,"textHome":"It's tough when I'm in a hurry in@the morning, but it feels so good@when it is all set up nicely."}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":250300,"motion":1}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_19":[{"autoTurnFirst":4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":200,"pos":1,"voice":"vo_char_2503_00_26","textHome":"Would you like to eat lunch together?"}]},{"autoTurnFirst":4.7,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":250300,"motion":100,"textHome":"I woke up early this morning@and tried baking bread myself."}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":400,"textHome":"It's not as good as a store-bought@loaf, but it's still soft and delicious."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_2":[{"autoTurnFirst":3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":200,"pos":1,"voice":"vo_char_2503_00_02","textHome":"I'm Mami Tomoe.@Nice to meet you."}]},{"autoTurnFirst":3,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":250300,"motion":300,"textHome":"Oh...? Have we…crossed@paths somewhere before?"}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":250300}]},{"autoTurnFirst":3.5,"chara":[{"id":250300,"motion":100,"textHome":"I'm sorry.@It must be my imagination."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_20":[{"autoTurnFirst":5.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_040.exp3.json","id":250300,"motion":100,"pos":1,"voice":"vo_char_2503_00_27","textHome":"Sometimes I’m a bit envious of the@students who stay late at school and@work hard in their club activities."}]},{"autoTurnFirst":3.7,"chara":[{"id":250300,"motion":0}]},{"autoTurnFirst":4,"chara":[{"eyeClose":1,"id":250300,"motion":300,"textHome":"It’s hard to balance being both@a student and a Magical Girl."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_21":[{"autoTurnFirst":2.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":250300,"motion":400,"pos":1,"voice":"vo_char_2503_00_28","textHome":"It's already this late?!"}]},{"autoTurnFirst":5.1,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":250300,"motion":1,"textHome":"I got too absorbed in watching a@movie that Miss Aki recommended."}]},{"autoTurnFirst":2.5,"chara":[{"id":250300,"motion":300,"textHome":"But I already have the@sequel rented, so..."}]},{"autoTurnFirst":4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp3.json","id":250300,"motion":200,"textHome":"Oh, oh no, let's stop!@Staying up late is no good!"}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_22":[{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp3.json","id":250300,"motion":0,"pos":1,"voice":"vo_char_2503_00_29","textHome":"The other day, Kyubey told me@there are currently two irregular@Magical Girls in this town."}]},{"autoTurnFirst":7.1,"chara":[{"id":250300,"motion":200}]},{"autoTurnFirst":3,"chara":[{"id":250300,"motion":100,"textHome":"I should ask for more@details next time."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_23":[{"autoTurnFirst":1.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":250300,"motion":300,"pos":1,"voice":"vo_char_2503_00_30","textHome":"Oh? Look. There's a Witch's Kiss@on that person's neck."}]},{"autoTurnFirst":5.5,"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":250300}]},{"autoTurnFirst":2.3,"chara":[{"id":250300,"motion":0,"textHome":"There must be a Witch nearby."}]},{"autoTurnFirst":4,"chara":[{"id":250300,"motion":400,"textHome":"First, let's save that person,@and then go defeat the Witch."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_24":[{"autoTurnFirst":4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":250300,"motion":1,"pos":1,"voice":"vo_char_2503_00_31","textHome":"If I could go to a parallel world,@I wonder if I could meet that@world's version of me."}]},{"autoTurnFirst":3.2,"chara":[{"id":250300,"motion":300}]},{"autoTurnFirst":5.5,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":250300,"motion":100,"textHome":"Or perhaps, we shouldn't meet@our otherworldly selves."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_25":[{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":400,"pos":1,"voice":"vo_char_2503_00_32"}]},{"autoTurnFirst":5.3,"chara":[{"id":250300,"motion":0}]},{"autoTurnFirst":6.7,"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":250300,"motion":200}]}],"group_26":[{"autoTurnFirst":1.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":100,"pos":1,"voice":"vo_char_2503_00_33","textHome":"Oh, look. It's that black cat@I've been seeing around lately."}]},{"autoTurnFirst":3.6,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":250300}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":250300,"motion":1,"textHome":"Some people are trying to take@it in, but it’s such a carefree cat,@so it’s not going very well."}]},{"autoTurnFirst":3,"chara":[{"id":250300,"motion":300}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_27":[{"autoTurnFirst":3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp3.json","id":250300,"motion":200,"pos":1,"voice":"vo_char_2503_00_34","textHome":"How about a piece of chiffon cake?"}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":400,"textHome":"People are surprised when I say@I made it, but if one has the right@tools, it's not that difficult."}]},{"autoTurnFirst":5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":250300,"motion":100}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_28":[{"autoTurnFirst":7.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":300,"pos":1,"voice":"vo_char_2503_00_35","textHome":"Lately, Miss Aki seems interested in@movies where the same day repeats."}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":250300,"motion":0,"textHome":"She said it's for research, but@I wonder what kind of research it is."}]},{"autoTurnFirst":2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_040.exp3.json","id":250300,"motion":200}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_29":[{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":250300,"motion":100,"pos":1,"voice":"vo_char_2503_00_36","textHome":"Récompense's tea blend@has a very wonderful aroma."}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":250300}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":250300,"motion":1,"textHome":"I asked Ms. Sakie about the blend,@but she evaded my question…"}]},{"autoTurnFirst":4.2,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":250300}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_3":[{"autoTurnFirst":1.5,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_001.exp3.json","id":250300,"motion":300,"pos":1,"voice":"vo_char_2503_00_03"}]},{"autoTurnFirst":2,"chara":[{"eyeClose":0,"id":250300}]}],"group_30":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":0,"pos":1,"voice":"vo_char_2503_00_37","textHome":"When I first met Miss Kaname,@Kyubey said she would become@an amazing Magical Girl."}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":250300,"motion":200}]},{"autoTurnFirst":2.9,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":250300}]},{"autoTurnFirst":2.8,"chara":[{"id":250300,"motion":100,"textHome":"I'm sure she'll become a@Magical Girl who will use her@power to help everyone."}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":250300}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_31":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":300,"pos":1,"voice":"vo_char_2503_00_38","textHome":"Watching Miss Miki reminds me@of when I was new to being a@Magical Girl, and doing my best."}]},{"autoTurnFirst":5.7,"chara":[{"eyeClose":1,"id":250300}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":250300}]},{"autoTurnFirst":4,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":250300,"motion":1,"textHome":"Although sometimes I worry@that she tries too hard."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_32":[{"autoTurnFirst":5.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":250300,"motion":400,"pos":1,"voice":"vo_char_2503_00_39","textHome":"Miss Akemi seems to be keeping@something secret from us, and it@makes me a bit suspicious."}]},{"autoTurnFirst":3.8,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":250300}]},{"autoTurnFirst":4.4,"chara":[{"id":250300,"motion":200,"textHome":"Miss Kaname believes she's not@a bad person, but not knowing@her goals makes me uneasy."}]},{"autoTurnFirst":4,"chara":[{"eyeClose":1,"id":250300,"motion":300}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_33":[{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp3.json","id":250300,"motion":1,"pos":1,"voice":"vo_char_2503_00_40","textHome":"Miss Sakura and I used to fight@Witches together in the past."}]},{"autoTurnFirst":5.7,"chara":[{"id":250300,"motion":200,"textHome":"It seems she mostly acts alone now.@But, she's still my precious comrade."}]},{"autoTurnFirst":5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":250300,"motion":0}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_34":[{"autoTurnFirst":5.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":250300,"motion":300,"pos":1,"voice":"vo_char_2503_00_41","textHome":"I heard about a girl who became a@Magical Girl by wishing for cheesecake."}]},{"autoTurnFirst":4,"chara":[{"id":250300,"motion":0,"textHome":"It sounds rather cutesy, but I'm@sure she had her own resolve@and personal reasons for it."}]},{"autoTurnFirst":4.7,"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":250300,"motion":200}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_35":[{"autoTurnFirst":1.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp3.json","id":250300,"motion":400,"pos":1,"voice":"vo_char_2503_00_42","textHome":"Allow me to take care of a@little something first, would you?"}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":250300}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_36":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":300,"pos":1,"voice":"vo_char_2503_00_43","textHome":"…That was pretty close,@but everything’s okay now."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_37":[{"autoTurnFirst":3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":100,"pos":1,"voice":"vo_char_2503_00_44","textHome":"Was I a good example@for my juniors?"}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_38":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":200,"pos":1,"voice":"vo_char_2503_00_45","textHome":"That was a close one."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_39":[{"autoTurnFirst":3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp3.json","id":250300,"motion":400,"pos":1,"voice":"vo_char_2503_00_46","textHome":"This is what a Magical Girl fights for."}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_4":[{"autoTurnFirst":4,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":250300,"motion":200,"pos":1,"voice":"vo_char_2503_00_04"}]}],"group_6":[{"autoTurnFirst":1.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":200,"pos":1,"voice":"vo_char_2503_00_13","textHome":"I feel like I've gotten better@at using my magic than before."}]},{"autoTurnFirst":4,"chara":[{"id":250300}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_7":[{"autoTurnFirst":1.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp3.json","id":250300,"motion":400,"pos":1,"voice":"vo_char_2503_00_14","textHome":"I'm in top form. At this rate,@I won't lose to anyone."}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":100}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_8":[{"autoTurnFirst":2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":300,"pos":1,"voice":"vo_char_2503_00_15","textHome":"I feel light… I’ve never fought@with such a happy feeling before."}]},{"autoTurnFirst":4.8,"chara":[{"eyeClose":1,"id":250300}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}],"group_9":[{"autoTurnFirst":4.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":250300,"motion":200,"pos":1,"voice":"vo_char_2503_00_16","textHome":"Kyubey is a dear friend of mine."}]},{"autoTurnFirst":2.2,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":250300,"textHome":"But sometimes when we talk, I feel@like we don’t truly understand@each other, and that frightens me."}]},{"autoTurnFirst":4.5,"chara":[{"id":250300,"motion":1}]},{"autoTurnFirst":2.5,"chara":[{"eyeClose":1,"id":250300}]},{"chara":[{"id":250300,"textHomeStatus":"Clear"}]}]},"version":3}